---
import '../styles/global.css';
import { CATEGORIES, CALCULATORS } from '../data/calculators';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  showQuickTools?: boolean;
  jsonLd?: object | object[];
}

const DEFAULT_KEYWORDS = "Converter, Calculator, all in one calculator, online converter tools, unit converter online, currency converter, live currency converter, real time forex rates, money converter, loan calculator, loan emi calculator, mortgage calculator, mortgage interest calculator, amortization schedule calculator, sip return calculator, investment calculator, compound interest calculator, gst tax calculator, tip splitter online, discount calculator, bmi calculator online, bmr calculator, tdee calculator, calorie calculator, daily water intake calculator, exact age calculator, length converter, weight converter, temperature converter, volume converter, area converter, speed converter, data storage converter, pressure converter, energy converter, percentage calculator, binary converter, hex converter, number base converter, fraction to decimal converter, prime number checker, date difference calculator, unix timestamp converter, recipe scaler, cooking measurement converter, fuel trip cost calculator, electricity bill estimator, word counter online, color code converter, text case converter";

const {
  title = "All Calc Kit — All in One Calculator & Online Converter Tools",
  description = "Free all in one calculator & online converter tools suite. Real time forex currency converter, loan emi calculator, unit converter online, BMI tracker, & 45+ free utilities.",
  keywords = DEFAULT_KEYWORDS,
  canonicalUrl = "https://allcalckit.com/",
  ogImage = "https://allcalckit.com/AllCalcKit_Favicon.png",
  ogType = "website",
  showQuickTools = false,
  isErrorPage = false,
  jsonLd
} = Astro.props;

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "All Calc Kit",
  "alternateName": ["CalcKit", "AllCalcKit", "All Calc Kit Converter", "All Calc Kit Calculator"],
  "url": "https://allcalckit.com/",
  "description": description,
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://allcalckit.com/?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": title,
  "url": canonicalUrl,
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": description
};

const RELATED_TOOLS = [
  { name: 'Length Converter', url: '/units/length' },
  { name: 'Percentage Calculator', url: '/math/percentage' },
  { name: 'Age Calculator', url: '/health/age-calc' },
  { name: 'Loan / EMI Calculator', url: '/finance/loan-emi' },
  { name: 'BMI Calculator', url: '/health/bmi' },
  { name: 'Currency Converter', url: '/finance/currency' },
  { name: 'Compound Interest Calculator', url: '/finance/compound-interest' },
  { name: 'Word & Character Counter', url: '/text/word-counter' },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7C5VRS3F68"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-7C5VRS3F68');
    </script>

    <!-- Google AdSense -->
    <meta name="google-adsense-account" content="ca-pub-3223615901840567" />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3223615901840567" crossorigin="anonymous"></script>

    <meta name="theme-color" content="#09090b" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png?v=20260819" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260819" />
    <link rel="shortcut icon" href="/favicon.ico?v=20260819" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20260819" />
    <meta name="apple-mobile-web-app-title" content="All Calc Kit" />
    <link rel="manifest" href="/site.webmanifest?v=20260819" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="All Calc Kit" />

    <!-- Open Graph / Facebook Meta Tags -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="All Calc Kit - All in One Calculator and Online Converter Tools" />
    <meta property="og:site_name" content="All Calc Kit" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card Meta Tags -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data for Search Engine Crawlers -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Zero-FOUC Theme Script -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('ack_theme');
        if (storedTheme === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[var(--canvas)] text-[var(--ink)] flex flex-col antialiased selection:bg-neutral-800 selection:text-white dark:selection:bg-white dark:selection:text-black">
    <!-- Header Nav -->
    <header class="sticky top-0 z-40 w-full border-b border-neutral-200 dark:border-neutral-800/80 bg-white/80 dark:bg-black/80 backdrop-blur-md transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-xl overflow-hidden shadow-sm group-hover:scale-105 transition-transform flex items-center justify-center bg-white border border-neutral-200 dark:border-neutral-800">
            <img src="/AllCalcKit_Favicon.png" alt="All Calc Kit Logo" class="w-full h-full object-cover" />
          </div>
          <div class="flex items-center gap-2">
            <span class="font-bold tracking-tight text-base sm:text-lg group-hover:opacity-80 transition-opacity">All Calc Kit</span>
          </div>
        </a>

        {!isErrorPage && (
          <div aria-label="Main Navigation" class="hidden lg:flex items-center gap-6 text-xs font-semibold text-neutral-600 dark:text-neutral-300">
            <a href="/about" class="hover:text-black dark:hover:text-white transition-colors">About</a>
            <a href="/contact" class="hover:text-black dark:hover:text-white transition-colors">Contact</a>
            <a href="/privacy" class="hover:text-black dark:hover:text-white transition-colors">Privacy</a>
            <a href="/terms" class="hover:text-black dark:hover:text-white transition-colors">Terms</a>
          </div>
        )}

        {!isErrorPage && (
          <button id="open-search-btn" type="button" aria-label="Search all calculators (Ctrl+K)" class="flex items-center gap-2 sm:gap-3 px-2.5 sm:px-3 py-1.5 rounded-full bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 hover:border-neutral-300 dark:hover:border-neutral-700 hover:text-neutral-900 dark:hover:text-white transition-all w-auto md:w-64 justify-between">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              <span class="hidden sm:inline">Search 45+ tools…</span>
              <span class="sm:hidden">Search</span>
            </div>
            <kbd class="hidden md:inline font-mono text-[11px] px-1.5 py-0.5 rounded bg-neutral-200 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 border border-neutral-300 dark:border-neutral-700">⌘K</kbd>
          </button>
        )}

        <!-- Right Action Cluster -->
        <div class="flex items-center gap-2 sm:gap-3">

          <!-- Quick Tools CTA button (Only visible on Homepage) -->
          {showQuickTools && (
            <a href="#quick-converters" class="hidden sm:inline-flex items-center justify-center px-4 py-1.5 rounded-full text-xs font-semibold bg-black dark:bg-white text-white dark:text-black hover:opacity-90 transition-opacity shadow-sm">
              Quick Tools
            </a>
          )}

          <!-- Desktop Theme Toggle -->
          <button id="theme-toggle" type="button" aria-label="Toggle light or dark theme" class="hidden lg:flex items-center justify-center p-2 rounded-full border border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors">
            <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
          </button>

          <!-- Mobile/Tablet Hamburger Menu Button with Animated Cross (X) Transition -->
          <button id="mobile-menu-btn" type="button" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-sidebar" class="flex lg:hidden flex-col items-center justify-center w-9 h-9 rounded-full border border-neutral-200 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors focus:outline-none relative z-50">
            <span class="sr-only">Toggle Menu</span>
            <div class="w-4.5 h-3.5 flex flex-col justify-between items-center relative">
              <span id="hamburger-line-1" class="w-4.5 h-0.5 bg-current rounded-full transition-all duration-300 transform origin-center"></span>
              <span id="hamburger-line-2" class="w-4.5 h-0.5 bg-current rounded-full transition-all duration-300"></span>
              <span id="hamburger-line-3" class="w-4.5 h-0.5 bg-current rounded-full transition-all duration-300 transform origin-center"></span>
            </div>
          </button>

        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer with Working Links -->
    <footer class="border-t border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-950 py-12 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8 mb-12">
          <div class="col-span-2">
            <div class="flex items-center gap-2 mb-3">
              <div class="w-6 h-6 rounded-lg overflow-hidden border border-neutral-200 dark:border-neutral-800">
                <img src="/AllCalcKit_Favicon.png" alt="All Calc Kit Logo" class="w-full h-full object-cover" />
              </div>
              <span class="font-bold text-base tracking-tight">All Calc Kit</span>
              <span class="px-1.5 py-0.5 text-[10px] font-mono font-medium rounded-full bg-neutral-200 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 border border-neutral-300 dark:border-neutral-700">v1.0</span>
            </div>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed max-w-sm">
              The high-performance suite for everyday calculations and conversions. Instant real-time calculation, mobile responsiveness, live currency rates, and minimalist UI.
            </p>
            <div class="mt-4 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400">Status: All Systems Operational</span>
            </div>
          </div>

          <div>
            <h3 class="font-mono text-xs text-neutral-900 dark:text-neutral-100 uppercase tracking-wider mb-3">Categories</h3>
            <ul class="space-y-2 text-xs text-neutral-500 dark:text-neutral-400">
              {CATEGORIES.map(cat => (
                <li><a href={cat.url} class="hover:text-black dark:hover:text-white transition-colors">{cat.name}</a></li>
              ))}
            </ul>
          </div>

          <div>
            <h3 class="font-mono text-xs text-neutral-900 dark:text-neutral-100 uppercase tracking-wider mb-3">Quick Tools</h3>
            <ul class="space-y-2 text-xs text-neutral-500 dark:text-neutral-400">
              {RELATED_TOOLS.map(tool => (
                <li><a href={tool.url} class="hover:text-black dark:hover:text-white transition-colors">{tool.name}</a></li>
              ))}
            </ul>
          </div>

          <div class="col-span-2 md:col-span-1">
            <h3 class="font-mono text-xs text-neutral-900 dark:text-neutral-100 uppercase tracking-wider mb-3">Company & Legal</h3>
            <ul class="space-y-2 text-xs text-neutral-500 dark:text-neutral-400 font-medium">
              <li><a href="/about" class="hover:text-black dark:hover:text-white transition-colors">About Us</a></li>
              <li><a href="/privacy" class="hover:text-black dark:hover:text-white transition-colors">Privacy Policy</a></li>
              <li><a href="/terms" class="hover:text-black dark:hover:text-white transition-colors">Terms & Conditions</a></li>
              <li><a href="/contact" class="hover:text-black dark:hover:text-white transition-colors">Contact Us</a></li>
            </ul>
          </div>
        </div>

        <div class="pt-8 border-t border-neutral-200 dark:border-neutral-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500 dark:text-neutral-500">
          <p>© {new Date().getFullYear()} All Calc Kit. All rights reserved.</p>
          <div class="flex items-center gap-4 sm:gap-6 flex-wrap justify-center font-medium">
            <a href="/about" class="hover:text-black dark:hover:text-white transition-colors">About</a>
            <span>•</span>
            <a href="/privacy" class="hover:text-black dark:hover:text-white transition-colors">Privacy</a>
            <span>•</span>
            <a href="/terms" class="hover:text-black dark:hover:text-white transition-colors">Terms</a>
            <span>•</span>
            <a href="/contact" class="hover:text-black dark:hover:text-white transition-colors">Contact</a>
            <span>•</span>
            <button id="footer-pwa-install-btn" type="button" class="hover:text-black dark:hover:text-white transition-colors cursor-pointer">Install App</button>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile Sidebar Drawer & Backdrop -->
    <div id="mobile-sidebar-backdrop" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs transition-opacity duration-300 opacity-0 pointer-events-none" aria-hidden="true"></div>

    <aside id="mobile-sidebar" class="fixed top-0 right-0 bottom-0 z-50 w-[78vw] sm:w-80 max-w-xs bg-white dark:bg-neutral-950 border-l border-neutral-200 dark:border-neutral-800 shadow-2xl flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-out" role="dialog" aria-modal="true" aria-label="Mobile Navigation Menu">
      <!-- Top Drawer Section -->
      <div class="p-5 flex flex-col flex-1 overflow-y-auto">
        <!-- Drawer Header -->
        <div class="flex items-center justify-between pb-4 mb-4 border-b border-neutral-200 dark:border-neutral-800">
          <a href="/" class="flex items-center gap-2.5 group mobile-nav-link">
            <div class="w-7 h-7 rounded-lg overflow-hidden shadow-xs border border-neutral-200 dark:border-neutral-800 flex items-center justify-center bg-white">
              <img src="/AllCalcKit_Favicon.png" alt="All Calc Kit Logo" class="w-full h-full object-cover" />
            </div>
            <span class="font-bold tracking-tight text-base text-black dark:text-white">All Calc Kit</span>
            <span class="px-1.5 py-0.5 text-[10px] font-mono font-medium rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 border border-neutral-300 dark:border-neutral-700">v1.0</span>
          </a>
          <button id="mobile-sidebar-close-btn" type="button" aria-label="Close navigation menu" class="p-1.5 rounded-full text-neutral-500 hover:text-black dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <!-- Main Navigation Links -->
        <div class="space-y-1 mb-6">
          <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400 px-3.5 py-1 block">Navigation</span>
          <a href="/about" class="mobile-nav-link flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-900 hover:text-black dark:hover:text-white transition-colors">
            <svg class="w-4 h-4 text-neutral-500 dark:text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>About</span>
          </a>
          <a href="/contact" class="mobile-nav-link flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-900 hover:text-black dark:hover:text-white transition-colors">
            <svg class="w-4 h-4 text-neutral-500 dark:text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span>Contact</span>
          </a>
          <a href="/privacy" class="mobile-nav-link flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-900 hover:text-black dark:hover:text-white transition-colors">
            <svg class="w-4 h-4 text-neutral-500 dark:text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <span>Privacy</span>
          </a>
          <a href="/terms" class="mobile-nav-link flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-900 hover:text-black dark:hover:text-white transition-colors">
            <svg class="w-4 h-4 text-neutral-500 dark:text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>Terms</span>
          </a>
        </div>

        <!-- Quick Tools Section with generous spacing -->
        <div class="pt-5 border-t border-neutral-200 dark:border-neutral-800 space-y-2">
          <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400 px-3.5 py-1 block">Quick Tools</span>
          <a href="/#complete-directory" class="mobile-nav-link flex items-center justify-between px-3.5 py-3 rounded-xl text-xs font-semibold text-neutral-800 dark:text-neutral-200 bg-neutral-50 dark:bg-neutral-900/60 border border-neutral-200 dark:border-neutral-800 hover:border-neutral-300 dark:hover:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800/80 transition-all shadow-xs group">
            <div class="flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-blue-500"></span>
              <span>All 45+ Tools Directory</span>
            </div>
            <span class="text-neutral-400 group-hover:text-black dark:group-hover:text-white group-hover:translate-x-0.5 transition-transform">→</span>
          </a>

          <!-- PWA Install Action -->
          <div class="pt-1 space-y-1">
            <button id="pwa-install-btn" type="button" class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold text-emerald-700 dark:text-emerald-300 bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/20 transition-all shadow-2xs text-left cursor-pointer">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                <span id="pwa-install-label">Install App</span>
              </div>
              <span class="text-[10px] font-mono font-bold bg-emerald-600 text-white px-1.5 py-0.5 rounded-full">Offline</span>
            </button>
            <p class="text-[10px] text-neutral-500 dark:text-neutral-400 font-mono px-1">Instant launch & works 100% offline.</p>
          </div>
        </div>
      </div>

      <!-- Bottom Drawer Section: Search, Theme Toggle & Status -->
      <div class="p-5 border-t border-neutral-200 dark:border-neutral-800 bg-neutral-50/80 dark:bg-neutral-900/50 space-y-4">
        <!-- Search Trigger Button (No desktop shortcut badges) -->
        <div>
          <button id="mobile-sidebar-search-btn" type="button" class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-medium text-neutral-600 dark:text-neutral-400 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 hover:border-neutral-300 dark:hover:border-neutral-700 hover:text-neutral-900 dark:hover:text-white transition-all shadow-xs text-left">
            <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              <span class="font-normal text-neutral-500 dark:text-neutral-400">Search 45+ calculators…</span>
            </div>
            <svg class="w-3.5 h-3.5 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>

        <!-- Theme Switcher Row -->
        <div class="flex items-center justify-between pt-1">
          <span class="text-xs font-semibold text-neutral-700 dark:text-neutral-300">Theme</span>
          <button id="mobile-theme-toggle" type="button" aria-label="Toggle light or dark theme" class="flex items-center gap-2.5 px-3 py-1.5 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950 text-xs font-semibold text-neutral-800 dark:text-neutral-200 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors shadow-xs">
            <svg class="w-3.5 h-3.5 hidden dark:block text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <svg class="w-3.5 h-3.5 block dark:hidden text-neutral-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
            <span class="dark:hidden font-mono text-[11px]">Dark Mode</span>
            <span class="hidden dark:inline font-mono text-[11px]">Light Mode</span>
          </button>
        </div>

        <!-- Operational Status Indicator -->
        <div class="flex items-center gap-2 pt-1 border-t border-neutral-200/60 dark:border-neutral-800/60">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400">All Systems Operational</span>
        </div>
      </div>
    </aside>

    <!-- iOS Safari PWA Install Modal -->
    <div id="ios-install-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden items-center justify-center p-4">
      <div class="w-full max-w-sm bg-white dark:bg-neutral-900 rounded-2xl border border-neutral-200 dark:border-neutral-800 p-6 shadow-2xl space-y-4 text-center">
        <div class="w-12 h-12 rounded-2xl mx-auto overflow-hidden shadow-xs border border-neutral-200 dark:border-neutral-800">
          <img src="/AllCalcKit_Favicon.png" alt="All Calc Kit" class="w-full h-full object-cover" />
        </div>
        <div>
          <h3 class="font-bold text-base text-neutral-900 dark:text-white">Install All Calc Kit</h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-1">Get 1-tap instant offline access from your home screen.</p>
        </div>
        <div class="p-3.5 rounded-xl bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 text-left space-y-2 text-xs font-mono">
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-[11px] font-bold shrink-0">1</span>
            <span>Tap the <strong>Share</strong> icon at bottom of Safari.</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-[11px] font-bold shrink-0">2</span>
            <span>Scroll & choose <strong>Add to Home Screen</strong>.</span>
          </div>
        </div>
        <button id="close-ios-install-btn" type="button" class="w-full py-2.5 rounded-xl bg-black dark:bg-white text-white dark:text-black font-semibold text-xs transition-opacity hover:opacity-90 cursor-pointer">
          Got it
        </button>
      </div>
    </div>

    <!-- Command Palette Modal -->
    <div id="search-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden items-start justify-center pt-16 sm:pt-24 px-4 transition-opacity">
      <div class="w-full max-w-xl bg-white dark:bg-neutral-900 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-2xl overflow-hidden flex flex-col transform transition-all scale-98">
        <div class="p-3 border-b border-neutral-200 dark:border-neutral-800 flex items-center gap-3">
          <svg class="w-5 h-5 text-neutral-400 ml-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input id="search-input" type="text" placeholder="Type a calculator name or unit (e.g. BMI, Currency, Length, EMI)..." class="w-full bg-transparent border-none outline-none text-sm text-neutral-900 dark:text-white placeholder-neutral-400 dark:placeholder-neutral-500 font-medium py-1" autocomplete="off" />
          <kbd class="font-mono text-xs px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-500 border border-neutral-200 dark:border-neutral-700 shrink-0">ESC</kbd>
        </div>
        <div id="search-results" class="max-h-96 overflow-y-auto p-2 space-y-1">
        </div>
        <div class="p-3 border-t border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-950 flex items-center justify-between text-[11px] text-neutral-500">
          <div class="flex items-center gap-3">
            <span><kbd class="font-mono px-1 py-0.5 bg-neutral-200 dark:bg-neutral-800 rounded">↑↓</kbd> Navigate</span>
            <span><kbd class="font-mono px-1 py-0.5 bg-neutral-200 dark:bg-neutral-800 rounded">↵</kbd> Select</span>
          </div>
          <span class="font-mono">All Calc Kit Search</span>
        </div>
      </div>
    </div>

    <style is:global>
      #mobile-menu-btn.is-open #hamburger-line-1 {
        transform: translateY(6px) rotate(45deg);
      }
      #mobile-menu-btn.is-open #hamburger-line-2 {
        opacity: 0;
        transform: scaleX(0);
      }
      #mobile-menu-btn.is-open #hamburger-line-3 {
        transform: translateY(-6px) rotate(-45deg);
      }

      /* Clean Single-Page Print-to-PDF Formatting */
      @media print {
        header, footer, nav, #search-modal, #ios-install-modal, #mobile-sidebar, #mobile-sidebar-backdrop, button:not([data-printable]), .no-print {
          display: none !important;
        }
        body {
          background: #ffffff !important;
          color: #000000 !important;
          font-size: 11pt !important;
        }
        .max-w-7xl, .max-w-4xl, .max-w-3xl {
          max-width: 100% !important;
          padding: 0 !important;
          margin: 0 !important;
        }
      }
    </style>

    <!-- Scripts -->
    <script is:inline define:vars={{ CALCULATORS }}>
      const themeToggleBtn = document.getElementById('theme-toggle');
      const mobileThemeToggleBtn = document.getElementById('mobile-theme-toggle');

      function handleThemeToggle() {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('ack_theme', isDark ? 'dark' : 'light');
      }

      if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', handleThemeToggle);
      }
      if (mobileThemeToggleBtn) {
        mobileThemeToggleBtn.addEventListener('click', handleThemeToggle);
      }

      // Mobile Sidebar Controller
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileSidebarCloseBtn = document.getElementById('mobile-sidebar-close-btn');
      const mobileSidebar = document.getElementById('mobile-sidebar');
      const mobileSidebarBackdrop = document.getElementById('mobile-sidebar-backdrop');
      const mobileSidebarSearchBtn = document.getElementById('mobile-sidebar-search-btn');
      const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

      function openMobileSidebar() {
        if (!mobileSidebar || !mobileSidebarBackdrop) return;
        mobileSidebar.classList.remove('translate-x-full');
        mobileSidebar.classList.add('translate-x-0');
        mobileSidebarBackdrop.classList.remove('opacity-0', 'pointer-events-none');
        mobileSidebarBackdrop.classList.add('opacity-100', 'pointer-events-auto');
        if (mobileMenuBtn) {
          mobileMenuBtn.classList.add('is-open');
          mobileMenuBtn.setAttribute('aria-expanded', 'true');
        }
        document.body.classList.add('overflow-hidden');
      }

      function closeMobileSidebar() {
        if (!mobileSidebar || !mobileSidebarBackdrop) return;
        mobileSidebar.classList.remove('translate-x-0');
        mobileSidebar.classList.add('translate-x-full');
        mobileSidebarBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
        mobileSidebarBackdrop.classList.add('opacity-0', 'pointer-events-none');
        if (mobileMenuBtn) {
          mobileMenuBtn.classList.remove('is-open');
          mobileMenuBtn.setAttribute('aria-expanded', 'false');
        }
        document.body.classList.remove('overflow-hidden');
      }

      function toggleMobileSidebar() {
        const isOpen = mobileMenuBtn?.classList.contains('is-open');
        if (isOpen) {
          closeMobileSidebar();
        } else {
          openMobileSidebar();
        }
      }

      if (mobileMenuBtn) mobileMenuBtn.addEventListener('click', toggleMobileSidebar);
      if (mobileSidebarCloseBtn) mobileSidebarCloseBtn.addEventListener('click', closeMobileSidebar);
      if (mobileSidebarBackdrop) mobileSidebarBackdrop.addEventListener('click', closeMobileSidebar);

      mobileNavLinks.forEach((link) => {
        link.addEventListener('click', closeMobileSidebar);
      });

      const modal = document.getElementById('search-modal');
      const searchInput = document.getElementById('search-input');
      const searchResults = document.getElementById('search-results');
      const openBtnDesktop = document.getElementById('open-search-btn');
      const openBtnMobile = document.getElementById('open-search-mobile');

      function openModal() {
        if (!modal) return;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        if (searchInput) {
          searchInput.value = '';
          renderResults(CALCULATORS);
          setTimeout(() => searchInput.focus(), 50);
        }
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }

      if (openBtnDesktop) openBtnDesktop.addEventListener('click', openModal);
      if (openBtnMobile) openBtnMobile.addEventListener('click', openModal);
      if (mobileSidebarSearchBtn) {
        mobileSidebarSearchBtn.addEventListener('click', () => {
          closeMobileSidebar();
          setTimeout(openModal, 150);
        });
      }

      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });
      }

      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          if (modal?.classList.contains('hidden')) openModal();
          else closeModal();
        }
        if (e.key === 'Escape') {
          closeModal();
          closeMobileSidebar();
        }
      });

      function renderResults(list, query = '') {
        if (!searchResults) return;
        if (list.length === 0) {
          searchResults.innerHTML = `<div class="p-6 text-center text-xs text-neutral-500 font-mono">No calculators match your query.</div>`;
          return;
        }

        let pinnedIds = [];
        try {
          const raw = localStorage.getItem('ack_pinned_tools');
          pinnedIds = raw ? JSON.parse(raw) : [];
        } catch (_) {}

        let displayList = list;
        if (!query && Array.isArray(pinnedIds) && pinnedIds.length > 0) {
          const pinned = list.filter((c) => pinnedIds.includes(c.id));
          const others = list.filter((c) => !pinnedIds.includes(c.id));
          displayList = [...pinned, ...others];
        }

        searchResults.innerHTML = displayList.map(item => {
          const isPinned = Array.isArray(pinnedIds) && pinnedIds.includes(item.id);
          return `
          <a href="${item.url}" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors group">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-8 h-8 rounded-md bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 flex items-center justify-center font-mono text-xs font-bold border border-neutral-200 dark:border-neutral-700 group-hover:bg-black group-hover:text-white dark:group-hover:bg-white dark:group-hover:text-black transition-colors shrink-0">
                ${item.name[0]}
              </div>
              <div class="min-w-0">
                <div class="text-sm font-semibold text-neutral-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors truncate flex items-center gap-1.5">
                  <span>${item.name}</span>
                  ${isPinned ? '<span class="text-amber-400 text-xs">★</span>' : ''}
                </div>
                <div class="text-xs text-neutral-500 dark:text-neutral-400 truncate">${item.description}</div>
              </div>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-500 border border-neutral-200 dark:border-neutral-700 shrink-0 ml-2">${item.category}</span>
          </a>
        `;
        }).join('');
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          const query = e.target.value.toLowerCase().trim();
          if (!query) {
            renderResults(CALCULATORS, '');
            return;
          }
          const filtered = CALCULATORS.filter(c => 
            c.name.toLowerCase().includes(query) || 
            c.description.toLowerCase().includes(query) || 
            c.category.toLowerCase().includes(query) || 
            c.tags.some(t => t.toLowerCase().includes(query))
          );
          renderResults(filtered, query);
        });
      }

      // PWA Device-Adaptive Install Handler
      let deferredInstallPrompt = null;
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredInstallPrompt = e;
        updateInstallLabels();
      });

      function isIosDevice() {
        return /iphone|ipad|ipod/.test(window.navigator.userAgent.toLowerCase());
      }

      function updateInstallLabels() {
        const pwaLabel = document.getElementById('pwa-install-label');
        const homePwaLabel = document.getElementById('homepage-pwa-label');
        const isMobile = /android|iphone|ipad|ipod/.test(window.navigator.userAgent.toLowerCase());
        const labelText = isMobile ? 'Install App' : 'Install Desktop App';
        if (pwaLabel) pwaLabel.textContent = labelText;
        if (homePwaLabel) homePwaLabel.textContent = isMobile ? 'Install All Calc Kit App' : 'Install Desktop App';
      }

      function triggerPwaInstall() {
        if (deferredInstallPrompt) {
          deferredInstallPrompt.prompt();
          deferredInstallPrompt.userChoice.then(() => {
            deferredInstallPrompt = null;
          });
        } else if (isIosDevice()) {
          const iosModal = document.getElementById('ios-install-modal');
          if (iosModal) {
            iosModal.classList.remove('hidden');
            iosModal.classList.add('flex');
          }
        } else {
          alert('To install All Calc Kit, click the Install App button in your browser address bar or menu (Chrome / Edge / Safari).');
        }
      }

      const pwaInstallBtn = document.getElementById('pwa-install-btn');
      const footerPwaBtn = document.getElementById('footer-pwa-install-btn');
      const homePwaBtn = document.getElementById('homepage-pwa-install-btn');
      const closeIosBtn = document.getElementById('close-ios-install-btn');
      const iosModal = document.getElementById('ios-install-modal');

      if (pwaInstallBtn) pwaInstallBtn.addEventListener('click', triggerPwaInstall);
      if (footerPwaBtn) footerPwaBtn.addEventListener('click', triggerPwaInstall);
      if (homePwaBtn) homePwaBtn.addEventListener('click', triggerPwaInstall);
      if (closeIosBtn && iosModal) {
        closeIosBtn.addEventListener('click', () => {
          iosModal.classList.add('hidden');
          iosModal.classList.remove('flex');
        });
      }
      if (iosModal) {
        iosModal.addEventListener('click', (e) => {
          if (e.target === iosModal) {
            iosModal.classList.add('hidden');
            iosModal.classList.remove('flex');
          }
        });
      }
      updateInstallLabels();
    </script>

    <!-- PWA Service Worker Registration -->
    <script>
      import { registerSW } from 'virtual:pwa-register';

      registerSW({
        immediate: true,
        onRegisteredSW(_swScriptUrl, registration) {
          if (registration) {
            setInterval(() => {
              registration.update();
            }, 60 * 60 * 1000);
          }
        },
      });
    </script>
  </body>
</html>
