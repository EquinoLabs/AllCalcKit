---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">Tip & Bill Splitter</h3>
    </div>
    
    <!-- Currency Selector -->
    <div class="flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800 px-2 py-1 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs shrink-0">
      <select aria-label="Select currency unit" class="ack-currency-select bg-transparent text-black dark:text-white font-bold outline-none cursor-pointer text-xs">
        <option value="USD">USD ($)</option>
        <option value="INR">INR (₹)</option>
        <option value="EUR">EUR (€)</option>
        <option value="GBP">GBP (£)</option>
      </select>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="space-y-4">
      <div>
        <label for="tip-bill" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Total Bill Amount</label>
        <input id="tip-bill" type="number" value="120" min="0" step="any" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-emerald-500 tabular-nums" />
      </div>

      <div>
        <div class="flex justify-between items-center mb-1 text-xs font-semibold">
          <label for="tip-pct" class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Tip Percentage</label>
          <span id="tip-pct-val" class="font-mono font-bold text-black dark:text-white">15%</span>
        </div>
        <input id="tip-pct" type="range" min="0" max="40" step="1" value="15" class="w-full h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-emerald-600" />
      </div>

      <div>
        <div class="flex justify-between items-center mb-1 text-xs font-semibold">
          <label for="tip-people" class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Number of People</label>
          <span id="tip-people-val" class="font-mono font-bold text-black dark:text-white">3 People</span>
        </div>
        <input id="tip-people" type="range" min="1" max="20" step="1" value="3" class="w-full h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-emerald-600" />
      </div>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-5 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between">
      <div>
        <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold mb-1">Total Pay Per Person</div>
        <div id="tip-per-person" class="text-3xl sm:text-4xl font-black text-emerald-600 dark:text-emerald-400 tabular-nums">$0</div>
      </div>

      <div class="grid grid-cols-2 gap-4 py-4 border-y border-neutral-200 dark:border-neutral-800 my-4 text-xs font-mono">
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Total Tip Amount</span>
          <span id="tip-total-tip" class="font-bold text-black dark:text-white tabular-nums">$0</span>
        </div>
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Tip Per Person</span>
          <span id="tip-tip-person" class="font-bold text-emerald-600 dark:text-emerald-400 tabular-nums">$0</span>
        </div>
      </div>

      <div class="text-xs font-mono text-neutral-500 leading-relaxed">
        Effortless dining bill splitting & tip computation.
      </div>
    </div>
  </div>

  <!-- Live Explain Calculation Walkthrough -->
  <details id="tip-explain-details" class="group bg-neutral-50/70 dark:bg-neutral-950/60 border border-neutral-200 dark:border-neutral-800 rounded-2xl p-4 sm:p-5 transition-all [&_[data-icon]]:open:rotate-180 mt-6 shadow-xs">
    <summary class="flex items-center justify-between gap-4 font-bold text-xs sm:text-sm text-neutral-800 dark:text-neutral-200 cursor-pointer select-none">
      <div class="flex items-center gap-2.5">
        <span class="w-7 h-7 rounded-lg bg-emerald-500/10 dark:bg-emerald-400/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/20">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        </span>
        <div>
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 block sm:inline-block sm:mr-2">Explain Calculation</span>
          <span class="font-bold text-neutral-900 dark:text-neutral-100">Live Mathematical Working</span>
        </div>
      </div>
      <div class="flex items-center gap-1.5 shrink-0">
        <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 group-open:hidden">Show Steps</span>
        <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 hidden group-open:inline">Hide Steps</span>
        <svg data-icon class="w-4 h-4 text-neutral-400 shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </summary>

    <div class="mt-4 pt-4 border-t border-neutral-200/70 dark:border-neutral-800/80 space-y-4 text-xs font-mono">
      <!-- Formula -->
      <div class="space-y-1.5">
        <div class="text-[10px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-bold">Standard Gratuity & Split Formulas</div>
        <div class="p-2.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-neutral-900 dark:text-emerald-300 font-bold overflow-x-auto text-xs sm:text-sm">
          Tip = Bill × (Tip % ÷ 100) &nbsp;|&nbsp; Total = Bill + Tip &nbsp;|&nbsp; Per Person = Total ÷ Diners
        </div>
      </div>

      <!-- Live Calculation Working -->
      <div id="tip-explain-body" class="space-y-3">
        <!-- Step 1: Tip Calculation -->
        <div class="p-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 space-y-1">
          <div class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100">Step 1 — Total Tip Amount</div>
          <div class="text-neutral-600 dark:text-neutral-400 space-y-0.5 pt-0.5">
            <div>Formula: <span id="exp-tip-formula">$120.00 × (15 ÷ 100)</span></div>
            <div>= <span id="exp-tip-sub">$120.00 × 0.15</span></div>
            <div class="font-bold text-black dark:text-white">= <span id="exp-tip-val">$18.00</span></div>
          </div>
        </div>

        <!-- Step 2: Total Bill Amount -->
        <div class="p-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 space-y-1">
          <div class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100">Step 2 — Grand Total (Bill + Tip)</div>
          <div class="text-neutral-600 dark:text-neutral-400 space-y-0.5 pt-0.5">
            <div>Formula: <span id="exp-tip-tot-formula">$120.00 + $18.00</span></div>
            <div class="font-bold text-black dark:text-white">= <span id="exp-tip-tot-val">$138.00</span></div>
          </div>
        </div>

        <!-- Step 3: Split Per Person -->
        <div class="p-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 space-y-1">
          <div class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100">Step 3 — Individual Share (Divided by Diners)</div>
          <div class="text-neutral-600 dark:text-neutral-400 space-y-0.5 pt-0.5">
            <div>Formula: <span id="exp-tip-split-formula">$138.00 ÷ 3 people</span></div>
            <div class="font-bold text-emerald-600 dark:text-emerald-400 text-sm">
              = <span id="exp-tip-per-val">$46.00 / person</span>
            </div>
            <div class="text-[11px] text-neutral-500 pt-0.5">
              (Includes <span id="exp-tip-tip-person">$6.00</span> tip share per person)
            </div>
          </div>
        </div>
      </div>
    </div>
  </details>
</div>

<script is:inline>
  (function() {
    const billInp = document.getElementById('tip-bill');
    const pctInp = document.getElementById('tip-pct');
    const pplInp = document.getElementById('tip-people');

    const pctVal = document.getElementById('tip-pct-val');
    const pplVal = document.getElementById('tip-people-val');

    const perPersonEl = document.getElementById('tip-per-person');
    const totalTipEl = document.getElementById('tip-total-tip');
    const tipPersonEl = document.getElementById('tip-tip-person');

    // Explain elements
    const expTipFormula = document.getElementById('exp-tip-formula');
    const expTipSub = document.getElementById('exp-tip-sub');
    const expTipVal = document.getElementById('exp-tip-val');
    const expTotFormula = document.getElementById('exp-tip-tot-formula');
    const expTotVal = document.getElementById('exp-tip-tot-val');
    const expSplitFormula = document.getElementById('exp-tip-split-formula');
    const expPerVal = document.getElementById('exp-tip-per-val');
    const expTipPerson = document.getElementById('exp-tip-tip-person');

    const CURRENCY_CONFIGS = {
      USD: { symbol: '$', locale: 'en-US' },
      INR: { symbol: '₹', locale: 'en-IN' },
      EUR: { symbol: '€', locale: 'en-IE' },
      GBP: { symbol: '£', locale: 'en-GB' }
    };

    function getCurrency() {
      return localStorage.getItem('ack_currency') || 'USD';
    }

    function formatMoney(num) {
      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;
      const formatted = num.toLocaleString(cfg.locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      return `${cfg.symbol}${formatted}`;
    }

    function calcTip() {
      if (!billInp || !pctInp || !pplInp) return;
      const bill = parseFloat(billInp.value) || 0;
      const pct = parseFloat(pctInp.value) || 0;
      const ppl = parseInt(pplInp.value) || 1;

      if (pctVal) pctVal.textContent = pct + '%';
      if (pplVal) pplVal.textContent = ppl + (ppl === 1 ? ' Person' : ' People');

      const totalTip = bill * (pct / 100);
      const grandTotal = bill + totalTip;

      const totalPerPerson = ppl > 0 ? grandTotal / ppl : grandTotal;
      const tipPerPerson = ppl > 0 ? totalTip / ppl : totalTip;

      const formattedPerPerson = formatMoney(totalPerPerson);
      const formattedTotalTip = formatMoney(totalTip);
      const formattedGrandTotal = formatMoney(grandTotal);
      const formattedTipPerPerson = formatMoney(tipPerPerson);
      const formattedBill = formatMoney(bill);

      if (perPersonEl) perPersonEl.textContent = formattedPerPerson;
      if (totalTipEl) totalTipEl.textContent = formattedTotalTip;
      if (tipPersonEl) tipPersonEl.textContent = formattedTipPerPerson;

      // Update Live Explain Calculation
      if (expTipFormula) expTipFormula.textContent = `${formattedBill} × (${pct} ÷ 100)`;
      if (expTipSub) expTipSub.textContent = `${formattedBill} × ${(pct / 100).toFixed(2)}`;
      if (expTipVal) expTipVal.textContent = formattedTotalTip;
      if (expTotFormula) expTotFormula.textContent = `${formattedBill} + ${formattedTotalTip}`;
      if (expTotVal) expTotVal.textContent = formattedGrandTotal;
      if (expSplitFormula) expSplitFormula.textContent = `${formattedGrandTotal} ÷ ${ppl} ${ppl === 1 ? 'person' : 'people'}`;
      if (expPerVal) expPerVal.textContent = `${formattedPerPerson} / person`;
      if (expTipPerson) expTipPerson.textContent = formattedTipPerPerson;
    }

    const selects = document.querySelectorAll('.ack-currency-select');
    selects.forEach(sel => {
      sel.value = getCurrency();
      sel.addEventListener('change', (e) => {
        const val = e.target.value;
        localStorage.setItem('ack_currency', val);
        window.dispatchEvent(new CustomEvent('ack_currency_change', { detail: val }));
      });
    });

    window.addEventListener('ack_currency_change', (e) => {
      selects.forEach(sel => sel.value = e.detail);
      calcTip();
    });

    [billInp, pctInp, pplInp].forEach(el => el.addEventListener('input', calcTip));
    calcTip();
  })();
</script>
