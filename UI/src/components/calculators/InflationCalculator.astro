---
/**
 * Inflation & Purchasing Power Calculator Component
 * Calculates future equivalent cost and purchasing power erosion over time.
 */
---

<div class="space-y-6">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Input Form -->
    <div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-950/40 p-5 space-y-4 shadow-2xs">
      <div class="flex items-center justify-between border-b border-neutral-200 dark:border-neutral-800 pb-3">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-500">Inflation Parameters</span>
        <div class="flex items-center gap-1.5 text-xs font-mono">
          <span class="text-neutral-500">Currency:</span>
          <select class="ack-currency-select bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 rounded px-1.5 py-0.5 font-bold text-neutral-900 dark:text-white">
            <option value="USD">USD ($)</option>
            <option value="INR">INR (₹)</option>
            <option value="EUR">EUR (€)</option>
            <option value="GBP">GBP (£)</option>
          </select>
        </div>
      </div>

      <!-- Starting Amount -->
      <div>
        <div class="flex justify-between items-center mb-1 text-xs font-mono">
          <label for="inf-amount" class="font-bold text-neutral-700 dark:text-neutral-300">Initial Amount</label>
          <span id="inf-amount-display" class="font-bold text-neutral-900 dark:text-white tabular-nums">$1,000</span>
        </div>
        <input id="inf-amount" type="number" value="1000" min="1" step="50" class="w-full bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-xl px-3.5 py-2 text-sm font-mono font-semibold text-neutral-900 dark:text-white focus:outline-none focus:border-amber-500" />
      </div>

      <!-- Time Horizon (Years) -->
      <div>
        <div class="flex justify-between items-center mb-1 text-xs font-mono">
          <label for="inf-years" class="font-bold text-neutral-700 dark:text-neutral-300">Time Horizon</label>
          <span id="inf-years-display" class="font-bold text-neutral-900 dark:text-white tabular-nums">10 Years</span>
        </div>
        <input id="inf-years" type="range" min="1" max="40" step="1" value="10" class="w-full h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-amber-600" />
      </div>

      <!-- Annual Inflation Rate (%) -->
      <div>
        <div class="flex justify-between items-center mb-1 text-xs font-mono">
          <label for="inf-rate" class="font-bold text-neutral-700 dark:text-neutral-300">Average Annual Inflation Rate (%)</label>
          <span id="inf-rate-display" class="font-bold text-amber-600 dark:text-amber-400 tabular-nums">3.5%</span>
        </div>
        <input id="inf-rate" type="range" min="0.5" max="15" step="0.1" value="3.5" class="w-full h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-amber-600" />
        
        <!-- Preset Rate Buttons -->
        <div class="flex gap-2 mt-2">
          <button type="button" data-rate="2.0" class="inf-preset-btn px-2.5 py-1 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 text-[10px] font-mono font-semibold text-neutral-600 dark:text-neutral-400 hover:border-amber-500">2.0% (Fed Target)</button>
          <button type="button" data-rate="3.5" class="inf-preset-btn px-2.5 py-1 rounded-lg border border-amber-500 bg-amber-50 dark:bg-amber-950/40 text-[10px] font-mono font-semibold text-amber-600 dark:text-amber-400">3.5% (Historical Avg)</button>
          <button type="button" data-rate="6.0" class="inf-preset-btn px-2.5 py-1 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 text-[10px] font-mono font-semibold text-neutral-600 dark:text-neutral-400 hover:border-amber-500">6.0% (High Inflation)</button>
        </div>
      </div>
    </div>

    <!-- Output Card & Purchasing Power Gauge -->
    <div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-950 p-5 sm:p-6 flex flex-col justify-between space-y-4 shadow-2xs">
      <div>
        <div class="flex items-center justify-between gap-2 mb-1">
          <span class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold">Future Equivalent Cost</span>
          <span id="inf-cpi-badge" class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">+41.1% Total Inflation</span>
        </div>
        <div class="flex items-baseline gap-2">
          <span id="inf-future-cost" class="text-3xl sm:text-4xl font-black text-amber-600 dark:text-amber-400 tabular-nums">$1,410.60</span>
        </div>
        <div id="inf-subtitle" class="text-xs font-mono text-neutral-600 dark:text-neutral-400 mt-1">
          You will need $1,410.60 in 10 years to buy what $1,000 buys today.
        </div>
      </div>

      <!-- Purchasing Power Erosion Metrics -->
      <div class="grid grid-cols-2 gap-3 py-3 border-y border-neutral-200 dark:border-neutral-800 text-xs font-mono">
        <div>
          <span class="text-neutral-500 block font-semibold">Purchasing Power Loss</span>
          <span id="inf-power-loss" class="font-bold text-rose-600 dark:text-rose-400 tabular-nums text-sm sm:text-base">-29.1%</span>
        </div>
        <div>
          <span class="text-neutral-500 block font-semibold">Real Value of $1,000</span>
          <span id="inf-real-val" class="font-bold text-neutral-900 dark:text-white tabular-nums text-sm sm:text-base">$708.92</span>
        </div>
      </div>

      <!-- Visual Erosion Bar -->
      <div>
        <div class="flex justify-between text-[11px] font-mono text-neutral-700 dark:text-neutral-400 mb-1 font-bold">
          <span>Remaining Value (<span id="inf-remain-pct">70.9%</span>)</span>
          <span class="text-rose-600 dark:text-rose-400">Lost to Inflation (<span id="inf-lost-pct">29.1%</span>)</span>
        </div>
        <div class="w-full h-3.5 rounded-full bg-neutral-200 dark:bg-neutral-800 overflow-hidden flex">
          <div id="inf-val-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 70.9%"></div>
          <div id="inf-loss-bar" class="h-full bg-rose-500 transition-all duration-300" style="width: 29.1%"></div>
        </div>
      </div>

      <div class="text-[11px] font-mono text-neutral-500 leading-relaxed">
        Rule of 72: At 3.5% inflation, the cost of living doubles every <span id="inf-double-years" class="font-bold text-neutral-900 dark:text-neutral-100">20.6 years</span>.
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const amountInp = document.getElementById('inf-amount');
    const yearsInp = document.getElementById('inf-years');
    const rateInp = document.getElementById('inf-rate');

    const amountDisp = document.getElementById('inf-amount-display');
    const yearsDisp = document.getElementById('inf-years-display');
    const rateDisp = document.getElementById('inf-rate-display');

    const futureCostEl = document.getElementById('inf-future-cost');
    const cpiBadge = document.getElementById('inf-cpi-badge');
    const subtitleEl = document.getElementById('inf-subtitle');
    const powerLossEl = document.getElementById('inf-power-loss');
    const realValEl = document.getElementById('inf-real-val');

    const valBar = document.getElementById('inf-val-bar');
    const lossBar = document.getElementById('inf-loss-bar');
    const remainPctEl = document.getElementById('inf-remain-pct');
    const lostPctEl = document.getElementById('inf-lost-pct');
    const doubleYearsEl = document.getElementById('inf-double-years');

    const CURRENCY_CONFIGS = {
      USD: { symbol: '$', locale: 'en-US' },
      INR: { symbol: '₹', locale: 'en-IN' },
      EUR: { symbol: '€', locale: 'en-IE' },
      GBP: { symbol: '£', locale: 'en-GB' }
    };

    function getCurrency() {
      return localStorage.getItem('ack_currency') || 'USD';
    }

    function formatMoney(num) {
      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;
      return `${cfg.symbol}${num.toLocaleString(cfg.locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    function calcInflation() {
      const amount = parseFloat(amountInp?.value || '1000');
      const years = parseFloat(yearsInp?.value || '10');
      const rate = parseFloat(rateInp?.value || '3.5');

      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;

      if (amountDisp) amountDisp.textContent = `${cfg.symbol}${Math.round(amount).toLocaleString(cfg.locale)}`;
      if (yearsDisp) yearsDisp.textContent = `${years} ${years === 1 ? 'Year' : 'Years'}`;
      if (rateDisp) rateDisp.textContent = `${rate.toFixed(1)}%`;

      const r = rate / 100;
      const factor = Math.pow(1 + r, years);

      const futureCost = amount * factor;
      const realValue = amount / factor;
      const totalInflationPct = (factor - 1) * 100;
      const powerLossPct = (1 - (1 / factor)) * 100;
      const remainPct = (100 - powerLossPct).toFixed(1);

      if (futureCostEl) futureCostEl.textContent = formatMoney(futureCost);
      if (cpiBadge) cpiBadge.textContent = `+${totalInflationPct.toFixed(1)}% Total Inflation`;
      if (subtitleEl) subtitleEl.textContent = `You will need ${formatMoney(futureCost)} in ${years} years to buy what ${formatMoney(amount)} buys today.`;
      if (powerLossEl) powerLossEl.textContent = `-${powerLossPct.toFixed(1)}%`;
      if (realValEl) realValEl.textContent = formatMoney(realValue);

      if (remainPctEl) remainPctEl.textContent = `${remainPct}%`;
      if (lostPctEl) lostPctEl.textContent = `${powerLossPct.toFixed(1)}%`;
      if (valBar) valBar.style.width = `${remainPct}%`;
      if (lossBar) lossBar.style.width = `${powerLossPct.toFixed(1)}%`;

      if (doubleYearsEl) {
        const doubleYrs = rate > 0 ? (72 / rate).toFixed(1) : '∞';
        doubleYearsEl.textContent = `${doubleYrs} years`;
      }
    }

    const presetBtns = document.querySelectorAll('.inf-preset-btn');
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const r = parseFloat(btn.getAttribute('data-rate') || '3.5');
        if (rateInp) rateInp.value = r.toString();
        presetBtns.forEach(b => {
          b.classList.remove('border-amber-500', 'bg-amber-50', 'dark:bg-amber-950/40', 'text-amber-600', 'dark:text-amber-400');
          b.classList.add('border-neutral-200', 'dark:border-neutral-800', 'bg-white', 'dark:bg-neutral-900', 'text-neutral-600', 'dark:text-neutral-400');
        });
        btn.classList.remove('border-neutral-200', 'dark:border-neutral-800', 'bg-white', 'dark:bg-neutral-900', 'text-neutral-600', 'dark:text-neutral-400');
        btn.classList.add('border-amber-500', 'bg-amber-50', 'dark:bg-amber-950/40', 'text-amber-600', 'dark:text-amber-400');
        calcInflation();
      });
    });

    const selects = document.querySelectorAll('.ack-currency-select');
    selects.forEach(sel => {
      sel.value = getCurrency();
      sel.addEventListener('change', (e) => {
        const val = e.target.value;
        localStorage.setItem('ack_currency', val);
        window.dispatchEvent(new CustomEvent('ack_currency_change', { detail: val }));
      });
    });

    window.addEventListener('ack_currency_change', (e) => {
      selects.forEach(sel => sel.value = e.detail);
      calcInflation();
    });

    [amountInp, yearsInp, rateInp].forEach(el => el?.addEventListener('input', calcInflation));
    calcInflation();
  })();
</script>
