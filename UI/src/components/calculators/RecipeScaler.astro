---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-amber-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">Recipe Ingredient Scaler & Resizer</h3>
    </div>
    <span class="text-[10px] sm:text-[11px] font-mono px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 shrink-0 font-bold">
      Culinary & Kitchen
    </span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="space-y-4">
      <div class="grid grid-cols-2 gap-2">
        <div>
          <label class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Original Servings</label>
          <input id="recipe-orig-servings" type="number" value="4" min="1" max="100" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-amber-500 tabular-nums" />
        </div>
        <div>
          <label class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Desired Target Servings</label>
          <input id="recipe-target-servings" type="number" value="10" min="1" max="500" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-amber-500 tabular-nums" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Ingredient Quantity to Scale</label>
        <div class="flex items-center gap-2">
          <input id="recipe-qty" type="number" value="2.5" min="0" step="any" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-amber-500 tabular-nums" />
          <input id="recipe-unit" type="text" value="cups flour" placeholder="e.g. cups / grams" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-sm outline-none focus:ring-2 focus:ring-amber-500" />
        </div>
      </div>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-5 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between">
      <div>
        <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold mb-1 font-semibold">Scaled Ingredient Quantity</div>
        <div id="recipe-result" class="text-3xl sm:text-4xl font-black text-amber-600 dark:text-amber-400 tabular-nums">6.25 cups flour</div>
      </div>

      <div class="grid grid-cols-2 gap-4 py-4 border-y border-neutral-200 dark:border-neutral-800 my-4 text-xs font-mono">
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Scale Multiplier</span>
          <span id="recipe-scale-factor" class="font-bold text-black dark:text-white tabular-nums">2.5x</span>
        </div>
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Target Portion</span>
          <span id="recipe-portion" class="font-bold text-amber-600 dark:text-amber-400 tabular-nums">10 Servings</span>
        </div>
      </div>

      <div class="text-xs font-mono text-neutral-500 leading-relaxed">
        Instantly resizes baking & cooking ingredient quantities for any party size.
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const origInp = document.getElementById('recipe-orig-servings');
    const targetInp = document.getElementById('recipe-target-servings');
    const qtyInp = document.getElementById('recipe-qty');
    const unitInp = document.getElementById('recipe-unit');

    const resEl = document.getElementById('recipe-result');
    const factorEl = document.getElementById('recipe-scale-factor');
    const portionEl = document.getElementById('recipe-portion');

    function calcRecipe() {
      if (!origInp || !targetInp || !qtyInp || !unitInp) return;
      const orig = parseFloat(origInp.value) || 1;
      const target = parseFloat(targetInp.value) || 1;
      const qty = parseFloat(qtyInp.value) || 0;
      const unit = unitInp.value || '';

      const scale = target / orig;
      const scaledQty = qty * scale;

      const formattedQty = Number.isInteger(scaledQty) ? scaledQty.toString() : parseFloat(scaledQty.toFixed(2)).toString();

      if (resEl) resEl.textContent = `${formattedQty} ${unit}`;
      if (factorEl) factorEl.textContent = `${scale.toFixed(2)}x`;
      if (portionEl) portionEl.textContent = `${target} Servings`;
    }

    [origInp, targetInp, qtyInp, unitInp].forEach(el => el.addEventListener('input', calcRecipe));
    calcRecipe();
  })();
</script>
