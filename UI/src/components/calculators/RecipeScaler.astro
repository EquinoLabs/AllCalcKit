---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-amber-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">Recipe Batch & Ingredient Scaler</h3>
    </div>
    <span id="recipe-scale-badge" class="text-[10px] sm:text-[11px] font-mono px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 shrink-0 font-bold">
      Multiplier: 2.50x
    </span>
  </div>

  <div class="space-y-6">
    <!-- Servings Setup -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-neutral-50 dark:bg-neutral-950 p-4 rounded-xl border border-neutral-200 dark:border-neutral-800">
      <div>
        <label for="recipe-orig-servings" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">1. Original Recipe Servings</label>
        <div class="flex items-center gap-2">
          <input id="recipe-orig-servings" type="number" value="4" min="1" max="500" class="w-full px-3.5 py-2 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-amber-500 tabular-nums" />
          <span class="text-xs font-mono text-neutral-600 dark:text-neutral-400 shrink-0">servings</span>
        </div>
      </div>
      <div>
        <label for="recipe-target-servings" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">2. Desired Guest Servings</label>
        <div class="flex items-center gap-2">
          <input id="recipe-target-servings" type="number" value="10" min="1" max="500" class="w-full px-3.5 py-2 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-amber-500 tabular-nums" />
          <span class="text-xs font-mono text-neutral-600 dark:text-neutral-400 shrink-0">servings</span>
        </div>
      </div>
    </div>

    <!-- Multi-Ingredient Scaler Table -->
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <label class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold">3. Ingredients to Scale</label>
        <button id="add-ingredient-btn" type="button" class="text-xs font-mono font-bold text-amber-600 dark:text-amber-400 hover:underline cursor-pointer flex items-center gap-1">
          + Add Ingredient Row
        </button>
      </div>

      <!-- Ingredient Rows Container -->
      <div id="ingredient-rows" class="space-y-2.5">
        <!-- Row 1 -->
        <div class="ingredient-row grid grid-cols-12 gap-2 items-center bg-neutral-50 dark:bg-neutral-950 p-2.5 rounded-xl border border-neutral-200 dark:border-neutral-800">
          <div class="col-span-5 sm:col-span-4">
            <input type="text" value="All-Purpose Flour" placeholder="Ingredient (e.g. Flour)" class="ing-name w-full px-3 py-1.5 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-xs outline-none focus:ring-1 focus:ring-amber-500" />
          </div>
          <div class="col-span-3 sm:col-span-3">
            <input type="number" value="2" step="any" min="0" placeholder="Qty" class="ing-qty w-full px-3 py-1.5 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-xs outline-none focus:ring-1 focus:ring-amber-500 tabular-nums" />
          </div>
          <div class="col-span-4 sm:col-span-3">
            <input type="text" value="cups" placeholder="Unit (e.g. cups, g)" class="ing-unit w-full px-3 py-1.5 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-xs outline-none focus:ring-1 focus:ring-amber-500" />
          </div>
          <div class="col-span-12 sm:col-span-2 flex items-center justify-between sm:justify-end gap-2 pt-1 sm:pt-0 border-t sm:border-t-0 border-neutral-200 dark:border-neutral-800">
            <span class="ing-result text-xs sm:text-sm font-mono font-bold text-amber-600 dark:text-amber-400 tabular-nums">5 cups</span>
          </div>
        </div>

        <!-- Row 2 -->
        <div class="ingredient-row grid grid-cols-12 gap-2 items-center bg-neutral-50 dark:bg-neutral-950 p-2.5 rounded-xl border border-neutral-200 dark:border-neutral-800">
          <div class="col-span-5 sm:col-span-4">
            <input type="text" value="Granulated Sugar" placeholder="Ingredient" class="ing-name w-full px-3 py-1.5 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-xs outline-none focus:ring-1 focus:ring-amber-500" />
          </div>
          <div class="col-span-3 sm:col-span-3">
            <input type="number" value="300" step="any" min="0" placeholder="Qty" class="ing-qty w-full px-3 py-1.5 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-xs outline-none focus:ring-1 focus:ring-amber-500 tabular-nums" />
          </div>
          <div class="col-span-4 sm:col-span-3">
            <input type="text" value="grams" placeholder="Unit" class="ing-unit w-full px-3 py-1.5 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-xs outline-none focus:ring-1 focus:ring-amber-500" />
          </div>
          <div class="col-span-12 sm:col-span-2 flex items-center justify-between sm:justify-end gap-2 pt-1 sm:pt-0 border-t sm:border-t-0 border-neutral-200 dark:border-neutral-800">
            <span class="ing-result text-xs sm:text-sm font-mono font-bold text-amber-600 dark:text-amber-400 tabular-nums">750 grams</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Scaled Explanation Card -->
    <div class="text-xs font-mono bg-neutral-50 dark:bg-neutral-950 p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400 space-y-1.5">
      <span class="font-bold text-black dark:text-white block uppercase text-[10px] tracking-wider">How Recipe Scaler Works:</span>
      <p class="leading-relaxed font-medium">
        Scaling resizes your original recipe amounts proportionately for any number of guests. 
        For example: <strong>2 cups flour</strong> for 4 people scaled to 10 guests ($10/4 = 2.5\times$) becomes <strong>5 cups flour</strong>. 
        Units remain unchanged while quantities multiply automatically.
      </p>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const origInp = document.getElementById('recipe-orig-servings');
    const targetInp = document.getElementById('recipe-target-servings');
    const badgeEl = document.getElementById('recipe-scale-badge');
    const rowsContainer = document.getElementById('ingredient-rows');
    const addBtn = document.getElementById('add-ingredient-btn');

    function calculateAll() {
      if (!origInp || !targetInp) return;
      const orig = parseFloat(origInp.value) || 1;
      const target = parseFloat(targetInp.value) || 1;
      const scale = target / orig;

      if (badgeEl) badgeEl.textContent = `Multiplier: ${scale.toFixed(2)}x (${orig} → ${target} Servings)`;

      const rows = document.querySelectorAll('.ingredient-row');
      rows.forEach(row => {
        const qtyInp = row.querySelector('.ing-qty');
        const unitInp = row.querySelector('.ing-unit');
        const resultEl = row.querySelector('.ing-result');

        if (qtyInp && resultEl) {
          const qty = parseFloat(qtyInp.value) || 0;
          const unit = unitInp ? unitInp.value.trim() : '';
          const scaled = qty * scale;

          const formatted = Number.isInteger(scaled)
            ? scaled.toLocaleString()
            : parseFloat(scaled.toFixed(2)).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 });

          resultEl.textContent = `${formatted}${unit ? ' ' + unit : ''}`;
        }
      });
    }

    if (addBtn && rowsContainer) {
      addBtn.addEventListener('click', () => {
        const newRow = document.createElement('div');
        newRow.className = 'ingredient-row grid grid-cols-12 gap-2 items-center bg-neutral-50 dark:bg-neutral-950 p-2.5 rounded-xl border border-neutral-200 dark:border-neutral-800';
        newRow.innerHTML = `
          <div class="col-span-5 sm:col-span-4">
            <input type="text" value="" placeholder="Ingredient Name" class="ing-name w-full px-3 py-1.5 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-xs outline-none focus:ring-1 focus:ring-amber-500" />
          </div>
          <div class="col-span-3 sm:col-span-3">
            <input type="number" value="1" step="any" min="0" placeholder="Qty" class="ing-qty w-full px-3 py-1.5 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-xs outline-none focus:ring-1 focus:ring-amber-500 tabular-nums" />
          </div>
          <div class="col-span-4 sm:col-span-3">
            <input type="text" value="tsp" placeholder="Unit" class="ing-unit w-full px-3 py-1.5 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-xs outline-none focus:ring-1 focus:ring-amber-500" />
          </div>
          <div class="col-span-12 sm:col-span-2 flex items-center justify-between sm:justify-end gap-2 pt-1 sm:pt-0 border-t sm:border-t-0 border-neutral-200 dark:border-neutral-800">
            <span class="ing-result text-xs sm:text-sm font-mono font-bold text-amber-600 dark:text-amber-400 tabular-nums">2.5 tsp</span>
          </div>
        `;
        rowsContainer.appendChild(newRow);

        newRow.querySelectorAll('input').forEach(input => {
          input.addEventListener('input', calculateAll);
        });
        calculateAll();
      });
    }

    if (origInp) origInp.addEventListener('input', calculateAll);
    if (targetInp) targetInp.addEventListener('input', calculateAll);

    document.querySelectorAll('.ingredient-row input').forEach(input => {
      input.addEventListener('input', calculateAll);
    });

    calculateAll();
  })();
</script>
