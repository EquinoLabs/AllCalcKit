---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-purple-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">Age & Birthday Calculator</h3>
    </div>
    <span class="text-[10px] sm:text-[11px] font-mono px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-700 dark:text-purple-400 border border-purple-500/20 shrink-0 font-bold">
      Chronological Age
    </span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="space-y-4">
      <div>
        <label class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Date of Birth</label>
        <input id="age-dob" type="date" value="2000-01-01" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-purple-500" />
      </div>

      <div>
        <label class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Age at Date</label>
        <input id="age-target-date" type="date" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-purple-500" />
      </div>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-5 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between">
      <div>
        <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold mb-1 font-semibold">Your Exact Age</div>
        <div id="age-main-result" class="text-2xl sm:text-3xl font-black text-purple-600 dark:text-purple-400 tabular-nums">0 Years, 0 Months, 0 Days</div>
      </div>

      <div class="grid grid-cols-2 gap-4 py-4 border-y border-neutral-200 dark:border-neutral-800 my-4 text-xs font-mono">
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Total Days Lived</span>
          <span id="age-total-days" class="font-bold text-black dark:text-white tabular-nums">0 Days</span>
        </div>
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Next Birthday In</span>
          <span id="age-next-bday" class="font-bold text-purple-600 dark:text-purple-400 tabular-nums">0 Days</span>
        </div>
      </div>

      <div class="text-xs font-mono text-neutral-500 leading-relaxed">
        Exact chronological age calculation down to days, weeks, and total hours lived.
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const dobInp = document.getElementById('age-dob');
    const targetInp = document.getElementById('age-target-date');

    const mainEl = document.getElementById('age-main-result');
    const daysEl = document.getElementById('age-total-days');
    const bdayEl = document.getElementById('age-next-bday');

    if (targetInp) {
      const today = new Date().toISOString().split('T')[0];
      targetInp.value = today;
    }

    function calcAge() {
      if (!dobInp || !targetInp) return;
      const dob = new Date(dobInp.value);
      const target = new Date(targetInp.value);

      if (isNaN(dob.getTime()) || isNaN(target.getTime()) || dob > target) {
        if (mainEl) mainEl.textContent = 'Invalid Date Selection';
        return;
      }

      let y = target.getFullYear() - dob.getFullYear();
      let m = target.getMonth() - dob.getMonth();
      let d = target.getDate() - dob.getDate();

      if (d < 0) {
        m--;
        const prevMonth = new Date(target.getFullYear(), target.getMonth(), 0).getDate();
        d += prevMonth;
      }
      if (m < 0) {
        y--;
        m += 12;
      }

      const diffTime = Math.abs(target - dob);
      const totalDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

      // Next birthday countdown
      let nextBday = new Date(target.getFullYear(), dob.getMonth(), dob.getDate());
      if (nextBday < target) {
        nextBday.setFullYear(target.getFullYear() + 1);
      }
      const daysToBday = Math.ceil((nextBday - target) / (1000 * 60 * 60 * 24));

      if (mainEl) mainEl.textContent = `${y} Years, ${m} Months, ${d} Days`;
      if (daysEl) daysEl.textContent = `${totalDays.toLocaleString()} Days`;
      if (bdayEl) bdayEl.textContent = `${daysToBday} Days`;
    }

    [dobInp, targetInp].forEach(el => el.addEventListener('input', calcAge));
    calcAge();
  })();
</script>
