---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-amber-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">GST & Sales Tax Calculator</h3>
    </div>
    
    <!-- Currency Selector -->
    <div class="flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800 px-2 py-1 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs shrink-0">
      <select aria-label="Select currency unit" class="ack-currency-select bg-transparent text-black dark:text-white font-bold outline-none cursor-pointer text-xs">
        <option value="USD">USD ($)</option>
        <option value="INR">INR (₹)</option>
        <option value="EUR">EUR (€)</option>
        <option value="GBP">GBP (£)</option>
      </select>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="space-y-4">
      <div>
        <label for="tax-amount" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Amount</label>
        <input id="tax-amount" type="number" value="1000" min="0" step="10" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-amber-500 tabular-nums" />
      </div>

      <div>
        <label for="tax-rate" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Tax Rate (% GST / VAT / Sales Tax)</label>
        <div class="flex items-center gap-2">
          <input id="tax-rate" type="number" value="18" min="0" max="100" step="0.5" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-amber-500 tabular-nums" />
          <div class="flex gap-1.5 shrink-0">
            <button type="button" data-tax="5" class="tax-preset-btn cursor-pointer px-2.5 py-2 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-xs font-mono font-bold text-black dark:text-neutral-300 border border-neutral-300 dark:border-neutral-700 hover:bg-neutral-200 dark:hover:bg-neutral-700 active:scale-95 transition-all duration-150 shadow-2xs">5%</button>
            <button type="button" data-tax="12" class="tax-preset-btn cursor-pointer px-2.5 py-2 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-xs font-mono font-bold text-black dark:text-neutral-300 border border-neutral-300 dark:border-neutral-700 hover:bg-neutral-200 dark:hover:bg-neutral-700 active:scale-95 transition-all duration-150 shadow-2xs">12%</button>
            <button type="button" data-tax="18" class="tax-preset-btn cursor-pointer px-2.5 py-2 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-xs font-mono font-bold text-black dark:text-neutral-300 border border-neutral-300 dark:border-neutral-700 hover:bg-neutral-200 dark:hover:bg-neutral-700 active:scale-95 transition-all duration-150 shadow-2xs">18%</button>
          </div>
        </div>
      </div>

      <div>
        <label class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Tax Mode</label>
        <div class="flex bg-neutral-100 dark:bg-neutral-800 p-1 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs">
          <button id="tax-mode-add" type="button" class="flex-1 py-2 rounded-lg bg-white dark:bg-neutral-700 text-black dark:text-white font-bold shadow-xs cursor-pointer border border-transparent dark:border-neutral-500">Exclusive (+ Add Tax)</button>
          <button id="tax-mode-sub" type="button" class="flex-1 py-2 rounded-lg text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors cursor-pointer border border-transparent">Inclusive (- Extract Tax)</button>
        </div>
      </div>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-5 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between">
      <div>
        <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold mb-1">Gross Total Amount</div>
        <div id="tax-total-val" class="text-3xl sm:text-4xl font-black text-amber-600 dark:text-amber-400 tabular-nums">$0</div>
      </div>

      <div class="grid grid-cols-2 gap-4 py-4 border-y border-neutral-200 dark:border-neutral-800 my-4 text-xs font-mono">
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Net Base Price</span>
          <span id="tax-net-val" class="font-bold text-black dark:text-white tabular-nums">$0</span>
        </div>
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Tax Amount</span>
          <span id="tax-tax-val" class="font-bold text-amber-600 dark:text-amber-400 tabular-nums">$0</span>
        </div>
      </div>

      <div class="text-xs font-mono text-neutral-500 leading-relaxed">
        Real-time breakdown of CGST/SGST/VAT splits.
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    let mode = 'add';
    const amtInp = document.getElementById('tax-amount');
    const rateInp = document.getElementById('tax-rate');

    const btnAdd = document.getElementById('tax-mode-add');
    const btnSub = document.getElementById('tax-mode-sub');
    const presets = document.querySelectorAll('.tax-preset-btn');

    const totalEl = document.getElementById('tax-total-val');
    const netEl = document.getElementById('tax-net-val');
    const taxEl = document.getElementById('tax-tax-val');

    const CURRENCY_CONFIGS = {
      USD: { symbol: '$', locale: 'en-US' },
      INR: { symbol: '₹', locale: 'en-IN' },
      EUR: { symbol: '€', locale: 'en-IE' },
      GBP: { symbol: '£', locale: 'en-GB' }
    };

    function getCurrency() {
      return localStorage.getItem('ack_currency') || 'USD';
    }

    function formatMoney(num) {
      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;
      const formatted = num.toLocaleString(cfg.locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      return `${cfg.symbol}${formatted}`;
    }

    function updateActivePresets() {
      const val = rateInp.value;
      presets.forEach(p => {
        if (parseFloat(p.getAttribute('data-tax')) === parseFloat(val)) {
          p.classList.add('bg-black', 'text-white', 'border-black', 'dark:bg-neutral-700', 'dark:text-white', 'dark:border-neutral-500');
          p.classList.remove('bg-neutral-100', 'dark:bg-neutral-800', 'text-black', 'dark:text-neutral-300');
        } else {
          p.classList.remove('bg-black', 'text-white', 'border-black', 'dark:bg-neutral-700', 'dark:text-white', 'dark:border-neutral-500');
          p.classList.add('bg-neutral-100', 'dark:bg-neutral-800', 'text-black', 'dark:text-neutral-300');
        }
      });
    }

    function calcTax() {
      if (!amtInp || !rateInp) return;
      const amt = parseFloat(amtInp.value) || 0;
      const rate = parseFloat(rateInp.value) || 0;

      let net = 0;
      let tax = 0;
      let total = 0;

      if (mode === 'add') {
        net = amt;
        tax = net * (rate / 100);
        total = net + tax;
      } else {
        total = amt;
        net = total / (1 + (rate / 100));
        tax = total - net;
      }

      if (totalEl) totalEl.textContent = formatMoney(total);
      if (netEl) netEl.textContent = formatMoney(net);
      if (taxEl) taxEl.textContent = formatMoney(tax);

      updateActivePresets();
    }

    if (btnAdd && btnSub) {
      btnAdd.addEventListener('click', () => {
        mode = 'add';
        btnAdd.className = 'flex-1 py-2 rounded-lg bg-white dark:bg-neutral-700 text-black dark:text-white font-bold shadow-xs cursor-pointer border border-transparent dark:border-neutral-500';
        btnSub.className = 'flex-1 py-2 rounded-lg text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors cursor-pointer border border-transparent';
        calcTax();
      });
      btnSub.addEventListener('click', () => {
        mode = 'sub';
        btnSub.className = 'flex-1 py-2 rounded-lg bg-white dark:bg-neutral-700 text-black dark:text-white font-bold shadow-xs cursor-pointer border border-transparent dark:border-neutral-500';
        btnAdd.className = 'flex-1 py-2 rounded-lg text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors cursor-pointer border border-transparent';
        calcTax();
      });
    }

    presets.forEach(p => p.addEventListener('click', () => {
      rateInp.value = p.getAttribute('data-tax');
      calcTax();
    }));

    const selects = document.querySelectorAll('.ack-currency-select');
    selects.forEach(sel => {
      sel.value = getCurrency();
      sel.addEventListener('change', (e) => {
        const val = e.target.value;
        localStorage.setItem('ack_currency', val);
        window.dispatchEvent(new CustomEvent('ack_currency_change', { detail: val }));
      });
    });

    window.addEventListener('ack_currency_change', (e) => {
      selects.forEach(sel => sel.value = e.detail);
      calcTax();
    });

    [amtInp, rateInp].forEach(el => el.addEventListener('input', calcTax));
    calcTax();
  })();
</script>
