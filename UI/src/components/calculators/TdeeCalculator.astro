---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-rose-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">TDEE (Daily Calorie Intake) Calculator</h3>
    </div>
    <span class="text-[10px] sm:text-[11px] font-mono px-2 py-0.5 rounded-full bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-500/20 shrink-0 font-bold">
      Fitness & Maintenance
    </span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="space-y-4">
      <div class="grid grid-cols-3 gap-2">
        <div>
          <label for="tdee-age" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Age</label>
          <input id="tdee-age" type="number" value="25" min="10" max="100" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-rose-500 tabular-nums" />
        </div>
        <div>
          <label for="tdee-height" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Height (cm)</label>
          <input id="tdee-height" type="number" value="175" min="50" max="250" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-rose-500 tabular-nums" />
        </div>
        <div>
          <label for="tdee-weight" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Weight (kg)</label>
          <input id="tdee-weight" type="number" value="70" min="20" max="300" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-rose-500 tabular-nums" />
        </div>
      </div>

      <div>
        <label for="tdee-activity" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Daily Activity Level</label>
        <select id="tdee-activity" class="w-full pl-3.5 pr-9 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white text-xs font-bold outline-none cursor-pointer">
          <option value="1.2" selected>Sedentary (Desk Job, little to no exercise)</option>
          <option value="1.375">Lightly Active (Exercise 1-3 days/week)</option>
          <option value="1.55">Moderately Active (Exercise 3-5 days/week)</option>
          <option value="1.725">Very Active (Heavy Exercise 6-7 days/week)</option>
          <option value="1.9">Athlete / Physical Labor (2x per day)</option>
        </select>
      </div>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-5 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between">
      <div>
        <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold mb-1 font-semibold">Maintenance Calories (TDEE)</div>
        <div id="tdee-result" class="text-3xl sm:text-4xl font-black text-rose-600 dark:text-rose-400 tabular-nums">0 <span class="text-base font-normal">kcal/day</span></div>
      </div>

      <div class="grid grid-cols-2 gap-4 py-4 border-y border-neutral-200 dark:border-neutral-800 my-4 text-xs font-mono">
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Weight Loss (-500)</span>
          <span id="tdee-loss" class="font-bold text-black dark:text-white tabular-nums">0 kcal</span>
        </div>
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Muscle Gain (+300)</span>
          <span id="tdee-gain" class="font-bold text-rose-600 dark:text-rose-400 tabular-nums">0 kcal</span>
        </div>
      </div>

      <div class="text-xs font-mono text-neutral-500 leading-relaxed">
        Total Daily Energy Expenditure gives your exact target calories for maintaining, losing, or gaining body mass.
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const ageInp = document.getElementById('tdee-age');
    const hInp = document.getElementById('tdee-height');
    const wInp = document.getElementById('tdee-weight');
    const actInp = document.getElementById('tdee-activity');

    const resEl = document.getElementById('tdee-result');
    const lossEl = document.getElementById('tdee-loss');
    const gainEl = document.getElementById('tdee-gain');

    function calcTDEE() {
      if (!ageInp || !hInp || !wInp || !actInp) return;
      const age = parseFloat(ageInp.value) || 0;
      const h = parseFloat(hInp.value) || 0;
      const w = parseFloat(wInp.value) || 0;
      const act = parseFloat(actInp.value) || 1.2;

      const bmr = (10 * w) + (6.25 * h) - (5 * age) + 5;
      const tdee = bmr * act;

      if (resEl) resEl.innerHTML = `${Math.round(tdee).toLocaleString()} <span class="text-base font-normal">kcal/day</span>`;
      if (lossEl) lossEl.textContent = `${Math.round(tdee - 500).toLocaleString()} kcal`;
      if (gainEl) gainEl.textContent = `${Math.round(tdee + 300).toLocaleString()} kcal`;
    }

    [ageInp, hInp, wInp, actInp].forEach(el => el.addEventListener('input', calcTDEE));
    calcTDEE();
  })();
</script>
