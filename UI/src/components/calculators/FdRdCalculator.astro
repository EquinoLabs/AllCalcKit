---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4 flex-wrap">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-purple-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">FD & RD Investment Calculator</h3>
    </div>
    
    <div class="flex items-center gap-2">
      <!-- Currency Selector -->
      <div class="flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800 px-2 py-1 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs shrink-0">
        <select aria-label="Select currency unit" class="ack-currency-select bg-transparent text-black dark:text-white font-bold outline-none cursor-pointer text-xs">
          <option value="USD">USD ($)</option>
          <option value="INR">INR (₹)</option>
          <option value="EUR">EUR (€)</option>
          <option value="GBP">GBP (£)</option>
        </select>
      </div>

      <!-- Mode Toggle -->
      <div class="flex bg-neutral-100 dark:bg-neutral-800 p-1 rounded-xl border border-neutral-300 dark:border-neutral-700 text-xs font-mono">
        <button id="fdrd-mode-fd" type="button" class="px-3 py-1 rounded-lg bg-white dark:bg-neutral-900 text-black dark:text-white font-bold shadow-xs">FD</button>
        <button id="fdrd-mode-rd" type="button" class="px-3 py-1 rounded-lg text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors">RD</button>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="space-y-4">
      <div>
        <label for="fdrd-amt" id="fdrd-label-amt" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Total Deposit Amount</label>
        <input id="fdrd-amt" type="number" value="50000" min="1000" step="1000" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-purple-500 tabular-nums" />
      </div>

      <div>
        <label for="fdrd-rate" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Interest Rate (% p.a.)</label>
        <input id="fdrd-rate" type="number" value="7.5" min="1" max="20" step="0.1" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-purple-500 tabular-nums" />
      </div>

      <div>
        <label for="fdrd-years" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Tenure (Years)</label>
        <input id="fdrd-years" type="number" value="3" min="1" max="20" step="1" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-purple-500 tabular-nums" />
      </div>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-5 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between">
      <div>
        <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold mb-1 font-semibold">Maturity Amount</div>
        <div id="fdrd-maturity" class="text-3xl sm:text-4xl font-black text-purple-600 dark:text-purple-400 tabular-nums">$0</div>
      </div>

      <div class="grid grid-cols-2 gap-4 py-4 border-y border-neutral-200 dark:border-neutral-800 my-4 text-xs font-mono">
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Total Invested</span>
          <span id="fdrd-invested" class="font-bold text-black dark:text-white tabular-nums">$0</span>
        </div>
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Interest Earned</span>
          <span id="fdrd-interest" class="font-bold text-purple-600 dark:text-purple-400 tabular-nums">$0</span>
        </div>
      </div>

      <div class="text-xs font-mono text-neutral-500 leading-relaxed">
        Calculates quarterly compounded interest maturity for bank deposits.
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    let mode = 'fd';
    const amtInp = document.getElementById('fdrd-amt');
    const rateInp = document.getElementById('fdrd-rate');
    const yearsInp = document.getElementById('fdrd-years');
    const labelAmt = document.getElementById('fdrd-label-amt');

    const btnFd = document.getElementById('fdrd-mode-fd');
    const btnRd = document.getElementById('fdrd-mode-rd');

    const matEl = document.getElementById('fdrd-maturity');
    const invEl = document.getElementById('fdrd-invested');
    const intEl = document.getElementById('fdrd-interest');

    const CURRENCY_CONFIGS = {
      USD: { symbol: '$', locale: 'en-US' },
      INR: { symbol: '₹', locale: 'en-IN' },
      EUR: { symbol: '€', locale: 'en-IE' },
      GBP: { symbol: '£', locale: 'en-GB' }
    };

    function getCurrency() {
      return localStorage.getItem('ack_currency') || 'USD';
    }

    function formatMoney(num) {
      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;
      const formatted = Math.round(num).toLocaleString(cfg.locale);
      return `${cfg.symbol}${formatted}`;
    }

    function calcFDRD() {
      if (!amtInp || !rateInp || !yearsInp) return;
      const P = parseFloat(amtInp.value) || 0;
      const r = (parseFloat(rateInp.value) || 0) / 100;
      const t = parseFloat(yearsInp.value) || 0;

      let invested = 0;
      let maturity = 0;

      if (mode === 'fd') {
        invested = P;
        maturity = P * Math.pow(1 + (r / 4), 4 * t);
      } else {
        const n = t * 12;
        invested = P * n;
        let total = 0;
        for (let m = 1; m <= n; m++) {
          const monthsLeft = n - m + 1;
          total += P * Math.pow(1 + (r / 4), (4 * monthsLeft) / 12);
        }
        maturity = total;
      }

      const interest = maturity - invested;

      if (matEl) matEl.textContent = formatMoney(maturity);
      if (invEl) invEl.textContent = formatMoney(invested);
      if (intEl) intEl.textContent = formatMoney(interest);
    }

    if (btnFd && btnRd) {
      btnFd.addEventListener('click', () => {
        mode = 'fd';
        if (labelAmt) labelAmt.textContent = 'Total Deposit Amount';
        btnFd.className = 'px-3 py-1 rounded-lg bg-white dark:bg-neutral-900 text-black dark:text-white font-bold shadow-xs';
        btnRd.className = 'px-3 py-1 rounded-lg text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors';
        calcFDRD();
      });
      btnRd.addEventListener('click', () => {
        mode = 'rd';
        if (labelAmt) labelAmt.textContent = 'Monthly Deposit Amount';
        btnRd.className = 'px-3 py-1 rounded-lg bg-white dark:bg-neutral-900 text-black dark:text-white font-bold shadow-xs';
        btnFd.className = 'px-3 py-1 rounded-lg text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors';
        calcFDRD();
      });
    }

    const selects = document.querySelectorAll('.ack-currency-select');
    selects.forEach(sel => {
      sel.value = getCurrency();
      sel.addEventListener('change', (e) => {
        const val = e.target.value;
        localStorage.setItem('ack_currency', val);
        window.dispatchEvent(new CustomEvent('ack_currency_change', { detail: val }));
      });
    });

    window.addEventListener('ack_currency_change', (e) => {
      selects.forEach(sel => sel.value = e.detail);
      calcFDRD();
    });

    [amtInp, rateInp, yearsInp].forEach(el => el.addEventListener('input', calcFDRD));
    calcFDRD();
  })();
</script>
