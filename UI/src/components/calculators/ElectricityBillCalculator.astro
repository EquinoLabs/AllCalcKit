---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-amber-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">Appliance Electricity Bill Estimator</h3>
    </div>
    
    <!-- Currency Selector -->
    <div class="flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800 px-2 py-1 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs shrink-0">
      <select class="ack-currency-select bg-transparent text-black dark:text-white font-bold outline-none cursor-pointer text-xs">
        <option value="USD">USD ($)</option>
        <option value="INR">INR (₹)</option>
        <option value="EUR">EUR (€)</option>
        <option value="GBP">GBP (£)</option>
      </select>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="space-y-4">
      <div>
        <label class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Appliance Power Rating (Watts)</label>
        <input id="elec-watts" type="number" value="1500" min="1" step="50" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-amber-500 tabular-nums" />
      </div>

      <div>
        <label class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Daily Usage (Hours per Day)</label>
        <input id="elec-hours" type="number" value="8" min="0.5" max="24" step="0.5" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-amber-500 tabular-nums" />
      </div>

      <div>
        <label class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Electricity Cost per kWh</label>
        <input id="elec-rate" type="number" value="0.15" min="0.01" step="0.01" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-amber-500 tabular-nums" />
      </div>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-5 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between">
      <div>
        <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold mb-1 font-semibold">Estimated Monthly Cost (30 Days)</div>
        <div id="elec-month-cost" class="text-3xl sm:text-4xl font-black text-amber-600 dark:text-amber-400 tabular-nums">$0</div>
      </div>

      <div class="grid grid-cols-2 gap-4 py-4 border-y border-neutral-200 dark:border-neutral-800 my-4 text-xs font-mono">
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Daily Consumption</span>
          <span id="elec-kwh-day" class="font-bold text-black dark:text-white tabular-nums">0 kWh</span>
        </div>
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Annual Cost</span>
          <span id="elec-year-cost" class="font-bold text-amber-600 dark:text-amber-400 tabular-nums">$0</span>
        </div>
      </div>

      <div class="text-xs font-mono text-neutral-500 leading-relaxed">
        Calculates exact energy consumption (kWh) and power cost for home appliances.
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const wInp = document.getElementById('elec-watts');
    const hInp = document.getElementById('elec-hours');
    const rInp = document.getElementById('elec-rate');

    const mCostEl = document.getElementById('elec-month-cost');
    const kwhDayEl = document.getElementById('elec-kwh-day');
    const yCostEl = document.getElementById('elec-year-cost');

    const CURRENCY_CONFIGS = {
      USD: { symbol: '$', locale: 'en-US' },
      INR: { symbol: '₹', locale: 'en-IN' },
      EUR: { symbol: '€', locale: 'en-IE' },
      GBP: { symbol: '£', locale: 'en-GB' }
    };

    function getCurrency() {
      return localStorage.getItem('ack_currency') || 'USD';
    }

    function formatMoney(num) {
      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;
      const formatted = num.toLocaleString(cfg.locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      return `${cfg.symbol}${formatted}`;
    }

    function calcElec() {
      if (!wInp || !hInp || !rInp) return;
      const watts = parseFloat(wInp.value) || 0;
      const hours = parseFloat(hInp.value) || 0;
      const rate = parseFloat(rInp.value) || 0;

      const kwhPerDay = (watts * hours) / 1000;
      const kwhPerMonth = kwhPerDay * 30;
      const kwhPerYear = kwhPerDay * 365;

      const monthlyCost = kwhPerMonth * rate;
      const annualCost = kwhPerYear * rate;

      if (mCostEl) mCostEl.textContent = formatMoney(monthlyCost);
      if (kwhDayEl) kwhDayEl.textContent = `${kwhPerDay.toFixed(2)} kWh`;
      if (yCostEl) yCostEl.textContent = formatMoney(annualCost);
    }

    const selects = document.querySelectorAll('.ack-currency-select');
    selects.forEach(sel => {
      sel.value = getCurrency();
      sel.addEventListener('change', (e) => {
        const val = e.target.value;
        localStorage.setItem('ack_currency', val);
        window.dispatchEvent(new CustomEvent('ack_currency_change', { detail: val }));
      });
    });

    window.addEventListener('ack_currency_change', (e) => {
      selects.forEach(sel => sel.value = e.detail);
      calcElec();
    });

    [wInp, hInp, rInp].forEach(el => el.addEventListener('input', calcElec));
    calcElec();
  })();
</script>
