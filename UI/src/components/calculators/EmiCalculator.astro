    const payableDiffNote = document.getElementById('comparison-payable-diff-note');

    const matrixToggleBtn = document.getElementById('emi-matrix-toggle');
    const matrixToggleText = document.getElementById('emi-matrix-toggle-text');

    // Table Elements
    const tblAPrincipal = document.getElementById('tbl-a-principal');
    const tblBPrincipal = document.getElementById('tbl-b-principal');
    const tblDiffPrincipal = document.getElementById('tbl-diff-principal');
    const tblARate = document.getElementById('tbl-a-rate');
    const tblBRate = document.getElementById('tbl-b-rate');
    const tblDiffRate = document.getElementById('tbl-diff-rate');
    const tblATenure = document.getElementById('tbl-a-tenure');
    const tblBTenure = document.getElementById('tbl-b-tenure');
    const tblDiffTenure = document.getElementById('tbl-diff-tenure');
    const tblAEmi = document.getElementById('tbl-a-emi');
    const tblBEmi = document.getElementById('tbl-b-emi');
    const tblDiffEmi = document.getElementById('tbl-diff-emi');
    const tblAInterest = document.getElementById('tbl-a-interest');
    const tblBInterest = document.getElementById('tbl-b-interest');
    const tblDiffInterest = document.getElementById('tbl-diff-interest');
    const tblAPayable = document.getElementById('tbl-a-payable');
    const tblBPayable = document.getElementById('tbl-b-payable');
    const tblDiffPayable = document.getElementById('tbl-diff-payable');

    let isComparisonMode = false;

    const CURRENCY_CONFIGS: Record<string, { symbol: string; locale: string }> = {
      USD: { symbol: '$', locale: 'en-US' },
      INR: { symbol: '₹', locale: 'en-IN' },
      EUR: { symbol: '€', locale: 'en-IE' },
      GBP: { symbol: '£', locale: 'en-GB' }
    };

    function getCurrency(): string {
      return localStorage.getItem('ack_currency') || 'USD';
    }

    function formatIndianCompact(num: number): string {
      if (num >= 10000000) {
        const cr = (num / 10000000).toFixed(2).replace(/\.00$/, '');
        return `${cr} Cr`;
      }
      if (num >= 100000) {
        const l = (num / 100000).toFixed(2).replace(/\.00$/, '');
        return `${l} Lakh`;
      }
      return '';
    }

    function formatMoney(num: number): string {
      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;
      const formatted = Math.round(num).toLocaleString(cfg.locale);
      return `${cfg.symbol}${formatted}`;
    }

    function formatPreciseMoney(num: number): string {
      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;
      const formatted = num.toLocaleString(cfg.locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      return `${cfg.symbol}${formatted}`;
    }

    let lastCurrency = getCurrency();

    function updateSliderConfigForInput(inp: HTMLInputElement | null, minEl: HTMLElement | null, maxEl: HTMLElement | null) {
      const curr = getCurrency();
      if (!inp) return;

      if (curr === 'INR') {
        inp.min = '50000';
        inp.max = '20000000';
        inp.step = '50000';
        if (minEl) minEl.textContent = 'Min: ₹50,000 (50k)';
        if (maxEl) maxEl.textContent = 'Max: ₹2,00,00,000 (2 Cr)';
        
        if (lastCurrency !== 'INR' && parseFloat(inp.value) <= 1000000) {
          inp.value = '2500000';
        }
      } else {
        inp.min = '10000';
        inp.max = '1000000';
        inp.step = '5000';
        const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;
        if (minEl) minEl.textContent = `Min: ${cfg.symbol}10,000`;
        if (maxEl) maxEl.textContent = `Max: ${cfg.symbol}1,000,000`;
        
        if (lastCurrency === 'INR' && parseFloat(inp.value) > 1000000) {
          inp.value = '100000';
        }
      }
    }

    function updateAllSlidersForCurrency() {
      updateSliderConfigForInput(amountInput, minHint, maxHint);
      updateSliderConfigForInput(scenAAmountInp, scenAMinHint, scenAMaxHint);
      updateSliderConfigForInput(scenBAmountInp, scenBMinHint, scenBMaxHint);
      lastCurrency = getCurrency();
    }

    function calculateSingleEMI() {
      if (!amountInput || !rateInput || !tenureInput) return;

      const P = parseFloat(amountInput.value) || 0;
      const annualRate = parseFloat(rateInput.value) || 0;
      const years = parseFloat(tenureInput.value) || 0;

      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;

      let amountDisplay = Math.round(P).toLocaleString(cfg.locale);
      if (curr === 'INR') {
        const compact = formatIndianCompact(P);
        if (compact) {
          amountDisplay = `₹${amountDisplay} (${compact})`;
        } else {
          amountDisplay = `₹${amountDisplay}`;
        }
      }
      if (amountVal) amountVal.textContent = amountDisplay;
      if (rateVal) rateVal.textContent = annualRate.toFixed(1) + '%';
      if (tenureVal) tenureVal.textContent = years + (years === 1 ? ' Year' : ' Years');

      const res = calculateEMI(P, annualRate, years);

      if (monthlyResult) monthlyResult.textContent = formatMoney(res.monthlyEmi);
      if (totalInterestEl) totalInterestEl.textContent = formatMoney(res.totalInterest);
      if (totalPayableEl) totalPayableEl.textContent = formatMoney(res.totalPayable);

      if (principalPctEl) principalPctEl.textContent = res.principalPercent + '%';
      if (interestPctEl) interestPctEl.textContent = res.interestPercent + '%';
      if (principalBar) principalBar.style.width = res.principalPercent + '%';
      if (interestBar) interestBar.style.width = res.interestPercent + '%';

      // Update live Explain Calculation breakdown
      const r = annualRate / 12 / 100;
      const n = years * 12;
      const growth = r === 0 ? 1 : Math.pow(1 + r, n);

      if (expP) expP.textContent = formatMoney(P);
      if (expRateFormula) expRateFormula.textContent = `${annualRate.toFixed(1)}% ÷ 12 ÷ 100`;
      if (expR) expR.textContent = r.toFixed(8).replace(/\.?0+$/, '') || '0';
      if (expTenureFormula) expTenureFormula.textContent = `${years} × 12`;
      if (expN) expN.textContent = `${n} months`;

      const growthStr = growth.toFixed(4);
      if (expGrowth) expGrowth.textContent = `(1 + ${r.toFixed(6)})^${n} ≈ ${growthStr}`;
      if (expSubP) expSubP.textContent = Math.round(P).toLocaleString(cfg.locale);
      if (expSubR) expSubR.textContent = r.toFixed(6);
      if (expSubGrowth1) expSubGrowth1.textContent = growthStr;
      if (expSubGrowth2) expSubGrowth2.textContent = growthStr;
      if (expMonthlyVal) expMonthlyVal.textContent = `${formatPreciseMoney(res.monthlyEmi)} / month`;

      if (expTotFormula) expTotFormula.textContent = `${formatPreciseMoney(res.monthlyEmi)} × ${n}`;
      if (expTotPayable) expTotPayable.textContent = formatPreciseMoney(res.totalPayable);
      if (expIntFormula) expIntFormula.textContent = `${formatPreciseMoney(res.totalPayable)} − ${formatMoney(P)}`;
      if (expTotInterest) expTotInterest.textContent = formatPreciseMoney(res.totalInterest);
    }

    function calculateScenarioA() {
      if (!scenAAmountInp || !scenARateInp || !scenATenureInp) return;

      const P = parseFloat(scenAAmountInp.value) || 0;
      const annualRate = parseFloat(scenARateInp.value) || 0;
      const years = parseFloat(scenATenureInp.value) || 0;

      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;

      let amountDisplay = Math.round(P).toLocaleString(cfg.locale);
      if (curr === 'INR') {
        const compact = formatIndianCompact(P);
        if (compact) {
          amountDisplay = `₹${amountDisplay} (${compact})`;
        } else {
          amountDisplay = `₹${amountDisplay}`;
        }
      }
      if (scenAAmountVal) scenAAmountVal.textContent = amountDisplay;
      if (scenARateVal) scenARateVal.textContent = annualRate.toFixed(1) + '%';
      if (scenATenureVal) scenATenureVal.textContent = years + (years === 1 ? ' Year' : ' Years');

      const res = calculateEMI(P, annualRate, years);

      if (scenAMonthly) scenAMonthly.textContent = formatMoney(res.monthlyEmi);
      if (scenAInterest) scenAInterest.textContent = formatMoney(res.totalInterest);
      if (scenAPayable) scenAPayable.textContent = formatMoney(res.totalPayable);

      if (scenAPrincipalBar) scenAPrincipalBar.style.width = res.principalPercent + '%';
      if (scenAInterestBar) scenAInterestBar.style.width = res.interestPercent + '%';
    }

    function calculateScenarioB() {
      if (!scenBAmountInp || !scenBRateInp || !scenBTenureInp) return;

      const P = parseFloat(scenBAmountInp.value) || 0;
      const annualRate = parseFloat(scenBRateInp.value) || 0;
      const years = parseFloat(scenBTenureInp.value) || 0;

      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;

      let amountDisplay = Math.round(P).toLocaleString(cfg.locale);
      if (curr === 'INR') {
        const compact = formatIndianCompact(P);
        if (compact) {
          amountDisplay = `₹${amountDisplay} (${compact})`;
        } else {
          amountDisplay = `₹${amountDisplay}`;
        }
      }
      if (scenBAmountVal) scenBAmountVal.textContent = amountDisplay;
      if (scenBRateVal) scenBRateVal.textContent = annualRate.toFixed(1) + '%';
      if (scenBTenureVal) scenBTenureVal.textContent = years + (years === 1 ? ' Year' : ' Years');

      const res = calculateEMI(P, annualRate, years);

      if (scenBMonthly) scenBMonthly.textContent = formatMoney(res.monthlyEmi);
      if (scenBInterest) scenBInterest.textContent = formatMoney(res.totalInterest);
      if (scenBPayable) scenBPayable.textContent = formatMoney(res.totalPayable);

      if (scenBPrincipalBar) scenBPrincipalBar.style.width = res.principalPercent + '%';
      if (scenBInterestBar) scenBInterestBar.style.width = res.interestPercent + '%';
    }

    function updateComparisonSummary() {
      if (!scenAAmountInp || !scenARateInp || !scenATenureInp ||
          !scenBAmountInp || !scenBRateInp || !scenBTenureInp) return;

      const loanA = {
        principal: parseFloat(scenAAmountInp.value) || 0,
        annualRate: parseFloat(scenARateInp.value) || 0,
        tenureYears: parseFloat(scenATenureInp.value) || 0,
      };

      const loanB = {
        principal: parseFloat(scenBAmountInp.value) || 0,
        annualRate: parseFloat(scenBRateInp.value) || 0,
        tenureYears: parseFloat(scenBTenureInp.value) || 0,
      };

      const comp = compareLoans(loanA, loanB);

      // Recommendation Banner: Identifies overall lifetime cost winner
      if (recBanner && recTitle && recDetail) {
        if (comp.cheaperScenario === 'B') {
          recBanner.className = 'p-5 sm:p-6 rounded-2xl border border-emerald-200 dark:border-emerald-900/60 bg-emerald-50/80 dark:bg-emerald-950/40 transition-colors space-y-3';
          if (recIcon) recIcon.className = 'w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/20';
          recTitle.className = 'font-bold text-sm sm:text-base text-emerald-900 dark:text-emerald-200';
          recDetail.className = 'text-xs sm:text-sm font-mono text-emerald-800 dark:text-emerald-300';
          recTitle.textContent = 'Scenario B offers the lower lifetime borrowing cost.';
          recDetail.textContent = `Scenario B reduces lifetime borrowing costs by ${formatMoney(comp.totalCostSavings)}.`;
          if (heroSavingsEl) heroSavingsEl.textContent = `${formatMoney(comp.totalCostSavings)} SAVED`;
        } else if (comp.cheaperScenario === 'A') {
          recBanner.className = 'p-5 sm:p-6 rounded-2xl border border-emerald-200 dark:border-emerald-900/60 bg-emerald-50/80 dark:bg-emerald-950/40 transition-colors space-y-3';
          if (recIcon) recIcon.className = 'w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/20';
          recTitle.className = 'font-bold text-sm sm:text-base text-emerald-900 dark:text-emerald-200';
          recDetail.className = 'text-xs sm:text-sm font-mono text-emerald-800 dark:text-emerald-300';
          recTitle.textContent = 'Scenario A offers the lower lifetime borrowing cost.';
          recDetail.textContent = `Scenario A reduces lifetime borrowing costs by ${formatMoney(comp.totalCostSavings)}.`;
          if (heroSavingsEl) heroSavingsEl.textContent = `${formatMoney(comp.totalCostSavings)} SAVED`;
        } else {
          recBanner.className = 'p-5 sm:p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-100/70 dark:bg-neutral-900/70 transition-colors space-y-3';
          if (recIcon) recIcon.className = 'w-7 h-7 rounded-lg bg-neutral-200 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 flex items-center justify-center shrink-0 border border-neutral-300 dark:border-neutral-700';
          recTitle.className = 'font-bold text-sm sm:text-base text-neutral-900 dark:text-neutral-200';
          recDetail.className = 'text-xs sm:text-sm font-mono text-neutral-600 dark:text-neutral-400';
          recTitle.textContent = 'Both loan offers result in the same borrowing cost.';
          recDetail.textContent = `Both options produce the exact same total repayment of ${formatMoney(comp.scenarioA.totalPayable)}.`;
          if (heroSavingsEl) heroSavingsEl.textContent = 'Same Total Cost';
        }
      }

      // Card 1: Monthly Cash Flow / Affordability
      if (emiDiffVal && emiDiffNote) {
        if (comp.monthlySavings < 0.5) {
          emiDiffVal.textContent = 'Identical EMI';
          emiDiffNote.textContent = 'Both scenarios require the exact same monthly payment.';
        } else if (comp.monthlyCheaperScenario === 'B') {
          emiDiffVal.textContent = `Scenario B: ${formatMoney(comp.monthlySavings)} lower / mo`;
          emiDiffNote.textContent = `Scenario B requires ${formatMoney(comp.monthlySavings)} less per month for cash flow.`;
        } else {
          emiDiffVal.textContent = `Scenario A: ${formatMoney(comp.monthlySavings)} lower / mo`;
          emiDiffNote.textContent = `Scenario A requires ${formatMoney(comp.monthlySavings)} less per month for cash flow.`;
        }
      }

      // Card 2: Lifetime Interest Cost
      if (interestDiffVal && interestDiffNote) {
        if (comp.interestSavings < 0.5) {
          interestDiffVal.textContent = 'Identical interest';
          interestDiffNote.textContent = 'Both loan options charge the exact same lifetime interest.';
        } else if (comp.totalInterestDiff > 0) {
          interestDiffVal.textContent = `Scenario B saves ${formatMoney(comp.interestSavings)}`;
          interestDiffNote.textContent = `Scenario B reduces total borrowing cost by ${formatMoney(comp.interestSavings)} in lifetime interest.`;
        } else {
          interestDiffVal.textContent = `Scenario A saves ${formatMoney(comp.interestSavings)}`;
          interestDiffNote.textContent = `Scenario A reduces total borrowing cost by ${formatMoney(comp.interestSavings)} in lifetime interest.`;
        }
      }

      // Card 3: Overall Lifetime Borrowing Cost
      if (payableDiffVal && payableDiffNote) {
        if (comp.totalCostSavings < 0.5) {
          payableDiffVal.textContent = 'Identical total cost';
          payableDiffNote.textContent = 'Both scenarios result in the same total repayment amount.';
        } else if (comp.cheaperScenario === 'B') {
          payableDiffVal.textContent = `Scenario B saves ${formatMoney(comp.totalCostSavings)} overall`;
          payableDiffNote.textContent = `Scenario B has the lower total cost of borrowing.`;
        } else {
          payableDiffVal.textContent = `Scenario A saves ${formatMoney(comp.totalCostSavings)} overall`;
          payableDiffNote.textContent = `Scenario A has the lower total cost of borrowing.`;
        }
      }

      // Comparison Table
      if (tblAPrincipal) tblAPrincipal.textContent = formatMoney(loanA.principal);
      if (tblBPrincipal) tblBPrincipal.textContent = formatMoney(loanB.principal);
      if (tblDiffPrincipal) {
        const pDiff = loanA.principal - loanB.principal;
        tblDiffPrincipal.textContent = pDiff === 0 ? 'Same' : (pDiff > 0 ? `Scenario B is ${formatMoney(Math.abs(pDiff))} lower` : `Scenario A is ${formatMoney(Math.abs(pDiff))} lower`);
      }

      if (tblARate) tblARate.textContent = loanA.annualRate.toFixed(1) + '%';
      if (tblBRate) tblBRate.textContent = loanB.annualRate.toFixed(1) + '%';
      if (tblDiffRate) {
        const rDiff = loanA.annualRate - loanB.annualRate;
        tblDiffRate.textContent = rDiff === 0 ? 'Same' : (rDiff > 0 ? `Scenario B is ${Math.abs(rDiff).toFixed(1)}% lower` : `Scenario A is ${Math.abs(rDiff).toFixed(1)}% lower`);
      }

      if (tblATenure) tblATenure.textContent = `${loanA.tenureYears} Years`;
      if (tblBTenure) tblBTenure.textContent = `${loanB.tenureYears} Years`;
      if (tblDiffTenure) {
        const tDiff = loanA.tenureYears - loanB.tenureYears;
        tblDiffTenure.textContent = tDiff === 0 ? 'Same' : (tDiff > 0 ? `Scenario B is ${Math.abs(tDiff)} yrs shorter` : `Scenario A is ${Math.abs(tDiff)} yrs shorter`);
      }

      if (tblAEmi) tblAEmi.textContent = formatMoney(comp.scenarioA.monthlyEmi);
      if (tblBEmi) tblBEmi.textContent = formatMoney(comp.scenarioB.monthlyEmi);
      if (tblDiffEmi) {
        if (comp.monthlySavings < 0.5) {
          tblDiffEmi.textContent = 'Same';
        } else if (comp.monthlyCheaperScenario === 'B') {
          tblDiffEmi.textContent = `Scenario B saves ${formatMoney(comp.monthlySavings)}/mo`;
        } else {
          tblDiffEmi.textContent = `Scenario A saves ${formatMoney(comp.monthlySavings)}/mo`;
        }
      }

      if (tblAInterest) tblAInterest.textContent = formatMoney(comp.scenarioA.totalInterest);
      if (tblBInterest) tblBInterest.textContent = formatMoney(comp.scenarioB.totalInterest);
      if (tblDiffInterest) {
        if (comp.interestSavings < 0.5) {
          tblDiffInterest.textContent = 'Same';
        } else if (comp.totalInterestDiff > 0) {
          tblDiffInterest.textContent = `Scenario B saves ${formatMoney(comp.interestSavings)}`;
        } else {
          tblDiffInterest.textContent = `Scenario A saves ${formatMoney(comp.interestSavings)}`;
        }
      }

      if (tblAPayable) tblAPayable.textContent = formatMoney(comp.scenarioA.totalPayable);
      if (tblBPayable) tblBPayable.textContent = formatMoney(comp.scenarioB.totalPayable);
      if (tblDiffPayable) {
        if (comp.totalCostSavings < 0.5) {
          tblDiffPayable.textContent = 'Same';
        } else if (comp.cheaperScenario === 'B') {
          tblDiffPayable.textContent = `Scenario B saves ${formatMoney(comp.totalCostSavings)}`;
        } else {
          tblDiffPayable.textContent = `Scenario A saves ${formatMoney(comp.totalCostSavings)}`;
        }
      }
    }

    function setComparisonMode(enabled: boolean, syncFromSingle = true) {
      isComparisonMode = enabled;

      if (compareToggleBtn) {
        compareToggleBtn.setAttribute('aria-checked', enabled ? 'true' : 'false');
        if (enabled) {
          compareToggleBtn.classList.add('bg-neutral-900', 'text-white', 'dark:bg-purple-600', 'border-transparent');
          compareToggleBtn.classList.remove('bg-neutral-100', 'text-black', 'dark:bg-neutral-800', 'dark:text-white', 'border-neutral-300', 'dark:border-neutral-700');
        } else {
          compareToggleBtn.classList.remove('bg-neutral-900', 'text-white', 'dark:bg-purple-600', 'border-transparent');
          compareToggleBtn.classList.add('bg-neutral-100', 'text-black', 'dark:bg-neutral-800', 'dark:text-white', 'border-neutral-300', 'dark:border-neutral-700');
        }
      }

      if (compareToggleBadge) {
        if (enabled) {
          compareToggleBadge.classList.remove('hidden');
        } else {
          compareToggleBadge.classList.add('hidden');
        }
      }

      if (enabled) {
        // Toggling ON: Preserve existing single calculator state and copy to Scenario A if requested
        if (syncFromSingle) {
          if (amountInput && scenAAmountInp) {
            scenAAmountInp.value = amountInput.value;
          }
          if (rateInput && scenARateInp) {
            scenARateInp.value = rateInput.value;
          }
          if (tenureInput && scenATenureInp) {
            scenATenureInp.value = tenureInput.value;
          }

          // Initialize Scenario B with an offer variation (e.g. rate - 0.5%) if not already customized
          if (scenBAmountInp && scenAAmountInp && !scenBAmountInp.dataset.modified) {
            scenBAmountInp.value = scenAAmountInp.value;
          }
          if (scenBRateInp && scenARateInp && !scenBRateInp.dataset.modified) {
            const defaultRate = Math.max(1, parseFloat(scenARateInp.value) - 0.5);
            scenBRateInp.value = defaultRate.toFixed(1);
          }
          if (scenBTenureInp && scenATenureInp && !scenBTenureInp.dataset.modified) {
            scenBTenureInp.value = scenATenureInp.value;
          }
        }

        singleView?.classList.add('hidden');
        compareView?.classList.remove('hidden');

        // Move Share Result button to comparison recommendation hero
        const shareBtnEl = document.getElementById('emi-share-btn');
        const compareSlot = document.getElementById('emi-compare-share-slot');
        if (shareBtnEl && compareSlot && shareBtnEl.parentElement !== compareSlot) {
          compareSlot.appendChild(shareBtnEl);
        }

        calculateScenarioA();
        calculateScenarioB();
        updateComparisonSummary();
      } else {
        // Toggling OFF: Restore original single calculator state from Scenario A
        if (scenAAmountInp && amountInput) {
          amountInput.value = scenAAmountInp.value;
        }
        if (scenARateInp && rateInput) {
          rateInput.value = scenARateInp.value;
        }
        if (scenATenureInp && tenureInput) {
          tenureInput.value = scenATenureInp.value;
        }

        compareView?.classList.add('hidden');
        singleView?.classList.remove('hidden');

        // Move Share Result button back to single view result card
        const shareBtnEl = document.getElementById('emi-share-btn');
        const singleSlot = document.getElementById('emi-single-share-slot');
        if (shareBtnEl && singleSlot && shareBtnEl.parentElement !== singleSlot) {
          singleSlot.appendChild(shareBtnEl);
        }

        calculateSingleEMI();
      }
    }

    // Toggle button event
    compareToggleBtn?.addEventListener('click', () => {
      setComparisonMode(!isComparisonMode);
    });

    // Reset Scenario A
    scenAResetBtn?.addEventListener('click', () => {
      const curr = getCurrency();
      if (scenAAmountInp) {
        scenAAmountInp.value = curr === 'INR' ? '2500000' : '100000';
      }
      if (scenARateInp) {
        scenARateInp.value = '8.5';
      }
      if (scenATenureInp) {
        scenATenureInp.value = '5';
      }
      calculateScenarioA();
      updateComparisonSummary();
    });

    // Reset Scenario B
    scenBResetBtn?.addEventListener('click', () => {
      const curr = getCurrency();
      if (scenBAmountInp) {
        scenBAmountInp.value = curr === 'INR' ? '2500000' : '100000';
        delete scenBAmountInp.dataset.modified;
      }
      if (scenBRateInp) {
        scenBRateInp.value = '8.0';
        delete scenBRateInp.dataset.modified;
      }
      if (scenBTenureInp) {
        scenBTenureInp.value = '5';
        delete scenBTenureInp.dataset.modified;
      }
      calculateScenarioB();
      updateComparisonSummary();
    });

    // Copy Scenario A into Scenario B
    scenBCopyBtn?.addEventListener('click', () => {
      if (!scenAAmountInp || !scenARateInp || !scenATenureInp ||
          !scenBAmountInp || !scenBRateInp || !scenBTenureInp) return;

      scenBAmountInp.value = scenAAmountInp.value;
      scenBRateInp.value = scenARateInp.value;
      scenBTenureInp.value = scenATenureInp.value;

      scenBAmountInp.dataset.modified = 'true';
      scenBRateInp.dataset.modified = 'true';
      scenBTenureInp.dataset.modified = 'true';

      calculateScenarioB();
      updateComparisonSummary();

      if (scenBCopyText) {
        const originalText = scenBCopyText.textContent;
        scenBCopyText.textContent = 'Copied!';
        setTimeout(() => {
          if (scenBCopyText) scenBCopyText.textContent = originalText;
        }, 1500);
      }
    });

    // Input event listeners for Single Calculator
    amountInput?.addEventListener('input', calculateSingleEMI);
    rateInput?.addEventListener('input', calculateSingleEMI);
    tenureInput?.addEventListener('input', calculateSingleEMI);

    // Input event listeners for Scenario A
    scenAAmountInp?.addEventListener('input', () => {
      calculateScenarioA();
      updateComparisonSummary();
    });
    scenARateInp?.addEventListener('input', () => {
      calculateScenarioA();
      updateComparisonSummary();
    });
    scenATenureInp?.addEventListener('input', () => {
      calculateScenarioA();
      updateComparisonSummary();
    });

    // Input event listeners for Scenario B
    scenBAmountInp?.addEventListener('input', () => {
      if (scenBAmountInp) scenBAmountInp.dataset.modified = 'true';
      calculateScenarioB();
      updateComparisonSummary();
    });
    scenBRateInp?.addEventListener('input', () => {
      if (scenBRateInp) scenBRateInp.dataset.modified = 'true';
      calculateScenarioB();
      updateComparisonSummary();
    });
    scenBTenureInp?.addEventListener('input', () => {
      if (scenBTenureInp) scenBTenureInp.dataset.modified = 'true';
      calculateScenarioB();
      updateComparisonSummary();
    });

    // Initialize currency selects
    const selects = document.querySelectorAll('.ack-currency-select') as NodeListOf<HTMLSelectElement>;
    selects.forEach(sel => {
      sel.value = getCurrency();
      sel.addEventListener('change', (e) => {
        const val = (e.target as HTMLSelectElement).value;
        localStorage.setItem('ack_currency', val);
        window.dispatchEvent(new CustomEvent('ack_currency_change', { detail: val }));
      });
    });

    window.addEventListener('ack_currency_change', (e: any) => {
      selects.forEach(sel => sel.value = e.detail);
      updateAllSlidersForCurrency();
      calculateSingleEMI();
      calculateScenarioA();
      calculateScenarioB();
      updateComparisonSummary();
    });

    // Read and restore URL query parameters if present
    function restoreStateFromUrl() {
      const { values, hasParams } = parseQueryParams<{
        currency?: string;
        // Single mode params
        amount?: number;
        rate?: number;
        years?: number;
        // Comparison mode params
        compare?: boolean;
        amountA?: number;
        rateA?: number;
        yearsA?: number;
        amountB?: number;
        rateB?: number;
        yearsB?: number;
      }>(window.location.search, LOAN_EMI_SCHEMA);

      if (values.currency) {
        localStorage.setItem('ack_currency', values.currency);
        selects.forEach(sel => sel.value = values.currency!);
      }

      updateAllSlidersForCurrency();

      if (values.compare === true) {
        // Restore Scenario A values if provided
        if (scenAAmountInp && typeof values.amountA === 'number') {
          scenAAmountInp.value = values.amountA.toString();
        }
        if (scenARateInp && typeof values.rateA === 'number') {
          scenARateInp.value = values.rateA.toString();
        }
        if (scenATenureInp && typeof values.yearsA === 'number') {
          scenATenureInp.value = values.yearsA.toString();
        }

        // Restore Scenario B values if provided
        if (scenBAmountInp && typeof values.amountB === 'number') {
          scenBAmountInp.value = values.amountB.toString();
          scenBAmountInp.dataset.modified = 'true';
        }
        if (scenBRateInp && typeof values.rateB === 'number') {
          scenBRateInp.value = values.rateB.toString();
          scenBRateInp.dataset.modified = 'true';
        }
        if (scenBTenureInp && typeof values.yearsB === 'number') {
          scenBTenureInp.value = values.yearsB.toString();
          scenBTenureInp.dataset.modified = 'true';
        }

        // Synchronize single-calculator values with Scenario A for smooth toggling
        if (amountInput && scenAAmountInp) amountInput.value = scenAAmountInp.value;
        if (rateInput && scenARateInp) rateInput.value = scenARateInp.value;
        if (tenureInput && scenATenureInp) tenureInput.value = scenATenureInp.value;

        setComparisonMode(true, false);
      } else {
        if (amountInput && typeof values.amount === 'number') {
          amountInput.value = values.amount.toString();
        }
        if (rateInput && typeof values.rate === 'number') {
          rateInput.value = values.rate.toString();
        }
        if (tenureInput && typeof values.years === 'number') {
          tenureInput.value = values.years.toString();
        }

        calculateSingleEMI();
      }

      return hasParams;
    }

    restoreStateFromUrl();

    // Matrix Table Toggle for granular parameters
    let isMatrixExpanded = false;
    if (matrixToggleBtn) {
      matrixToggleBtn.addEventListener('click', () => {
        isMatrixExpanded = !isMatrixExpanded;
        const extraRows = document.querySelectorAll('.emi-extra-row');
        extraRows.forEach(row => {
          if (isMatrixExpanded) {
            row.classList.remove('hidden');
          } else {
            row.classList.add('hidden');
          }
        });
        if (matrixToggleText) {
          matrixToggleText.textContent = isMatrixExpanded
            ? '↑ Show Compact Summary'
            : '↓ Show More (Principal, Rate, Tenure & Full Matrix)';
        }
      });
    }

    // Initialize Share Result integration (automatically switches between single and comparison params)
    const shareOptions = {
      schema: LOAN_EMI_SCHEMA,
      title: 'Loan & EMI Calculation',
      getParams: () => {
        if (isComparisonMode) {
          return {
            compare: true,
            amountA: parseFloat(scenAAmountInp?.value || '100000'),
            rateA: parseFloat(scenARateInp?.value || '8.5'),
            yearsA: parseFloat(scenATenureInp?.value || '5'),
            amountB: parseFloat(scenBAmountInp?.value || '100000'),
            rateB: parseFloat(scenBRateInp?.value || '8.0'),
            yearsB: parseFloat(scenBTenureInp?.value || '5'),
            currency: getCurrency()
          };
        } else {
          return {
            amount: parseFloat(amountInput?.value || '100000'),
            rate: parseFloat(rateInput?.value || '8.5'),
            years: parseFloat(tenureInput?.value || '5'),
            currency: getCurrency()
          };
        }
      }
    };

    initShareButton({
      ...shareOptions,
      buttonId: 'emi-share-btn'
    });
  })();
</script>
