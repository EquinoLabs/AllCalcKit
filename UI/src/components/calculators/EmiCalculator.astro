---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-black dark:bg-purple-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">Loan & EMI Calculator</h3>
    </div>
    
    <!-- Currency & Locale Selector Pill -->
    <div class="flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800 px-2 py-1 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs shrink-0">
      <span class="text-[10px] text-neutral-600 dark:text-neutral-400 font-semibold hidden sm:inline">Unit:</span>
      <select aria-label="Select currency unit" class="ack-currency-select bg-transparent text-black dark:text-white font-bold outline-none cursor-pointer text-xs">
        <option value="USD">USD ($)</option>
        <option value="INR">INR (₹)</option>
        <option value="EUR">EUR (€)</option>
        <option value="GBP">GBP (£)</option>
      </select>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Controls -->
    <div class="space-y-4">
      <!-- Loan Amount -->
      <div>
        <div class="flex justify-between items-center mb-1 text-xs font-semibold">
          <label for="emi-amount" class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Loan Amount</label>
          <span id="emi-amount-val" class="font-mono font-bold text-black dark:text-white">100,000</span>
        </div>
        <input id="emi-amount" type="range" min="10000" max="1000000" step="5000" value="100000" class="w-full h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-black dark:accent-purple-600" />
        <div class="flex justify-between text-[10px] font-mono text-neutral-400 mt-1">
          <span id="emi-min-hint">Min: $10,000</span>
          <span id="emi-max-hint">Max: $1,000,000</span>
        </div>
      </div>

      <!-- Interest Rate -->
      <div>
        <div class="flex justify-between items-center mb-1 text-xs font-semibold">
          <label for="emi-rate" class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Interest Rate (% p.a.)</label>
          <span id="emi-rate-val" class="font-mono font-bold text-black dark:text-white">8.5%</span>
        </div>
        <input id="emi-rate" type="range" min="1" max="25" step="0.1" value="8.5" class="w-full h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-black dark:accent-purple-600" />
      </div>

      <!-- Tenure -->
      <div>
        <div class="flex justify-between items-center mb-1 text-xs font-semibold">
          <label for="emi-tenure" class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Loan Tenure (Years)</label>
          <span id="emi-tenure-val" class="font-mono font-bold text-black dark:text-white">5 Years</span>
        </div>
        <input id="emi-tenure" type="range" min="1" max="30" step="1" value="5" class="w-full h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-black dark:accent-purple-600" />
      </div>
    </div>

    <!-- Output Card & Visual Breakdown -->
    <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-5 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between">
      <div>
        <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold mb-1">Monthly Repayment (EMI)</div>
        <div id="emi-monthly-result" class="text-3xl sm:text-4xl font-black text-black dark:text-purple-400 tabular-nums">
          $0
        </div>
      </div>

      <!-- Breakdown Table -->
      <div class="grid grid-cols-2 gap-4 py-4 border-y border-neutral-200 dark:border-neutral-800 my-4 text-xs font-mono">
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Total Interest</span>
          <span id="emi-total-interest" class="font-bold text-black dark:text-white tabular-nums">$0</span>
        </div>
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Total Payable</span>
          <span id="emi-total-payable" class="font-bold text-black dark:text-white tabular-nums">$0</span>
        </div>
      </div>

      <!-- Visual Percentage Bar -->
      <div>
        <div class="flex justify-between text-[11px] font-mono text-neutral-700 dark:text-neutral-400 mb-1 font-bold">
          <span>Principal (<span id="principal-pct">70%</span>)</span>
          <span>Interest (<span id="interest-pct">30%</span>)</span>
        </div>
        <div class="w-full h-3 rounded-full bg-neutral-200 dark:bg-neutral-800 overflow-hidden flex">
          <div id="principal-bar" class="h-full bg-black dark:bg-purple-600 transition-all duration-300" style="width: 70%"></div>
          <div id="interest-bar" class="h-full bg-neutral-400 dark:bg-purple-400/40 transition-all duration-300" style="width: 30%"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Live Explain Calculation Walkthrough -->
  <details id="emi-explain-details" class="group bg-neutral-50/70 dark:bg-neutral-950/60 border border-neutral-200 dark:border-neutral-800 rounded-2xl p-4 sm:p-5 transition-all [&_[data-icon]]:open:rotate-180 mt-6 shadow-xs">
    <summary class="flex items-center justify-between gap-4 font-bold text-xs sm:text-sm text-neutral-800 dark:text-neutral-200 cursor-pointer select-none">
      <div class="flex items-center gap-2.5">
        <span class="w-7 h-7 rounded-lg bg-purple-500/10 dark:bg-purple-400/10 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0 border border-purple-500/20">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        </span>
        <div>
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400 block sm:inline-block sm:mr-2">Explain Calculation</span>
          <span class="font-bold text-neutral-900 dark:text-neutral-100">Live Mathematical Working</span>
        </div>
      </div>
      <div class="flex items-center gap-1.5 shrink-0">
        <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 group-open:hidden">Show Steps</span>
        <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 hidden group-open:inline">Hide Steps</span>
        <svg data-icon class="w-4 h-4 text-neutral-400 shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </summary>

    <div class="mt-4 pt-4 border-t border-neutral-200/70 dark:border-neutral-800/80 space-y-4 text-xs font-mono">
      <!-- Formula -->
      <div class="space-y-1.5">
        <div class="text-[10px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-bold">Standard Amortization Formula</div>
        <div class="p-2.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-neutral-900 dark:text-purple-300 font-bold overflow-x-auto text-xs sm:text-sm">
          EMI = [P × r × (1 + r)ⁿ] ÷ [(1 + r)ⁿ − 1]
        </div>
      </div>

      <!-- Live Calculation Working -->
      <div id="emi-explain-body" class="space-y-3">
        <!-- Step 1: Inputs & Monthly Rate -->
        <div class="p-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 space-y-1">
          <div class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100">Step 1 — Rate & Periods Conversion</div>
          <div class="text-neutral-600 dark:text-neutral-400 space-y-0.5 pt-0.5">
            <div>Principal (P) = <span id="exp-emi-p" class="font-bold text-black dark:text-white">$100,000</span></div>
            <div>Monthly Rate (r) = <span id="exp-emi-rate-formula">8.5% ÷ 12 ÷ 100</span> = <span id="exp-emi-r" class="font-bold text-black dark:text-white">0.00708333</span></div>
            <div>Total Payments (n) = <span id="exp-emi-tenure-formula">5 × 12</span> = <span id="exp-emi-n" class="font-bold text-black dark:text-white">60 months</span></div>
          </div>
        </div>

        <!-- Step 2: Substitution & EMI -->
        <div class="p-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 space-y-1">
          <div class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100">Step 2 — Monthly Installment (EMI)</div>
          <div class="text-neutral-600 dark:text-neutral-400 space-y-1 pt-0.5">
            <div>Growth Multiplier (1 + r)ⁿ = <span id="exp-emi-growth" class="font-bold text-black dark:text-white">(1.00708333)⁶⁰ ≈ 1.5273</span></div>
            <div class="p-2 rounded-lg bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 text-neutral-800 dark:text-neutral-200 overflow-x-auto text-[11px]">
              EMI = [<span id="exp-emi-sub-p">100,000</span> × <span id="exp-emi-sub-r">0.00708333</span> × <span id="exp-emi-sub-growth1">1.5273</span>] ÷ [<span id="exp-emi-sub-growth2">1.5273</span> − 1]
            </div>
            <div class="font-bold text-purple-600 dark:text-purple-400 text-sm">
              = <span id="exp-emi-monthly-val">$2,051.65 / month</span>
            </div>
          </div>
        </div>

        <!-- Step 3: Total Interest & Repayment -->
        <div class="p-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 space-y-1">
          <div class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100">Step 3 — Total Cost Breakdown</div>
          <div class="text-neutral-600 dark:text-neutral-400 space-y-0.5 pt-0.5">
            <div>Total Repayment = <span id="exp-emi-tot-formula">$2,051.65 × 60</span> = <span id="exp-emi-tot-payable" class="font-bold text-black dark:text-white">$123,099.16</span></div>
            <div>Total Interest = <span id="exp-emi-int-formula">$123,099.16 − $100,000</span> = <span id="exp-emi-tot-interest" class="font-bold text-black dark:text-white">$23,099.16</span></div>
          </div>
        </div>
      </div>
    </div>
  </details>
</div>

<script is:inline>
  (function() {
    const amountInput = document.getElementById('emi-amount');
    const rateInput = document.getElementById('emi-rate');
    const tenureInput = document.getElementById('emi-tenure');

    const amountVal = document.getElementById('emi-amount-val');
    const rateVal = document.getElementById('emi-rate-val');
    const tenureVal = document.getElementById('emi-tenure-val');

    const minHint = document.getElementById('emi-min-hint');
    const maxHint = document.getElementById('emi-max-hint');

    const monthlyResult = document.getElementById('emi-monthly-result');
    const totalInterestEl = document.getElementById('emi-total-interest');
    const totalPayableEl = document.getElementById('emi-total-payable');

    const principalPctEl = document.getElementById('principal-pct');
    const interestPctEl = document.getElementById('interest-pct');
    const principalBar = document.getElementById('principal-bar');
    const interestBar = document.getElementById('interest-bar');

    // Explain elements
    const expP = document.getElementById('exp-emi-p');
    const expRateFormula = document.getElementById('exp-emi-rate-formula');
    const expR = document.getElementById('exp-emi-r');
    const expTenureFormula = document.getElementById('exp-emi-tenure-formula');
    const expN = document.getElementById('exp-emi-n');
    const expGrowth = document.getElementById('exp-emi-growth');
    const expSubP = document.getElementById('exp-emi-sub-p');
    const expSubR = document.getElementById('exp-emi-sub-r');
    const expSubGrowth1 = document.getElementById('exp-emi-sub-growth1');
    const expSubGrowth2 = document.getElementById('exp-emi-sub-growth2');
    const expMonthlyVal = document.getElementById('exp-emi-monthly-val');
    const expTotFormula = document.getElementById('exp-emi-tot-formula');
    const expTotPayable = document.getElementById('exp-emi-tot-payable');
    const expIntFormula = document.getElementById('exp-emi-int-formula');
    const expTotInterest = document.getElementById('exp-emi-tot-interest');

    const CURRENCY_CONFIGS = {
      USD: { symbol: '$', locale: 'en-US' },
      INR: { symbol: '₹', locale: 'en-IN' },
      EUR: { symbol: '€', locale: 'en-IE' },
      GBP: { symbol: '£', locale: 'en-GB' }
    };

    function getCurrency() {
      return localStorage.getItem('ack_currency') || 'USD';
    }

    function formatIndianCompact(num) {
      if (num >= 10000000) {
        const cr = (num / 10000000).toFixed(2).replace(/\.00$/, '');
        return `${cr} Cr`;
      }
      if (num >= 100000) {
        const l = (num / 100000).toFixed(2).replace(/\.00$/, '');
        return `${l} Lakh`;
      }
      return '';
    }

    function formatMoney(num) {
      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;
      const formatted = Math.round(num).toLocaleString(cfg.locale);
      return `${cfg.symbol}${formatted}`;
    }

    function formatPreciseMoney(num) {
      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;
      const formatted = num.toLocaleString(cfg.locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      return `${cfg.symbol}${formatted}`;
    }

    let lastCurrency = getCurrency();

    function updateSliderForCurrency() {
      const curr = getCurrency();
      if (!amountInput) return;

      if (curr === 'INR') {
        amountInput.min = '50000';
        amountInput.max = '20000000';
        amountInput.step = '50000';
        if (minHint) minHint.textContent = 'Min: ₹50,000 (50k)';
        if (maxHint) maxHint.textContent = 'Max: ₹2,00,00,000 (2 Cr)';
        
        // If switched from non-INR or initial value is default $100k, set natural Indian home loan default ₹25 Lakhs
        if (lastCurrency !== 'INR' && parseFloat(amountInput.value) <= 1000000) {
          amountInput.value = '2500000';
        }
      } else {
        amountInput.min = '10000';
        amountInput.max = '1000000';
        amountInput.step = '5000';
        const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;
        if (minHint) minHint.textContent = `Min: ${cfg.symbol}10,000`;
        if (maxHint) maxHint.textContent = `Max: ${cfg.symbol}1,000,000`;
        
        // If switched from INR and value is large Indian number, reset to standard USD default $100k
        if (lastCurrency === 'INR' && parseFloat(amountInput.value) > 1000000) {
          amountInput.value = '100000';
        }
      }
      lastCurrency = curr;
    }

    function calculateEMI() {
      if (!amountInput || !rateInput || !tenureInput) return;

      const P = parseFloat(amountInput.value) || 0;
      const annualRate = parseFloat(rateInput.value) || 0;
      const years = parseFloat(tenureInput.value) || 0;

      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;

      let amountDisplay = Math.round(P).toLocaleString(cfg.locale);
      if (curr === 'INR') {
        const compact = formatIndianCompact(P);
        if (compact) {
          amountDisplay = `₹${amountDisplay} (${compact})`;
        } else {
          amountDisplay = `₹${amountDisplay}`;
        }
      }
      if (amountVal) amountVal.textContent = amountDisplay;
      if (rateVal) rateVal.textContent = annualRate.toFixed(1) + '%';
      if (tenureVal) tenureVal.textContent = years + (years === 1 ? ' Year' : ' Years');

      if (P <= 0 || years <= 0) {
        if (monthlyResult) monthlyResult.textContent = `${cfg.symbol}0`;
        if (totalInterestEl) totalInterestEl.textContent = `${cfg.symbol}0`;
        if (totalPayableEl) totalPayableEl.textContent = `${cfg.symbol}0`;
        return;
      }

      const r = annualRate / 12 / 100;
      const n = years * 12;

      let emi = 0;
      let totalPayable = 0;
      let totalInterest = 0;
      let growth = 1;

      if (r === 0) {
        emi = P / n;
        totalPayable = P;
        totalInterest = 0;
      } else {
        growth = Math.pow(1 + r, n);
        emi = (P * r * growth) / (growth - 1);
        totalPayable = emi * n;
        totalInterest = totalPayable - P;
      }

      if (monthlyResult) monthlyResult.textContent = formatMoney(emi);
      if (totalInterestEl) totalInterestEl.textContent = formatMoney(totalInterest);
      if (totalPayableEl) totalPayableEl.textContent = formatMoney(totalPayable);

      const pPct = totalPayable > 0 ? Math.round((P / totalPayable) * 100) : 100;
      const iPct = 100 - pPct;

      if (principalPctEl) principalPctEl.textContent = pPct + '%';
      if (interestPctEl) interestPctEl.textContent = iPct + '%';
      if (principalBar) principalBar.style.width = pPct + '%';
      if (interestBar) interestBar.style.width = iPct + '%';

      // Update live Explain Calculation breakdown
      if (expP) expP.textContent = formatMoney(P);
      if (expRateFormula) expRateFormula.textContent = `${annualRate.toFixed(1)}% ÷ 12 ÷ 100`;
      if (expR) expR.textContent = r.toFixed(8).replace(/\.?0+$/, '') || '0';
      if (expTenureFormula) expTenureFormula.textContent = `${years} × 12`;
      if (expN) expN.textContent = `${n} months`;

      const growthStr = growth.toFixed(4);
      if (expGrowth) expGrowth.textContent = `(1 + ${r.toFixed(6)})^${n} ≈ ${growthStr}`;
      if (expSubP) expSubP.textContent = Math.round(P).toLocaleString(cfg.locale);
      if (expSubR) expSubR.textContent = r.toFixed(6);
      if (expSubGrowth1) expSubGrowth1.textContent = growthStr;
      if (expSubGrowth2) expSubGrowth2.textContent = growthStr;
      if (expMonthlyVal) expMonthlyVal.textContent = `${formatPreciseMoney(emi)} / month`;

      if (expTotFormula) expTotFormula.textContent = `${formatPreciseMoney(emi)} × ${n}`;
      if (expTotPayable) expTotPayable.textContent = formatPreciseMoney(totalPayable);
      if (expIntFormula) expIntFormula.textContent = `${formatPreciseMoney(totalPayable)} − ${formatMoney(P)}`;
      if (expTotInterest) expTotInterest.textContent = formatPreciseMoney(totalInterest);
    }

    // Initialize currency selects
    const selects = document.querySelectorAll('.ack-currency-select');
    selects.forEach(sel => {
      sel.value = getCurrency();
      sel.addEventListener('change', (e) => {
        const val = e.target.value;
        localStorage.setItem('ack_currency', val);
        window.dispatchEvent(new CustomEvent('ack_currency_change', { detail: val }));
      });
    });

    window.addEventListener('ack_currency_change', (e) => {
      selects.forEach(sel => sel.value = e.detail);
      updateSliderForCurrency();
      calculateEMI();
    });

    amountInput.addEventListener('input', calculateEMI);
    rateInput.addEventListener('input', calculateEMI);
    tenureInput.addEventListener('input', calculateEMI);

    updateSliderForCurrency();
    calculateEMI();
  })();
</script>
