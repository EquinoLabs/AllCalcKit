    const scenBResetBtn = document.getElementById('scenario-b-reset');

    // Comparison Summary Elements
    const recBanner = document.getElementById('comparison-recommendation-banner');
    const recIcon = document.getElementById('comparison-recommendation-icon');
    const recTitle = document.getElementById('comparison-recommendation-title');
    const recDetail = document.getElementById('comparison-recommendation-detail');
