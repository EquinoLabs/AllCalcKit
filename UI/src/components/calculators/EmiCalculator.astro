---
import ShareResult from '../ShareResult.astro';
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4 flex-wrap sm:flex-nowrap">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-black dark:bg-purple-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">Loan & EMI Calculator</h3>
    </div>
    
    <div class="flex items-center gap-2 shrink-0 flex-wrap sm:flex-nowrap">
      <!-- Compare Loans Toggle Button -->
      <button
        type="button"
        id="emi-compare-toggle"
        role="switch"
        aria-checked="false"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl border border-neutral-300 dark:border-neutral-700 bg-neutral-100 hover:bg-neutral-200 dark:bg-neutral-800 dark:hover:bg-neutral-700/80 text-black dark:text-white text-xs font-semibold font-mono cursor-pointer transition-all focus:outline-hidden"
      >
        <svg class="w-3.5 h-3.5 text-neutral-500 dark:text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <span>Compare Loans</span>
        <span id="compare-toggle-badge" class="hidden px-1.5 py-0.2 rounded-full text-[10px] bg-purple-600 text-white font-bold">ON</span>
      </button>

      <!-- Currency & Locale Selector Pill -->
      <div class="flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800 px-2 py-1 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs shrink-0">
        <span class="text-[10px] text-neutral-600 dark:text-neutral-400 font-semibold hidden sm:inline">Unit:</span>
        <select aria-label="Select currency unit" class="ack-currency-select bg-transparent text-black dark:text-white font-bold outline-none cursor-pointer text-xs">
          <option value="USD">USD ($)</option>
          <option value="INR">INR (₹)</option>
          <option value="EUR">EUR (€)</option>
          <option value="GBP">GBP (£)</option>
        </select>
      </div>
    </div>
  </div>

  <!-- SINGLE CALCULATOR VIEW (Default) -->
  <div id="emi-single-view" class="space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Controls -->
      <div class="space-y-4">
        <!-- Loan Amount -->
        <div>
          <div class="flex justify-between items-center mb-1 text-xs font-semibold">
            <label for="emi-amount" class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Loan Amount</label>
            <span id="emi-amount-val" class="font-mono font-bold text-black dark:text-white">100,000</span>
          </div>
          <input id="emi-amount" type="range" min="10000" max="1000000" step="5000" value="100000" class="w-full h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-black dark:accent-purple-600" />
          <div class="flex justify-between text-[10px] font-mono text-neutral-400 mt-1">
            <span id="emi-min-hint">Min: $10,000</span>
            <span id="emi-max-hint">Max: $1,000,000</span>
          </div>
        </div>

        <!-- Interest Rate -->
        <div>
          <div class="flex justify-between items-center mb-1 text-xs font-semibold">
            <label for="emi-rate" class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Interest Rate (% p.a.)</label>
            <span id="emi-rate-val" class="font-mono font-bold text-black dark:text-white">8.5%</span>
          </div>
          <input id="emi-rate" type="range" min="1" max="25" step="0.1" value="8.5" class="w-full h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-black dark:accent-purple-600" />
        </div>

        <!-- Tenure -->
        <div>
          <div class="flex justify-between items-center mb-1 text-xs font-semibold">
            <label for="emi-tenure" class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Loan Tenure (Years)</label>
            <span id="emi-tenure-val" class="font-mono font-bold text-black dark:text-white">5 Years</span>
          </div>
          <input id="emi-tenure" type="range" min="1" max="30" step="1" value="5" class="w-full h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-black dark:accent-purple-600" />
        </div>
      </div>

      <!-- Output Card & Visual Breakdown -->
      <div class="bg-neutral-50 dark:bg-neutral-950 rounded-2xl p-5 sm:p-6 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between space-y-4">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold">Monthly Repayment (EMI)</div>
            <div id="emi-single-share-slot">
              <ShareResult id="emi-share-btn" calculatorTitle="Loan & EMI" />
            </div>
          </div>
          <div id="emi-monthly-result" class="text-3xl sm:text-4xl font-black text-black dark:text-purple-400 tabular-nums">
            $0
          </div>
        </div>

        <!-- Breakdown Table -->
        <div class="grid grid-cols-2 gap-4 py-4 border-y border-neutral-200 dark:border-neutral-800 text-xs font-mono">
          <div>
            <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Total Interest</span>
            <span id="emi-total-interest" class="font-bold text-black dark:text-white tabular-nums text-sm sm:text-base">$0</span>
          </div>
          <div>
            <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Total Payable</span>
            <span id="emi-total-payable" class="font-bold text-black dark:text-white tabular-nums text-sm sm:text-base">$0</span>
          </div>
        </div>

        <!-- Visual Percentage Bar -->
        <div>
          <div class="flex justify-between text-[11px] font-mono text-neutral-700 dark:text-neutral-400 mb-1 font-bold">
            <span>Principal (<span id="principal-pct">70%</span>)</span>
            <span>Interest (<span id="interest-pct">30%</span>)</span>
          </div>
          <div class="w-full h-3 rounded-full bg-neutral-200 dark:bg-neutral-800 overflow-hidden flex">
            <div id="principal-bar" class="h-full bg-black dark:bg-purple-600 transition-all duration-300" style="width: 70%"></div>
            <div id="interest-bar" class="h-full bg-neutral-400 dark:bg-purple-400/40 transition-all duration-300" style="width: 30%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Live Explain Calculation Walkthrough -->
    <details id="emi-explain-details" class="group bg-neutral-50/70 dark:bg-neutral-950/60 border border-neutral-200 dark:border-neutral-800 rounded-2xl p-4 sm:p-5 transition-all [&_[data-icon]]:open:rotate-180 shadow-xs">
      <summary class="flex items-center justify-between gap-4 font-bold text-xs sm:text-sm text-neutral-800 dark:text-neutral-200 cursor-pointer select-none">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-lg bg-purple-500/10 dark:bg-purple-400/10 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0 border border-purple-500/20">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </span>
          <div>
            <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400 block sm:inline-block sm:mr-2">Explain Calculation</span>
            <span class="font-bold text-neutral-900 dark:text-neutral-100">Live Mathematical Working</span>
          </div>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 group-open:hidden">Show Steps</span>
          <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 hidden group-open:inline">Hide Steps</span>
          <svg data-icon class="w-4 h-4 text-neutral-400 shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </summary>

      <div class="mt-4 pt-4 border-t border-neutral-200/70 dark:border-neutral-800/80 space-y-4 text-xs font-mono">
        <!-- Formula -->
        <div class="space-y-1.5">
          <div class="text-[10px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-bold">Standard Amortization Formula</div>
          <div class="p-2.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-neutral-900 dark:text-purple-300 font-bold overflow-x-auto text-xs sm:text-sm">
            EMI = [P × r × (1 + r)ⁿ] ÷ [(1 + r)ⁿ − 1]
          </div>
        </div>

        <!-- Live Calculation Working -->
        <div id="emi-explain-body" class="space-y-3">
          <!-- Step 1: Inputs & Monthly Rate -->
          <div class="p-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 space-y-1">
            <div class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100">Step 1 — Rate & Periods Conversion</div>
            <div class="text-neutral-600 dark:text-neutral-400 space-y-0.5 pt-0.5">
              <div>Principal (P) = <span id="exp-emi-p" class="font-bold text-black dark:text-white">$100,000</span></div>
              <div>Monthly Rate (r) = <span id="exp-emi-rate-formula">8.5% ÷ 12 ÷ 100</span> = <span id="exp-emi-r" class="font-bold text-black dark:text-white">0.00708333</span></div>
              <div>Total Payments (n) = <span id="exp-emi-tenure-formula">5 × 12</span> = <span id="exp-emi-n" class="font-bold text-black dark:text-white">60 months</span></div>
            </div>
          </div>

          <!-- Step 2: Substitution & EMI -->
          <div class="p-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 space-y-1">
            <div class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100">Step 2 — Monthly Installment (EMI)</div>
            <div class="text-neutral-600 dark:text-neutral-400 space-y-1 pt-0.5">
              <div>Growth Multiplier (1 + r)ⁿ = <span id="exp-emi-growth" class="font-bold text-black dark:text-white">(1.00708333)⁶⁰ ≈ 1.5273</span></div>
              <div class="p-2 rounded-lg bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 text-neutral-800 dark:text-neutral-200 overflow-x-auto text-[11px]">
                EMI = [<span id="exp-emi-sub-p">100,000</span> × <span id="exp-emi-sub-r">0.00708333</span> × <span id="exp-emi-sub-growth1">1.5273</span>] ÷ [<span id="exp-emi-sub-growth2">1.5273</span> − 1]
              </div>
              <div class="font-bold text-purple-600 dark:text-purple-400 text-sm">
                = <span id="exp-emi-monthly-val">$2,051.65 / month</span>
              </div>
            </div>
          </div>

          <!-- Step 3: Total Interest & Repayment -->
          <div class="p-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 space-y-1">
            <div class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100">Step 3 — Total Cost Breakdown</div>
            <div class="text-neutral-600 dark:text-neutral-400 space-y-0.5 pt-0.5">
              <div>Total Repayment = <span id="exp-emi-tot-formula">$2,051.65 × 60</span> = <span id="exp-emi-tot-payable" class="font-bold text-black dark:text-white">$123,099.16</span></div>
              <div>Total Interest = <span id="exp-emi-int-formula">$123,099.16 − $100,000</span> = <span id="exp-emi-tot-interest" class="font-bold text-black dark:text-white">$23,099.16</span></div>
            </div>
          </div>
        </div>
      </div>
    </details>
  </div>

  <!-- COMPARISON MODE VIEW (When Compare Loans is Enabled) -->
  <div id="emi-compare-view" class="hidden space-y-6">
    <!-- Two Scenarios: Side-by-Side on Desktop, Stacked on Mobile -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- Scenario A Card -->
      <div id="scenario-a-card" class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-950/40 p-4 sm:p-5 space-y-5 flex flex-col justify-between">
        <div class="space-y-4">
          <!-- Scenario A Header -->
          <div class="flex items-center justify-between border-b border-neutral-200 dark:border-neutral-800 pb-3 gap-2">
            <div class="flex items-center gap-2 flex-wrap sm:flex-nowrap">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 tracking-wide">Scenario A</span>
              <span class="text-neutral-400 dark:text-neutral-600 font-mono text-xs hidden sm:inline">—</span>
              <span class="text-xs text-neutral-600 dark:text-neutral-300 font-semibold font-mono">Loan Offer 1</span>
            </div>
            <button
              type="button"
              id="scenario-a-reset"
              title="Reset Scenario A to defaults"
              class="text-[11px] font-mono text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white flex items-center gap-1 px-2.5 py-1 rounded-lg border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 cursor-pointer transition-colors shrink-0"
            >
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              <span>Reset</span>
            </button>
          </div>

          <!-- Scenario A Controls -->
          <div class="space-y-3.5">
            <!-- Loan Amount -->
            <div>
              <div class="flex justify-between items-center mb-1 text-xs font-semibold">
                <label for="scenario-a-amount" class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Loan Amount</label>
                <span id="scenario-a-amount-val" class="font-mono font-bold text-black dark:text-white">100,000</span>
              </div>
              <input id="scenario-a-amount" type="range" min="10000" max="1000000" step="5000" value="100000" class="w-full h-2 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-black dark:accent-white" />
              <div class="flex justify-between text-[10px] font-mono text-neutral-400 mt-0.5">
                <span id="scenario-a-min-hint">Min: $10,000</span>
                <span id="scenario-a-max-hint">Max: $1,000,000</span>
              </div>
            </div>

            <!-- Interest Rate -->
            <div>
              <div class="flex justify-between items-center mb-1 text-xs font-semibold">
                <label for="scenario-a-rate" class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Interest Rate (% p.a.)</label>
                <span id="scenario-a-rate-val" class="font-mono font-bold text-black dark:text-white">8.5%</span>
              </div>
              <input id="scenario-a-rate" type="range" min="1" max="25" step="0.1" value="8.5" class="w-full h-2 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-black dark:accent-white" />
            </div>

            <!-- Tenure -->
            <div>
              <div class="flex justify-between items-center mb-1 text-xs font-semibold">
                <label for="scenario-a-tenure" class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Loan Tenure (Years)</label>
                <span id="scenario-a-tenure-val" class="font-mono font-bold text-black dark:text-white">5 Years</span>
              </div>
              <input id="scenario-a-tenure" type="range" min="1" max="30" step="1" value="5" class="w-full h-2 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-black dark:accent-white" />
            </div>
          </div>
        </div>

        <!-- Scenario A Results Box -->
        <div class="bg-white dark:bg-neutral-900 rounded-xl p-4 border border-neutral-200 dark:border-neutral-800 space-y-3">
          <div>
            <div class="text-[11px] font-mono text-neutral-500 uppercase tracking-wider font-semibold">Monthly EMI</div>
            <div id="scenario-a-monthly" class="text-2xl sm:text-3xl font-black text-black dark:text-white tabular-nums">$0</div>
          </div>
          <div class="grid grid-cols-2 gap-2 pt-2 border-t border-neutral-100 dark:border-neutral-800 text-xs font-mono">
            <div>
              <span class="text-neutral-500 text-[10px] block font-semibold">Total Interest</span>
              <span id="scenario-a-interest" class="font-bold text-neutral-800 dark:text-neutral-200 tabular-nums">$0</span>
            </div>
            <div>
              <span class="text-neutral-500 text-[10px] block font-semibold">Total Repayment</span>
              <span id="scenario-a-payable" class="font-bold text-neutral-800 dark:text-neutral-200 tabular-nums">$0</span>
            </div>
          </div>
          <div class="w-full h-1.5 rounded-full bg-neutral-200 dark:bg-neutral-800 overflow-hidden flex">
            <div id="scenario-a-principal-bar" class="h-full bg-black dark:bg-neutral-200 transition-all duration-300" style="width: 70%"></div>
            <div id="scenario-a-interest-bar" class="h-full bg-neutral-400 dark:bg-neutral-600 transition-all duration-300" style="width: 30%"></div>
          </div>
        </div>
      </div>

      <!-- Scenario B Card -->
      <div id="scenario-b-card" class="rounded-2xl border border-purple-200 dark:border-purple-900/60 bg-purple-50/30 dark:bg-purple-950/20 p-4 sm:p-5 space-y-5 flex flex-col justify-between">
        <div class="space-y-4">
          <!-- Scenario B Header -->
          <div class="flex items-center justify-between border-b border-purple-100 dark:border-purple-900/50 pb-3 flex-wrap gap-2">
            <div class="flex items-center gap-2 flex-wrap sm:flex-nowrap">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-purple-600 text-white tracking-wide">Scenario B</span>
              <span class="text-purple-300 dark:text-purple-700 font-mono text-xs hidden sm:inline">—</span>
              <span class="text-xs text-purple-900 dark:text-purple-200 font-semibold font-mono">Loan Offer 2</span>
            </div>
            <div class="flex items-center gap-1.5">
              <button
                type="button"
                id="scenario-b-copy"
                title="Duplicate all inputs from Scenario A"
                class="text-[11px] font-mono text-purple-700 hover:text-purple-900 dark:text-purple-300 dark:hover:text-purple-100 flex items-center gap-1 px-2.5 py-1 rounded-lg border border-purple-200 dark:border-purple-800 bg-white dark:bg-neutral-900 cursor-pointer transition-colors"
              >
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span id="scenario-b-copy-text">Copy Scenario A</span>
              </button>
              <button
                type="button"
                id="scenario-b-reset"
                title="Reset Scenario B to defaults"
                class="text-[11px] font-mono text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white flex items-center gap-1 px-2.5 py-1 rounded-lg border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 cursor-pointer transition-colors"
              >
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span>Reset</span>
              </button>
            </div>
          </div>

          <!-- Scenario B Controls -->
          <div class="space-y-3.5">
            <!-- Loan Amount -->
            <div>
              <div class="flex justify-between items-center mb-1 text-xs font-semibold">
                <label for="scenario-b-amount" class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Loan Amount</label>
                <span id="scenario-b-amount-val" class="font-mono font-bold text-black dark:text-white">100,000</span>
              </div>
              <input id="scenario-b-amount" type="range" min="10000" max="1000000" step="5000" value="100000" class="w-full h-2 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-purple-600" />
              <div class="flex justify-between text-[10px] font-mono text-neutral-400 mt-0.5">
                <span id="scenario-b-min-hint">Min: $10,000</span>
                <span id="scenario-b-max-hint">Max: $1,000,000</span>
              </div>
            </div>

            <!-- Interest Rate -->
            <div>
              <div class="flex justify-between items-center mb-1 text-xs font-semibold">
                <label for="scenario-b-rate" class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Interest Rate (% p.a.)</label>
                <span id="scenario-b-rate-val" class="font-mono font-bold text-black dark:text-white">8.0%</span>
              </div>
              <input id="scenario-b-rate" type="range" min="1" max="25" step="0.1" value="8.0" class="w-full h-2 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-purple-600" />
            </div>

            <!-- Tenure -->
            <div>
              <div class="flex justify-between items-center mb-1 text-xs font-semibold">
                <label for="scenario-b-tenure" class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Loan Tenure (Years)</label>
                <span id="scenario-b-tenure-val" class="font-mono font-bold text-black dark:text-white">5 Years</span>
              </div>
              <input id="scenario-b-tenure" type="range" min="1" max="30" step="1" value="5" class="w-full h-2 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-purple-600" />
            </div>
          </div>
        </div>

        <!-- Scenario B Results Box -->
