---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-black dark:bg-purple-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">Loan & EMI Calculator</h3>
    </div>
    
    <!-- Currency & Locale Selector Pill -->
    <div class="flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800 px-2 py-1 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs shrink-0">
      <span class="text-[10px] text-neutral-500 dark:text-neutral-400 font-semibold hidden sm:inline">Unit:</span>
      <select class="ack-currency-select bg-transparent text-black dark:text-white font-bold outline-none cursor-pointer text-xs">
        <option value="USD">USD ($)</option>
        <option value="INR">INR (₹)</option>
        <option value="EUR">EUR (€)</option>
        <option value="GBP">GBP (£)</option>
      </select>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Controls -->
    <div class="space-y-4">
      <!-- Loan Amount -->
      <div>
        <div class="flex justify-between items-center mb-1 text-xs font-semibold">
          <label class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Loan Amount</label>
          <span id="emi-amount-val" class="font-mono font-bold text-black dark:text-white">100,000</span>
        </div>
        <input id="emi-amount" type="range" min="10000" max="1000000" step="5000" value="100000" class="w-full h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-black dark:accent-purple-600" />
      </div>

      <!-- Interest Rate -->
      <div>
        <div class="flex justify-between items-center mb-1 text-xs font-semibold">
          <label class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Interest Rate (% p.a.)</label>
          <span id="emi-rate-val" class="font-mono font-bold text-black dark:text-white">8.5%</span>
        </div>
        <input id="emi-rate" type="range" min="1" max="25" step="0.1" value="8.5" class="w-full h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-black dark:accent-purple-600" />
      </div>

      <!-- Tenure -->
      <div>
        <div class="flex justify-between items-center mb-1 text-xs font-semibold">
          <label class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Loan Tenure (Years)</label>
          <span id="emi-tenure-val" class="font-mono font-bold text-black dark:text-white">5 Years</span>
        </div>
        <input id="emi-tenure" type="range" min="1" max="30" step="1" value="5" class="w-full h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-black dark:accent-purple-600" />
      </div>
    </div>

    <!-- Output Card & Visual Breakdown -->
    <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-5 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between">
      <div>
        <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold mb-1">Monthly Repayment (EMI)</div>
        <div id="emi-monthly-result" class="text-3xl sm:text-4xl font-black text-black dark:text-purple-400 tabular-nums">
          $0
        </div>
      </div>

      <!-- Breakdown Table -->
      <div class="grid grid-cols-2 gap-4 py-4 border-y border-neutral-200 dark:border-neutral-800 my-4 text-xs font-mono">
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Total Interest</span>
          <span id="emi-total-interest" class="font-bold text-black dark:text-white tabular-nums">$0</span>
        </div>
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Total Payable</span>
          <span id="emi-total-payable" class="font-bold text-black dark:text-white tabular-nums">$0</span>
        </div>
      </div>

      <!-- Visual Percentage Bar -->
      <div>
        <div class="flex justify-between text-[11px] font-mono text-neutral-700 dark:text-neutral-400 mb-1 font-bold">
          <span>Principal (<span id="principal-pct">70%</span>)</span>
          <span>Interest (<span id="interest-pct">30%</span>)</span>
        </div>
        <div class="w-full h-3 rounded-full bg-neutral-200 dark:bg-neutral-800 overflow-hidden flex">
          <div id="principal-bar" class="h-full bg-black dark:bg-purple-600 transition-all duration-300" style="width: 70%"></div>
          <div id="interest-bar" class="h-full bg-neutral-400 dark:bg-purple-400/40 transition-all duration-300" style="width: 30%"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const amountInput = document.getElementById('emi-amount');
    const rateInput = document.getElementById('emi-rate');
    const tenureInput = document.getElementById('emi-tenure');

    const amountVal = document.getElementById('emi-amount-val');
    const rateVal = document.getElementById('emi-rate-val');
    const tenureVal = document.getElementById('emi-tenure-val');

    const monthlyResult = document.getElementById('emi-monthly-result');
    const totalInterestEl = document.getElementById('emi-total-interest');
    const totalPayableEl = document.getElementById('emi-total-payable');

    const principalPctEl = document.getElementById('principal-pct');
    const interestPctEl = document.getElementById('interest-pct');
    const principalBar = document.getElementById('principal-bar');
    const interestBar = document.getElementById('interest-bar');

    const CURRENCY_CONFIGS = {
      USD: { symbol: '$', locale: 'en-US' },
      INR: { symbol: '₹', locale: 'en-IN' },
      EUR: { symbol: '€', locale: 'en-IE' },
      GBP: { symbol: '£', locale: 'en-GB' }
    };

    function getCurrency() {
      return localStorage.getItem('ack_currency') || 'USD';
    }

    function formatMoney(num) {
      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;
      const formatted = Math.round(num).toLocaleString(cfg.locale);
      return `${cfg.symbol}${formatted}`;
    }

    function calculateEMI() {
      if (!amountInput || !rateInput || !tenureInput) return;

      const P = parseFloat(amountInput.value);
      const annualRate = parseFloat(rateInput.value);
      const years = parseFloat(tenureInput.value);

      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;

      if (amountVal) amountVal.textContent = Math.round(P).toLocaleString(cfg.locale);
      if (rateVal) rateVal.textContent = annualRate.toFixed(1) + '%';
      if (tenureVal) tenureVal.textContent = years + (years === 1 ? ' Year' : ' Years');

      const r = annualRate / 12 / 100;
      const n = years * 12;

      const emi = (P * r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
      const totalPayable = emi * n;
      const totalInterest = totalPayable - P;

      if (monthlyResult) monthlyResult.textContent = formatMoney(emi);
      if (totalInterestEl) totalInterestEl.textContent = formatMoney(totalInterest);
      if (totalPayableEl) totalPayableEl.textContent = formatMoney(totalPayable);

      const pPct = Math.round((P / totalPayable) * 100);
      const iPct = 100 - pPct;

      if (principalPctEl) principalPctEl.textContent = pPct + '%';
      if (interestPctEl) interestPctEl.textContent = iPct + '%';
      if (principalBar) principalBar.style.width = pPct + '%';
      if (interestBar) interestBar.style.width = iPct + '%';
    }

    // Initialize currency selects
    const selects = document.querySelectorAll('.ack-currency-select');
    selects.forEach(sel => {
      sel.value = getCurrency();
      sel.addEventListener('change', (e) => {
        const val = e.target.value;
        localStorage.setItem('ack_currency', val);
        window.dispatchEvent(new CustomEvent('ack_currency_change', { detail: val }));
      });
    });

    window.addEventListener('ack_currency_change', (e) => {
      selects.forEach(sel => sel.value = e.detail);
      calculateEMI();
    });

    amountInput.addEventListener('input', calculateEMI);
    rateInput.addEventListener('input', calculateEMI);
    tenureInput.addEventListener('input', calculateEMI);

    calculateEMI();
  })();
</script>
