    // Scenario B Elements
    const scenBAmountInp = document.getElementById('scenario-b-amount') as HTMLInputElement | null;
    const scenBRateInp = document.getElementById('scenario-b-rate') as HTMLInputElement | null;
    const scenBTenureInp = document.getElementById('scenario-b-tenure') as HTMLInputElement | null;
    const scenBAmountVal = document.getElementById('scenario-b-amount-val');
    const scenBRateVal = document.getElementById('scenario-b-rate-val');
    const scenBTenureVal = document.getElementById('scenario-b-tenure-val');
    const scenBMinHint = document.getElementById('scenario-b-min-hint');
    const scenBMaxHint = document.getElementById('scenario-b-max-hint');
    const scenBMonthly = document.getElementById('scenario-b-monthly');
    const scenBInterest = document.getElementById('scenario-b-interest');
    const scenBPayable = document.getElementById('scenario-b-payable');
