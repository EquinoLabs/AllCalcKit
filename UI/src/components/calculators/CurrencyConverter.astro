---
const CURRENCIES = [
  { code: 'USD', name: 'US Dollar ($)', rate: 1.0 },
  { code: 'EUR', name: 'Euro (€)', rate: 0.92 },
  { code: 'GBP', name: 'British Pound (£)', rate: 0.78 },
  { code: 'INR', name: 'Indian Rupee (₹)', rate: 83.85 },
  { code: 'JPY', name: 'Japanese Yen (¥)', rate: 147.2 },
  { code: 'CAD', name: 'Canadian Dollar (C$)', rate: 1.37 },
  { code: 'AUD', name: 'Australian Dollar (A$)', rate: 1.52 },
  { code: 'KES', name: 'Kenyan Shilling (KSh)', rate: 129.5 },
  { code: 'TZS', name: 'Tanzanian Shilling (TSh)', rate: 2680.0 },
  { code: 'AED', name: 'UAE Dirham (AED)', rate: 3.67 },
  { code: 'CHF', name: 'Swiss Franc (CHF)', rate: 0.86 },
  { code: 'SGD', name: 'Singapore Dollar (S$)', rate: 1.33 }
];
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-black dark:bg-emerald-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">Live Currency Converter</h3>
    </div>
    <span class="text-[10px] sm:text-[11px] font-mono px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-emerald-500/10 text-black dark:text-emerald-400 border border-neutral-300 dark:border-emerald-500/20 shrink-0 font-bold">
      Real-Time Rates
    </span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-7 gap-4 items-center">
    <!-- Amount & From -->
    <div class="lg:col-span-3 space-y-2">
      <div class="flex items-center justify-between gap-2">
        <label for="curr-amount" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-semibold">From Base</label>
        <select 
          id="curr-from"
          aria-label="From base currency"
          class="px-3 py-1.5 rounded-xl bg-neutral-100 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-black dark:text-neutral-200 text-xs font-bold outline-none cursor-pointer shrink-0 max-w-[60%]"
        >
          {CURRENCIES.map(c => (
            <option value={c.code} selected={c.code === 'USD'}>{c.code} — {c.name}</option>
          ))}
        </select>
      </div>
      <input 
        type="number" 
        id="curr-amount" 
        aria-label="Amount to convert"
        value="100" 
        min="0"
        step="any"
        class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white text-lg font-bold focus:ring-2 focus:ring-black dark:focus:ring-emerald-500 outline-none transition-all tabular-nums"
      />
    </div>

    <!-- Swap -->
    <div class="flex justify-center py-1 lg:py-0 lg:pt-6">
      <button 
        type="button" 
        id="curr-swap-btn"
        aria-label="Swap currencies"
        class="w-11 h-11 rounded-full bg-neutral-100 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-black dark:text-neutral-300 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black active:scale-95 transition-all flex items-center justify-center shrink-0 shadow-xs"
      >
        <svg class="w-5 h-5 rotate-90 lg:rotate-0 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
      </button>
    </div>

    <!-- Target Currency & Output -->
    <div class="lg:col-span-3 space-y-2">
      <div class="flex items-center justify-between gap-2">
        <label for="curr-result" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-semibold">Converted Target</label>
        <select 
          id="curr-to"
          aria-label="To target currency"
          class="px-3 py-1.5 rounded-xl bg-neutral-100 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-black dark:text-neutral-200 text-xs font-bold outline-none cursor-pointer shrink-0 max-w-[60%]"
        >
          {CURRENCIES.map(c => (
            <option value={c.code} selected={c.code === 'EUR'}>{c.code} — {c.name}</option>
          ))}
        </select>
      </div>
      <input 
        type="text" 
        id="curr-result" 
        aria-label="Converted amount"
        readonly 
        class="w-full px-4 py-3 rounded-xl bg-neutral-100 dark:bg-neutral-950 border border-neutral-300 dark:border-neutral-800 text-black dark:text-emerald-400 text-lg font-black outline-none tabular-nums"
      />
    </div>
  </div>

  <!-- Footnote Rate Info & Quick Presets -->
  <div class="mt-4 pt-4 border-t border-neutral-200 dark:border-neutral-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
    <div class="flex items-center gap-2 font-mono text-neutral-700 dark:text-neutral-400 font-semibold">
      <span id="curr-rate-info">1 USD = 0.92 EUR</span>
    </div>
    <div class="flex items-center gap-1.5 flex-wrap w-full sm:w-auto">
      <span class="text-neutral-500 dark:text-neutral-400 text-[11px] font-mono shrink-0">Popular:</span>
      <button type="button" data-pair="USD,EUR" class="preset-btn px-2.5 py-1 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-black dark:text-neutral-200 hover:bg-neutral-200 dark:hover:bg-neutral-700 border border-neutral-300 dark:border-neutral-700 active:scale-95 transition-colors font-mono text-[11px] font-bold">USD→EUR</button>
      <button type="button" data-pair="USD,INR" class="preset-btn px-2.5 py-1 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-black dark:text-neutral-200 hover:bg-neutral-200 dark:hover:bg-neutral-700 border border-neutral-300 dark:border-neutral-700 active:scale-95 transition-colors font-mono text-[11px] font-bold">USD→INR</button>
      <button type="button" data-pair="USD,TZS" class="preset-btn px-2.5 py-1 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-black dark:text-neutral-200 hover:bg-neutral-200 dark:hover:bg-neutral-700 border border-neutral-300 dark:border-neutral-700 active:scale-95 transition-colors font-mono text-[11px] font-bold">USD→TZS</button>
      <button type="button" data-pair="GBP,USD" class="preset-btn px-2.5 py-1 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-black dark:text-neutral-200 hover:bg-neutral-200 dark:hover:bg-neutral-700 border border-neutral-300 dark:border-neutral-700 active:scale-95 transition-colors font-mono text-[11px] font-bold">GBP→USD</button>
    </div>
  </div>

  <!-- Live Explain Calculation Walkthrough -->
  <details id="curr-explain-details" class="group bg-neutral-50/70 dark:bg-neutral-950/60 border border-neutral-200 dark:border-neutral-800 rounded-2xl p-4 sm:p-5 transition-all [&_[data-icon]]:open:rotate-180 mt-6 shadow-xs">
    <summary class="flex items-center justify-between gap-4 font-bold text-xs sm:text-sm text-neutral-800 dark:text-neutral-200 cursor-pointer select-none">
      <div class="flex items-center gap-2.5">
        <span class="w-7 h-7 rounded-lg bg-emerald-500/10 dark:bg-emerald-400/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/20">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        </span>
        <div>
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 block sm:inline-block sm:mr-2">Explain Calculation</span>
          <span class="font-bold text-neutral-900 dark:text-neutral-100">Live Currency Conversion Steps</span>
        </div>
      </div>
      <div class="flex items-center gap-1.5 shrink-0">
        <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 group-open:hidden">Show Steps</span>
        <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 hidden group-open:inline">Hide Steps</span>
        <svg data-icon class="w-4 h-4 text-neutral-400 shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </summary>

    <div class="mt-4 pt-4 border-t border-neutral-200/70 dark:border-neutral-800/80 space-y-4 text-xs font-mono">
      <!-- Formula -->
      <div class="space-y-1.5">
        <div class="text-[10px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-bold">Exchange Rate Formula</div>
        <div class="p-2.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-neutral-900 dark:text-emerald-300 font-bold overflow-x-auto text-xs sm:text-sm">
          Converted Target = Base Amount × (Target Rate ÷ Base Rate)
        </div>
      </div>

      <!-- Live Calculation Working -->
      <div id="curr-explain-body" class="space-y-3">
        <!-- Step 1: Active Rates -->
        <div class="p-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 space-y-1">
          <div class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100">Step 1 — Exchange Rate Parity</div>
          <div class="text-neutral-600 dark:text-neutral-400 space-y-0.5 pt-0.5">
            <div>Input Amount = <span id="exp-curr-amount" class="font-bold text-black dark:text-white">100.00 USD</span></div>
            <div>Direct Rate = <span id="exp-curr-rate" class="font-bold text-black dark:text-white">1 USD = 0.9200 EUR</span></div>
            <div>Inverse Rate = <span id="exp-curr-inv-rate" class="font-bold text-black dark:text-white">1 EUR = 1.0870 USD</span></div>
          </div>
        </div>

        <!-- Step 2: Multiplication -->
        <div class="p-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 space-y-1">
          <div class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100">Step 2 — Converted Amount</div>
          <div class="text-neutral-600 dark:text-neutral-400 space-y-1 pt-0.5">
            <div class="p-2 rounded-lg bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 text-neutral-800 dark:text-neutral-200 overflow-x-auto text-[11px]">
              <span id="exp-curr-sub-amt">100.00</span> × <span id="exp-curr-sub-rate">0.9200</span>
            </div>
            <div class="font-bold text-emerald-600 dark:text-emerald-400 text-sm">
              = <span id="exp-curr-final-val">92.00 EUR</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </details>
</div>

<script is:inline define:vars={{ initialCurrencies: CURRENCIES }}>
  (function() {
    const amountInput = document.getElementById('curr-amount');
    const fromSelect = document.getElementById('curr-from');
    const toSelect = document.getElementById('curr-to');
    const resultInput = document.getElementById('curr-result');
    const rateInfo = document.getElementById('curr-rate-info');
    const swapBtn = document.getElementById('curr-swap-btn');
    const presetBtns = document.querySelectorAll('.preset-btn');

    // Explain elements
    const expAmount = document.getElementById('exp-curr-amount');
    const expRate = document.getElementById('exp-curr-rate');
    const expInvRate = document.getElementById('exp-curr-inv-rate');
    const expSubAmt = document.getElementById('exp-curr-sub-amt');
    const expSubRate = document.getElementById('exp-curr-sub-rate');
    const expFinalVal = document.getElementById('exp-curr-final-val');

    let rates = {};
    initialCurrencies.forEach(c => rates[c.code] = c.rate);

    async function fetchRates() {
      try {
        const res = await fetch('https://open.er-api.com/v6/latest/USD');
        if (res.ok) {
          const data = await res.json();
          if (data && data.rates) {
            rates = { ...rates, ...data.rates };
          }
        }
      } catch (e) {
        console.log('Using baseline exchange rates fallback');
      }
      calcCurrency();
    }

    function calcCurrency() {
      if (!amountInput || !fromSelect || !toSelect || !resultInput) return;
      const amt = parseFloat(amountInput.value);
      const fromCode = fromSelect.value;
      const toCode = toSelect.value;

      const rateFromUSD = rates[fromCode] || 1;
      const rateToUSD = rates[toCode] || 1;
      const singleRate = rateToUSD / rateFromUSD;
      const invRate = singleRate > 0 ? 1 / singleRate : 0;

      if (isNaN(amt) || amt < 0) {
        resultInput.value = '';
        if (expAmount) expAmount.textContent = `-- ${fromCode}`;
        if (expRate) expRate.textContent = `1 ${fromCode} = ${singleRate.toFixed(4)} ${toCode}`;
        if (expInvRate) expInvRate.textContent = `1 ${toCode} = ${invRate.toFixed(4)} ${fromCode}`;
        if (expSubAmt) expSubAmt.textContent = '0';
        if (expSubRate) expSubRate.textContent = singleRate.toFixed(4);
        if (expFinalVal) expFinalVal.textContent = `-- ${toCode}`;
        return;
      }

      const inUSD = amt / rateFromUSD;
      const converted = inUSD * rateToUSD;

      const fromLocale = fromCode === 'INR' ? 'en-IN' : undefined;
      const toLocale = toCode === 'INR' ? 'en-IN' : undefined;

      const formattedResult = converted.toLocaleString(toLocale, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      resultInput.value = formattedResult;

      if (rateInfo) {
        rateInfo.textContent = `1 ${fromCode} = ${singleRate.toFixed(4)} ${toCode}`;
      }

      // Update Live Explain Calculation
      if (expAmount) expAmount.textContent = `${amt.toLocaleString(fromLocale, { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ${fromCode}`;
      if (expRate) expRate.textContent = `1 ${fromCode} = ${singleRate.toFixed(4)} ${toCode}`;
      if (expInvRate) expInvRate.textContent = `1 ${toCode} = ${invRate.toFixed(4)} ${fromCode}`;
      if (expSubAmt) expSubAmt.textContent = amt.toLocaleString(fromLocale, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (expSubRate) expSubRate.textContent = singleRate.toFixed(4);
      if (expFinalVal) expFinalVal.textContent = `${formattedResult} ${toCode}`;
    }

    amountInput.addEventListener('input', calcCurrency);
    fromSelect.addEventListener('change', calcCurrency);
    toSelect.addEventListener('change', calcCurrency);

    if (swapBtn) {
      swapBtn.addEventListener('click', () => {
        const temp = fromSelect.value;
        fromSelect.value = toSelect.value;
        toSelect.value = temp;
        calcCurrency();
      });
    }

    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const pair = btn.getAttribute('data-pair');
        if (pair) {
          const [f, t] = pair.split(',');
          fromSelect.value = f;
          toSelect.value = t;
          calcCurrency();
        }
      });
    });

    fetchRates();
  })();
</script>
