---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-purple-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">Unix Epoch Timestamp Converter</h3>
    </div>
    <span class="text-[10px] sm:text-[11px] font-mono px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-700 dark:text-purple-400 border border-purple-500/20 shrink-0 font-bold">
      Epoch & UTC
    </span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="space-y-4 font-mono">
      <div>
        <div class="flex justify-between items-center mb-1">
          <label for="ts-input" class="text-xs text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-semibold">Unix Timestamp (Seconds / Milliseconds)</label>
          <button id="ts-now-btn" type="button" class="text-[11px] font-bold text-purple-600 dark:text-purple-400 underline hover:opacity-80">Use Current Now</button>
        </div>
        <input id="ts-input" type="number" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-purple-500 tabular-nums" />
      </div>

      <div>
        <label for="ts-datetime" class="block text-xs text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Date Time Input</label>
        <input id="ts-datetime" type="datetime-local" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-sm outline-none focus:ring-2 focus:ring-purple-500" />
      </div>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-5 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between font-mono">
      <div>
        <div class="text-xs text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold mb-1 font-semibold">Local Date Time</div>
        <div id="ts-local-val" class="text-base sm:text-lg font-bold text-purple-600 dark:text-purple-400 break-all">--</div>
      </div>

      <div class="py-4 border-y border-neutral-200 dark:border-neutral-800 my-4 text-xs">
        <span class="text-neutral-600 dark:text-neutral-400 block font-semibold mb-1">UTC Date String</span>
        <span id="ts-utc-val" class="font-bold text-black dark:text-white break-all">--</span>
      </div>

      <div class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Supports both 10-digit (seconds) and 13-digit (milliseconds) epoch formats.
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const input = document.getElementById('ts-input');
    const datetimeInp = document.getElementById('ts-datetime');
    const nowBtn = document.getElementById('ts-now-btn');

    const localEl = document.getElementById('ts-local-val');
    const utcEl = document.getElementById('ts-utc-val');

    function updateFromTimestamp(ts) {
      if (isNaN(ts)) return;
      let ms = ts;
      if (ts < 10000000000) ms = ts * 1000;

      const date = new Date(ms);
      if (isNaN(date.getTime())) return;

      if (localEl) localEl.textContent = date.toString();
      if (utcEl) utcEl.textContent = date.toUTCString();

      // Format ISO string for datetime-local
      const iso = new Date(date.getTime() - (date.getTimezoneOffset() * 60000)).toISOString().slice(0, 16);
      if (datetimeInp) datetimeInp.value = iso;
    }

    function updateFromDateTime() {
      const date = new Date(datetimeInp.value);
      if (isNaN(date.getTime())) return;
      const ts = Math.floor(date.getTime() / 1000);
      if (input) input.value = ts;
      if (localEl) localEl.textContent = date.toString();
      if (utcEl) utcEl.textContent = date.toUTCString();
    }

    if (nowBtn) {
      nowBtn.addEventListener('click', () => {
        const now = Math.floor(Date.now() / 1000);
        input.value = now;
        updateFromTimestamp(now);
      });
    }

    input.addEventListener('input', (e) => updateFromTimestamp(parseFloat(e.target.value)));
    datetimeInp.addEventListener('input', updateFromDateTime);

    const now = Math.floor(Date.now() / 1000);
    input.value = now;
    updateFromTimestamp(now);
  })();
</script>
