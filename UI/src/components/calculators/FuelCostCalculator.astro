---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">Fuel Trip Cost & Consumption Calculator</h3>
    </div>
    
    <!-- Currency Selector -->
    <div class="flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800 px-2 py-1 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs shrink-0">
      <select aria-label="Select currency unit" class="ack-currency-select bg-transparent text-black dark:text-white font-bold outline-none cursor-pointer text-xs">
        <option value="USD">USD ($)</option>
        <option value="INR">INR (₹)</option>
        <option value="EUR">EUR (€)</option>
        <option value="GBP">GBP (£)</option>
      </select>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="space-y-4">
      <div>
        <label for="fuel-dist" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Trip Distance (km / miles)</label>
        <input id="fuel-dist" type="number" value="250" min="1" step="10" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-emerald-500 tabular-nums" />
      </div>

      <div>
        <label for="fuel-eff" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Vehicle Mileage (km/L or MPG)</label>
        <input id="fuel-eff" type="number" value="15" min="1" step="0.5" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-emerald-500 tabular-nums" />
        <span id="fuel-eff-hint" class="text-[11px] font-mono text-neutral-500 mt-1 block">Car: ~15 km/L | Two-Wheeler: ~45 km/L</span>
      </div>

      <div>
        <label for="fuel-price" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Fuel Price per Liter / Gallon</label>
        <input id="fuel-price" type="number" value="98.00" min="0.1" step="0.5" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-emerald-500 tabular-nums" />
        <span id="fuel-price-hint" class="text-[11px] font-mono text-neutral-500 mt-1 block"></span>
      </div>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-5 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between">
      <div>
        <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold mb-1 font-semibold">Total Estimated Trip Cost</div>
        <div id="fuel-cost-val" class="text-3xl sm:text-4xl font-black text-emerald-600 dark:text-emerald-400 tabular-nums">$0</div>
      </div>

      <div class="grid grid-cols-2 gap-4 py-4 border-y border-neutral-200 dark:border-neutral-800 my-4 text-xs font-mono">
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Fuel Required</span>
          <span id="fuel-vol-val" class="font-bold text-black dark:text-white tabular-nums">0 Units</span>
        </div>
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Cost per Distance Unit</span>
          <span id="fuel-unit-cost" class="font-bold text-emerald-600 dark:text-emerald-400 tabular-nums">$0 / km</span>
        </div>
      </div>

      <div class="text-xs font-mono text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Calculates exact fuel volume & budget required for road trips and daily commutes.
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const distInp = document.getElementById('fuel-dist');
    const effInp = document.getElementById('fuel-eff');
    const priceInp = document.getElementById('fuel-price');
    const priceHint = document.getElementById('fuel-price-hint');

    const costEl = document.getElementById('fuel-cost-val');
    const volEl = document.getElementById('fuel-vol-val');
    const unitCostEl = document.getElementById('fuel-unit-cost');

    const CURRENCY_CONFIGS = {
      USD: { symbol: '$', locale: 'en-US' },
      INR: { symbol: '₹', locale: 'en-IN' },
      EUR: { symbol: '€', locale: 'en-IE' },
      GBP: { symbol: '£', locale: 'en-GB' }
    };

    function getCurrency() {
      return localStorage.getItem('ack_currency') || 'USD';
    }

    function formatMoney(num) {
      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;
      const formatted = num.toLocaleString(cfg.locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      return `${cfg.symbol}${formatted}`;
    }

    let lastCurrency = getCurrency();

    function updateInputsForCurrency() {
      const curr = getCurrency();
      if (!priceInp) return;

      if (curr === 'INR') {
        priceInp.step = '1';
        priceInp.min = '10';
        if (lastCurrency !== 'INR' || parseFloat(priceInp.value) < 10) {
          priceInp.value = '98.00';
        }
        if (priceHint) priceHint.textContent = 'Current petrol/diesel in India: ₹95 – ₹105 / Liter';
      } else {
        priceInp.step = '0.05';
        priceInp.min = '0.1';
        if (lastCurrency === 'INR' && parseFloat(priceInp.value) > 10) {
          priceInp.value = '1.50';
        }
        if (priceHint) priceHint.textContent = 'Typical fuel price: $1.20 – $4.50';
      }
      lastCurrency = curr;
    }

    function calcFuel() {
      if (!distInp || !effInp || !priceInp) return;
      const dist = parseFloat(distInp.value) || 0;
      const eff = parseFloat(effInp.value) || 1;
      const price = parseFloat(priceInp.value) || 0;

      const fuelNeeded = dist / eff;
      const totalCost = fuelNeeded * price;
      const costPerDist = totalCost / (dist || 1);

      if (costEl) costEl.textContent = formatMoney(totalCost);
      if (volEl) volEl.textContent = `${fuelNeeded.toFixed(1)} Units`;
      if (unitCostEl) unitCostEl.textContent = `${formatMoney(costPerDist)} / km`;
    }

    const selects = document.querySelectorAll('.ack-currency-select');
    selects.forEach(sel => {
      sel.value = getCurrency();
      sel.addEventListener('change', (e) => {
        const val = e.target.value;
        localStorage.setItem('ack_currency', val);
        window.dispatchEvent(new CustomEvent('ack_currency_change', { detail: val }));
      });
    });

    window.addEventListener('ack_currency_change', (e) => {
      selects.forEach(sel => sel.value = e.detail);
      updateInputsForCurrency();
      calcFuel();
    });

    [distInp, effInp, priceInp].forEach(el => el.addEventListener('input', calcFuel));
    updateInputsForCurrency();
    calcFuel();
  })();
</script>
