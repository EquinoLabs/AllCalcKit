---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-blue-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">Number Base System Converter</h3>
    </div>
    <span class="text-[10px] sm:text-[11px] font-mono px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-700 dark:text-blue-400 border border-blue-500/20 shrink-0 font-bold">
      Bin / Oct / Dec / Hex
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono">
    <div class="space-y-1.5">
      <label class="block text-xs text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-semibold">Decimal (Base 10)</label>
      <input id="base-dec" type="text" value="255" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-sm outline-none focus:ring-2 focus:ring-blue-500 tabular-nums" />
    </div>

    <div class="space-y-1.5">
      <label class="block text-xs text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-semibold">Binary (Base 2)</label>
      <input id="base-bin" type="text" value="11111111" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-sm outline-none focus:ring-2 focus:ring-blue-500 tabular-nums" />
    </div>

    <div class="space-y-1.5">
      <label class="block text-xs text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-semibold">Hexadecimal (Base 16)</label>
      <input id="base-hex" type="text" value="FF" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-sm outline-none focus:ring-2 focus:ring-blue-500 tabular-nums uppercase" />
    </div>

    <div class="space-y-1.5">
      <label class="block text-xs text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-semibold">Octal (Base 8)</label>
      <input id="base-oct" type="text" value="377" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-sm outline-none focus:ring-2 focus:ring-blue-500 tabular-nums" />
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const decInp = document.getElementById('base-dec');
    const binInp = document.getElementById('base-bin');
    const hexInp = document.getElementById('base-hex');
    const octInp = document.getElementById('base-oct');

    function updateFromDec(val) {
      const num = parseInt(val, 10);
      if (isNaN(num)) {
        binInp.value = '';
        hexInp.value = '';
        octInp.value = '';
        return;
      }
      binInp.value = num.toString(2);
      hexInp.value = num.toString(16).toUpperCase();
      octInp.value = num.toString(8);
    }

    decInp.addEventListener('input', (e) => updateFromDec(e.target.value));

    binInp.addEventListener('input', (e) => {
      const num = parseInt(e.target.value, 2);
      if (!isNaN(num)) {
        decInp.value = num.toString(10);
        hexInp.value = num.toString(16).toUpperCase();
        octInp.value = num.toString(8);
      }
    });

    hexInp.addEventListener('input', (e) => {
      const num = parseInt(e.target.value, 16);
      if (!isNaN(num)) {
        decInp.value = num.toString(10);
        binInp.value = num.toString(2);
        octInp.value = num.toString(8);
      }
    });

    octInp.addEventListener('input', (e) => {
      const num = parseInt(e.target.value, 8);
      if (!isNaN(num)) {
        decInp.value = num.toString(10);
        binInp.value = num.toString(2);
        hexInp.value = num.toString(16).toUpperCase();
      }
    });
  })();
</script>
