---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-rose-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">BMR (Basal Metabolic Rate) Calculator</h3>
    </div>
    <span class="text-[10px] sm:text-[11px] font-mono px-2 py-0.5 rounded-full bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-500/20 shrink-0 font-bold">
      Mifflin-St Jeor
    </span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="space-y-4">
      <div>
        <label class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Biological Sex</label>
        <div class="flex bg-neutral-100 dark:bg-neutral-800 p-1 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs">
          <button id="bmr-gender-m" type="button" class="flex-1 py-2 rounded-lg bg-white dark:bg-neutral-900 text-black dark:text-white font-bold shadow-xs">Male</button>
          <button id="bmr-gender-f" type="button" class="flex-1 py-2 rounded-lg text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors">Female</button>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-2">
        <div>
          <label for="bmr-age" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Age (yrs)</label>
          <input id="bmr-age" type="number" value="28" min="10" max="100" class="w-full px-3 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-rose-500 tabular-nums" />
        </div>
        <div>
          <label for="bmr-height" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Height (cm)</label>
          <input id="bmr-height" type="number" value="175" min="50" max="250" class="w-full px-3 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-rose-500 tabular-nums" />
        </div>
        <div>
          <label for="bmr-weight" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Weight (kg)</label>
          <input id="bmr-weight" type="number" value="70" min="20" max="300" class="w-full px-3 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-rose-500 tabular-nums" />
        </div>
      </div>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-5 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between">
      <div>
        <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold mb-1">Basal Metabolic Rate</div>
        <div id="bmr-result" class="text-3xl sm:text-4xl font-black text-rose-600 dark:text-rose-400 tabular-nums">0 <span class="text-base font-normal">kcal/day</span></div>
      </div>

      <div class="my-4 pt-4 border-t border-neutral-200 dark:border-neutral-800 text-xs font-mono text-neutral-600 dark:text-neutral-400 leading-relaxed">
        BMR is the minimum calories your body burns at complete rest to maintain vital functions (heartbeat, breathing, cell repair).
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    let gender = 'm';
    const ageInp = document.getElementById('bmr-age');
    const heightInp = document.getElementById('bmr-height');
    const weightInp = document.getElementById('bmr-weight');

    const btnM = document.getElementById('bmr-gender-m');
    const btnF = document.getElementById('bmr-gender-f');
    const resEl = document.getElementById('bmr-result');

    function calcBMR() {
      if (!ageInp || !heightInp || !weightInp) return;
      const age = parseFloat(ageInp.value) || 0;
      const h = parseFloat(heightInp.value) || 0;
      const w = parseFloat(weightInp.value) || 0;

      // Mifflin-St Jeor Formula
      let bmr = (10 * w) + (6.25 * h) - (5 * age);
      bmr += (gender === 'm' ? 5 : -161);

      if (resEl) resEl.innerHTML = `${Math.round(bmr).toLocaleString()} <span class="text-base font-normal">kcal/day</span>`;
    }

    if (btnM && btnF) {
      btnM.addEventListener('click', () => {
        gender = 'm';
        btnM.className = 'flex-1 py-2 rounded-lg bg-white dark:bg-neutral-900 text-black dark:text-white font-bold shadow-xs';
        btnF.className = 'flex-1 py-2 rounded-lg text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors';
        calcBMR();
      });
      btnF.addEventListener('click', () => {
        gender = 'f';
        btnF.className = 'flex-1 py-2 rounded-lg bg-white dark:bg-neutral-900 text-black dark:text-white font-bold shadow-xs';
        btnM.className = 'flex-1 py-2 rounded-lg text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors';
        calcBMR();
      });
    }

    [ageInp, heightInp, weightInp].forEach(el => el.addEventListener('input', calcBMR));
    calcBMR();
  })();
</script>
