---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-sm hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-rose-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-neutral-900 dark:text-white tracking-tight truncate">BMI & Weight Health Tracker</h3>
    </div>
    <!-- Unit System Toggle -->
    <div class="flex bg-neutral-100 dark:bg-neutral-800 p-1 rounded-xl border border-neutral-200 dark:border-neutral-700 text-[11px] sm:text-xs font-mono self-start sm:self-auto">
      <button id="bmi-unit-metric" type="button" class="px-2.5 py-1.5 rounded-lg bg-white dark:bg-neutral-900 text-black dark:text-white font-bold shadow-xs">Metric (cm/kg)</button>
      <button id="bmi-unit-imperial" type="button" class="px-2.5 py-1.5 rounded-lg text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors">Imperial (ft/lbs)</button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-center">
    <!-- Form Inputs -->
    <div class="space-y-4">
      <!-- Metric Fields -->
      <div id="bmi-metric-fields" class="space-y-4">
        <div>
          <label for="bmi-height-cm" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1">Height (cm)</label>
          <input id="bmi-height-cm" type="number" value="175" min="50" max="250" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-200 dark:border-neutral-700 text-neutral-900 dark:text-white text-base font-semibold focus:ring-2 focus:ring-rose-500 outline-none transition-all tabular-nums" />
        </div>
        <div>
          <label for="bmi-weight-kg" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1">Weight (kg)</label>
          <input id="bmi-weight-kg" type="number" value="70" min="20" max="300" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-200 dark:border-neutral-700 text-neutral-900 dark:text-white text-base font-semibold focus:ring-2 focus:ring-rose-500 outline-none transition-all tabular-nums" />
        </div>
      </div>

      <!-- Imperial Fields (hidden by default) -->
      <div id="bmi-imperial-fields" class="space-y-4 hidden">
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label for="bmi-height-ft" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1">Height (ft)</label>
            <input id="bmi-height-ft" type="number" value="5" min="2" max="8" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-200 dark:border-neutral-700 text-neutral-900 dark:text-white text-base font-semibold focus:ring-2 focus:ring-rose-500 outline-none transition-all tabular-nums" />
          </div>
          <div>
            <label for="bmi-height-in" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1">Height (in)</label>
            <input id="bmi-height-in" type="number" value="9" min="0" max="11" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-200 dark:border-neutral-700 text-neutral-900 dark:text-white text-base font-semibold focus:ring-2 focus:ring-rose-500 outline-none transition-all tabular-nums" />
          </div>
        </div>
        <div>
          <label for="bmi-weight-lbs" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1">Weight (lbs)</label>
          <input id="bmi-weight-lbs" type="number" value="154" min="40" max="600" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-200 dark:border-neutral-700 text-neutral-900 dark:text-white text-base font-semibold focus:ring-2 focus:ring-rose-500 outline-none transition-all tabular-nums" />
        </div>
      </div>
    </div>

    <!-- BMI Result Card -->
    <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-4 sm:p-5 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between h-full">
      <div>
        <div class="text-xs font-mono text-neutral-500 uppercase tracking-wider mb-1">Body Mass Index (BMI)</div>
        <div class="flex items-baseline gap-3 flex-wrap">
          <span id="bmi-score" class="text-3xl sm:text-4xl font-black text-rose-600 dark:text-rose-400 tabular-nums">22.9</span>
          <span id="bmi-badge" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">Normal Weight</span>
        </div>
      </div>

      <!-- SVG Radial Gauge Meter -->
      <div class="my-3 flex flex-col items-center">
        <div class="relative w-44 h-24 overflow-hidden flex items-center justify-center">
          <svg class="w-44 h-44 -mb-20 transform rotate-180" viewBox="0 0 100 100" aria-label="BMI Gauge Meter">
            <!-- Background Arc Track -->
            <circle cx="50" cy="50" r="38" class="stroke-neutral-200 dark:stroke-neutral-800" stroke-width="9" stroke-dasharray="119.38 238.76" fill="none" />
            <!-- Underweight Segment (25% of 180° = 29.85) -->
            <circle cx="50" cy="50" r="38" stroke="#38bdf8" stroke-width="9" stroke-dasharray="29.85 238.76" stroke-dashoffset="0" fill="none" class="opacity-90" />
            <!-- Normal Segment (25% = 29.85) -->
            <circle cx="50" cy="50" r="38" stroke="#10b981" stroke-width="9" stroke-dasharray="29.85 238.76" stroke-dashoffset="-29.85" fill="none" class="opacity-90" />
            <!-- Overweight Segment (25% = 29.85) -->
            <circle cx="50" cy="50" r="38" stroke="#f59e0b" stroke-width="9" stroke-dasharray="29.85 238.76" stroke-dashoffset="-59.70" fill="none" class="opacity-90" />
            <!-- Obese Segment (25% = 29.85) -->
            <circle cx="50" cy="50" r="38" stroke="#f43f5e" stroke-width="9" stroke-dasharray="29.85 238.76" stroke-dashoffset="-89.55" fill="none" class="opacity-90" />
          </svg>
          <!-- Animated Gauge Needle Pivot -->
          <div id="bmi-needle-container" class="absolute bottom-1 flex flex-col items-center justify-center transition-transform duration-500 ease-out origin-bottom" style="transform: rotate(0deg);">
            <div class="w-1 h-14 bg-black dark:bg-white rounded-full shadow-md"></div>
            <div class="w-3.5 h-3.5 rounded-full bg-black dark:bg-white -mt-1.5 shadow-md"></div>
          </div>
        </div>
        <div class="flex justify-between w-full max-w-[200px] text-[10px] font-mono text-neutral-400 mt-1">
          <span class="text-sky-500 font-bold">&lt;18.5</span>
          <span class="text-emerald-500 font-bold">18.5–25</span>
          <span class="text-amber-500 font-bold">25–30</span>
          <span class="text-rose-500 font-bold">&gt;30</span>
        </div>
      </div>

      <p id="bmi-advice" class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed font-mono">
        Your BMI is in the healthy range. Keep maintaining balanced nutrition and regular physical activity.
      </p>
    </div>
  </div>

  <!-- Live Explain Calculation Walkthrough -->
  <details id="bmi-explain-details" class="group bg-neutral-50/70 dark:bg-neutral-950/60 border border-neutral-200 dark:border-neutral-800 rounded-2xl p-4 sm:p-5 transition-all [&_[data-icon]]:open:rotate-180 mt-6 shadow-xs">
    <summary class="flex items-center justify-between gap-4 font-bold text-xs sm:text-sm text-neutral-800 dark:text-neutral-200 cursor-pointer select-none">
      <div class="flex items-center gap-2.5">
        <span class="w-7 h-7 rounded-lg bg-rose-500/10 dark:bg-rose-400/10 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0 border border-rose-500/20">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        </span>
        <div>
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400 block sm:inline-block sm:mr-2">Explain Calculation</span>
          <span class="font-bold text-neutral-900 dark:text-neutral-100">Live Mathematical Working</span>
        </div>
      </div>
      <div class="flex items-center gap-1.5 shrink-0">
        <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 group-open:hidden">Show Steps</span>
        <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 hidden group-open:inline">Hide Steps</span>
        <svg data-icon class="w-4 h-4 text-neutral-400 shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </summary>

    <div class="mt-4 pt-4 border-t border-neutral-200/70 dark:border-neutral-800/80 space-y-4 text-xs font-mono">
      <!-- Formula -->
      <div class="space-y-1.5">
        <div class="text-[10px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-bold">Standard BMI Formula</div>
        <div id="exp-bmi-formula-box" class="p-2.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-neutral-900 dark:text-rose-300 font-bold overflow-x-auto text-xs sm:text-sm">
          BMI = Weight (kg) ÷ [Height (m)]²
        </div>
      </div>

      <!-- Live Calculation Working -->
      <div id="bmi-explain-body" class="space-y-3">
        <!-- Step 1: Input Values -->
        <div class="p-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 space-y-1">
          <div class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100">Step 1 — Standardized Input Values</div>
          <div class="text-neutral-600 dark:text-neutral-400 space-y-0.5 pt-0.5">
            <div>Weight = <span id="exp-bmi-weight" class="font-bold text-black dark:text-white">70 kg</span></div>
            <div>Height = <span id="exp-bmi-height" class="font-bold text-black dark:text-white">175 cm (1.75 m)</span></div>
          </div>
        </div>

        <!-- Step 2: Intermediate & Result -->
        <div class="p-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 space-y-1">
          <div class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100">Step 2 — Calculation & Substitution</div>
          <div class="text-neutral-600 dark:text-neutral-400 space-y-1 pt-0.5">
            <div>Height Squared = <span id="exp-bmi-sq" class="font-bold text-black dark:text-white">1.75 × 1.75 = 3.0625 m²</span></div>
            <div class="p-2 rounded-lg bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 text-neutral-800 dark:text-neutral-200 overflow-x-auto text-[11px]">
              BMI = <span id="exp-bmi-sub-eq">70 ÷ 3.0625</span>
            </div>
            <div class="font-bold text-rose-600 dark:text-rose-400 text-sm flex items-center gap-2 flex-wrap">
              <span>= <span id="exp-bmi-final-val">22.9</span> kg/m²</span>
              <span id="exp-bmi-cat-badge" class="text-xs px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 font-bold font-sans">Normal Weight</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </details>
</div>

<script is:inline>
  (function() {
    let mode = 'metric';

    const btnMetric = document.getElementById('bmi-unit-metric');
    const btnImperial = document.getElementById('bmi-unit-imperial');

    const metricFields = document.getElementById('bmi-metric-fields');
    const imperialFields = document.getElementById('bmi-imperial-fields');

    const cmInput = document.getElementById('bmi-height-cm');
    const kgInput = document.getElementById('bmi-weight-kg');

    const ftInput = document.getElementById('bmi-height-ft');
    const inInput = document.getElementById('bmi-height-in');
    const lbsInput = document.getElementById('bmi-weight-lbs');

    const bmiScore = document.getElementById('bmi-score');
    const bmiBadge = document.getElementById('bmi-badge');
    const bmiPointer = document.getElementById('bmi-pointer');
    const bmiAdvice = document.getElementById('bmi-advice');

    // Explain elements
    const expFormulaBox = document.getElementById('exp-bmi-formula-box');
    const expWeight = document.getElementById('exp-bmi-weight');
    const expHeight = document.getElementById('exp-bmi-height');
    const expSq = document.getElementById('exp-bmi-sq');
    const expSubEq = document.getElementById('exp-bmi-sub-eq');
    const expFinalVal = document.getElementById('exp-bmi-final-val');
    const expCatBadge = document.getElementById('exp-bmi-cat-badge');

    function calculateBMI() {
      let bmi = 0;
      let heightCmVal = 0;
      let weightKgVal = 0;
      let heightFtVal = 0;
      let heightInVal = 0;
      let weightLbsVal = 0;

      if (mode === 'metric') {
        heightCmVal = parseFloat(cmInput.value) || 0;
        weightKgVal = parseFloat(kgInput.value) || 0;
        if (heightCmVal > 0 && weightKgVal > 0) {
          const m = heightCmVal / 100;
          bmi = weightKgVal / (m * m);
        }
      } else {
        heightFtVal = parseFloat(ftInput.value) || 0;
        heightInVal = parseFloat(inInput.value) || 0;
        weightLbsVal = parseFloat(lbsInput.value) || 0;
        const totalInches = (heightFtVal * 12) + heightInVal;
        if (totalInches > 0 && weightLbsVal > 0) {
          bmi = (weightLbsVal / (totalInches * totalInches)) * 703;
        }
      }

      if (bmi <= 0 || isNaN(bmi)) {
        if (bmiScore) bmiScore.textContent = '--';
        if (expWeight) expWeight.textContent = '--';
        if (expHeight) expHeight.textContent = '--';
        if (expSq) expSq.textContent = '--';
        if (expSubEq) expSubEq.textContent = 'Enter valid values above';
        if (expFinalVal) expFinalVal.textContent = '--';
        return;
      }

      const formatted = bmi.toFixed(1);
      if (bmiScore) bmiScore.textContent = formatted;

      let category = 'Normal Weight';
      let badgeClass = 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20';
      let pct = 50;
      let advice = 'Your weight is in the recommended healthy range.';

      if (bmi < 18.5) {
        category = 'Underweight';
        badgeClass = 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20';
        pct = Math.max(5, (bmi / 18.5) * 25);
        advice = 'Below standard weight range. Consider consulting a nutritionist for healthy weight gain.';
      } else if (bmi < 25) {
        category = 'Normal Weight';
        badgeClass = 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20';
        pct = 25 + (((bmi - 18.5) / 6.5) * 25);
        advice = 'Great news! Your BMI is in the healthy body weight range.';
      } else if (bmi < 30) {
        category = 'Overweight';
        badgeClass = 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20';
        pct = 50 + (((bmi - 25) / 5) * 25);
        advice = 'Slightly above healthy range. Regular cardio and balanced diet recommended.';
      } else {
        category = 'Obese';
        badgeClass = 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/20';
        pct = Math.min(95, 75 + (((bmi - 30) / 15) * 25));
        advice = 'Above healthy parameters. Consult a health professional for personalized fitness plan.';
      }

      if (bmiBadge) {
        bmiBadge.textContent = category;
        bmiBadge.className = `px-2.5 py-0.5 rounded-full text-xs font-bold border ${badgeClass}`;
      }
      if (bmiPointer) bmiPointer.style.left = `${pct}%`;

      // Update SVG Radial Gauge Needle
      const needle = document.getElementById('bmi-needle-container');
      if (needle) {
        const angle = ((pct / 100) * 180) - 90;
        needle.style.transform = `rotate(${angle.toFixed(1)}deg)`;
      }

      if (bmiAdvice) bmiAdvice.textContent = advice;

      // Update Live Explain Calculation
      if (mode === 'metric') {
        const m = heightCmVal / 100;
        const mSq = m * m;
        if (expFormulaBox) expFormulaBox.textContent = 'BMI = Weight (kg) ÷ [Height (m)]²';
        if (expWeight) expWeight.textContent = `${weightKgVal} kg`;
        if (expHeight) expHeight.textContent = `${heightCmVal} cm (${m.toFixed(2)} m)`;
        if (expSq) expSq.textContent = `${m.toFixed(2)} × ${m.toFixed(2)} = ${mSq.toFixed(4)} m²`;
        if (expSubEq) expSubEq.textContent = `${weightKgVal} ÷ ${mSq.toFixed(4)}`;
      } else {
        const totalInches = (heightFtVal * 12) + heightInVal;
        const inSq = totalInches * totalInches;
        const weighted = weightLbsVal * 703;
        if (expFormulaBox) expFormulaBox.textContent = 'BMI = [Weight (lbs) × 703] ÷ [Height (in)]²';
        if (expWeight) expWeight.textContent = `${weightLbsVal} lbs`;
        if (expHeight) expHeight.textContent = `${heightFtVal} ft ${heightInVal} in (${totalInches} in)`;
        if (expSq) expSq.textContent = `${totalInches} × ${totalInches} = ${inSq} in²`;
        if (expSubEq) expSubEq.textContent = `(${weightLbsVal} × 703) ÷ ${inSq} = ${weighted} ÷ ${inSq}`;
      }

      if (expFinalVal) expFinalVal.textContent = formatted;
      if (expCatBadge) {
        expCatBadge.textContent = category;
        expCatBadge.className = `text-xs px-2 py-0.5 rounded-full border font-bold font-sans ${badgeClass}`;
      }
    }

    if (btnMetric && btnImperial) {
      btnMetric.addEventListener('click', () => {
        mode = 'metric';
        btnMetric.className = 'px-2.5 py-1.5 rounded-lg bg-white dark:bg-neutral-900 text-black dark:text-white font-bold shadow-xs';
        btnImperial.className = 'px-2.5 py-1.5 rounded-lg text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors';
        metricFields?.classList.remove('hidden');
        imperialFields?.classList.add('hidden');
        calculateBMI();
      });

      btnImperial.addEventListener('click', () => {
        mode = 'imperial';
        btnImperial.className = 'px-2.5 py-1.5 rounded-lg bg-white dark:bg-neutral-900 text-black dark:text-white font-bold shadow-xs';
        btnMetric.className = 'px-2.5 py-1.5 rounded-lg text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors';
        imperialFields?.classList.remove('hidden');
        metricFields?.classList.add('hidden');
        calculateBMI();
      });
    }

    [cmInput, kgInput, ftInput, inInput, lbsInput].forEach(inp => {
      if (inp) inp.addEventListener('input', calculateBMI);
    });

    calculateBMI();
  })();
</script>
