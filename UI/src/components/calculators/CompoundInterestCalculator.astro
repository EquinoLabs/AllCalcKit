---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-blue-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">Compound Interest Calculator</h3>
    </div>
    
    <!-- Currency Selector -->
    <div class="flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800 px-2 py-1 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs shrink-0">
      <select aria-label="Select currency unit" class="ack-currency-select bg-transparent text-black dark:text-white font-bold outline-none cursor-pointer text-xs">
        <option value="USD">USD ($)</option>
        <option value="INR">INR (₹)</option>
        <option value="EUR">EUR (€)</option>
        <option value="GBP">GBP (£)</option>
      </select>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="space-y-4">
      <div>
        <label for="ci-principal" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Initial Principal</label>
        <input id="ci-principal" type="number" value="100000" min="100" step="1000" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-blue-500 tabular-nums" />
        <span id="ci-principal-hint" class="text-[11px] font-mono text-neutral-500 mt-1 block"></span>
      </div>

      <div>
        <label for="ci-rate" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Annual Interest Rate (% p.a.)</label>
        <input id="ci-rate" type="number" value="8" min="0.1" max="50" step="0.1" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-blue-500 tabular-nums" />
      </div>

      <div class="grid grid-cols-2 gap-2">
        <div>
          <label for="ci-years" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Time Period (Years)</label>
          <input id="ci-years" type="number" value="5" min="1" max="50" step="1" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-blue-500 tabular-nums" />
        </div>
        <div>
          <label for="ci-freq" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Compounding Frequency</label>
          <select id="ci-freq" class="w-full px-3 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white text-xs font-bold outline-none cursor-pointer">
            <option value="1">Annually (n=1)</option>
            <option value="4">Quarterly (n=4)</option>
            <option value="12" selected>Monthly (n=12)</option>
            <option value="365">Daily (n=365)</option>
          </select>
        </div>

        <!-- Compounding Milestones Progress -->
        <div class="p-3.5 rounded-xl bg-neutral-100/80 dark:bg-neutral-800/40 border border-neutral-200/80 dark:border-neutral-700/60 space-y-2.5 text-xs font-mono">
          <div class="flex items-center justify-between text-[11px] font-bold text-neutral-700 dark:text-neutral-300">
            <span class="uppercase tracking-wider">Compounding Milestones</span>
            <span id="ci-milestone-total" class="text-neutral-500">5-Year Growth</span>
          </div>
          <div class="grid grid-cols-3 gap-2 text-center text-[10px]">
            <div class="p-2 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-2xs">
              <span class="text-neutral-500 block">Year 1</span>
              <span id="ci-ms-yr1" class="font-bold text-neutral-900 dark:text-white tabular-nums">$10.7k</span>
            </div>
            <div class="p-2 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-2xs">
              <span class="text-neutral-500 block">Mid-Point</span>
              <span id="ci-ms-mid" class="font-bold text-neutral-900 dark:text-white tabular-nums">$12.2k</span>
            </div>
            <div class="p-2 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-2xs">
              <span class="text-neutral-500 block">Final Balance</span>
              <span id="ci-ms-end" class="font-bold text-blue-600 dark:text-blue-400 tabular-nums">$14.9k</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-5 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between gap-2 mb-1 flex-wrap">
          <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold">Final Future Balance</div>
          <button
            id="ci-export-csv-btn"
            type="button"
            title="Download Year-by-Year Compounding Schedule as CSV"
            class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 text-[11px] font-mono font-medium transition-all shadow-2xs cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>CSV</span>
          </button>
        </div>
        <div id="ci-balance-val" class="text-3xl sm:text-4xl font-black text-blue-600 dark:text-blue-400 tabular-nums">$0</div>
        <div id="ci-compact-badge" class="text-xs font-mono font-bold text-blue-700 dark:text-blue-300 mt-0.5"></div>
      </div>

      <div class="grid grid-cols-2 gap-4 py-4 border-y border-neutral-200 dark:border-neutral-800 my-4 text-xs font-mono">
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Total Principal</span>
          <span id="ci-principal-val" class="font-bold text-black dark:text-white tabular-nums">$0</span>
        </div>
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Total Interest</span>
          <span id="ci-interest-val" class="font-bold text-blue-600 dark:text-blue-400 tabular-nums">$0</span>
        </div>
      </div>

      <!-- Interactive SVG Donut Breakdown -->
      <div class="p-3.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 flex flex-col sm:flex-row items-center gap-4 shadow-2xs mb-3">
        <div class="relative w-24 h-24 shrink-0 flex items-center justify-center">
          <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100" aria-label="Principal vs Compound Interest Donut Chart">
            <circle cx="50" cy="50" r="38" class="stroke-neutral-100 dark:stroke-neutral-800" stroke-width="11" fill="none" />
            <circle id="ci-donut-principal" cx="50" cy="50" r="38" class="stroke-black dark:stroke-neutral-300 transition-all duration-500 ease-out" stroke-width="11" stroke-dasharray="167.13 238.76" stroke-dashoffset="0" fill="none" />
            <circle id="ci-donut-interest" cx="50" cy="50" r="38" class="stroke-blue-600 dark:stroke-blue-400 transition-all duration-500 ease-out" stroke-width="11" stroke-dasharray="71.63 238.76" stroke-dashoffset="-167.13" fill="none" />
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center pointer-events-none">
            <span id="ci-donut-ratio" class="text-xs font-mono font-black text-neutral-900 dark:text-white tabular-nums">70%</span>
            <span class="text-[8px] font-mono text-neutral-500 uppercase tracking-tighter">Principal</span>
          </div>
        </div>

        <div class="flex-1 w-full space-y-1.5 text-xs font-mono">
          <div class="flex items-center justify-between p-1.5 rounded-lg bg-neutral-50 dark:bg-neutral-950 border border-neutral-200/60 dark:border-neutral-800/60">
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-black dark:bg-neutral-300 shrink-0"></span>
              <span class="text-neutral-600 dark:text-neutral-400 text-[11px]">Principal</span>
            </div>
            <span id="ci-prin-pct" class="font-bold text-neutral-900 dark:text-white tabular-nums text-[11px]">70%</span>
          </div>

          <div class="flex items-center justify-between p-1.5 rounded-lg bg-neutral-50 dark:bg-neutral-950 border border-neutral-200/60 dark:border-neutral-800/60">
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-blue-600 dark:bg-blue-400 shrink-0"></span>
              <span class="text-neutral-600 dark:text-neutral-400 text-[11px]">Interest Gain</span>
            </div>
            <span id="ci-int-pct" class="font-bold text-blue-600 dark:text-blue-400 tabular-nums text-[11px]">30%</span>
          </div>
        </div>
      </div>

      <div class="text-xs font-mono text-neutral-500 leading-relaxed">
        Formula: <span class="font-bold">A = P(1 + r/n)^(nt)</span>. Compounding accelerates wealth creation exponentially.
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const pInp = document.getElementById('ci-principal');
    const rInp = document.getElementById('ci-rate');
    const tInp = document.getElementById('ci-years');
    const fInp = document.getElementById('ci-freq');
    const pHint = document.getElementById('ci-principal-hint');

    const balEl = document.getElementById('ci-balance-val');
    const compactBadge = document.getElementById('ci-compact-badge');
    const prinEl = document.getElementById('ci-principal-val');
    const intEl = document.getElementById('ci-interest-val');

    const CURRENCY_CONFIGS = {
      USD: { symbol: '$', locale: 'en-US' },
      INR: { symbol: '₹', locale: 'en-IN' },
      EUR: { symbol: '€', locale: 'en-IE' },
      GBP: { symbol: '£', locale: 'en-GB' }
    };

    function getCurrency() {
      return localStorage.getItem('ack_currency') || 'USD';
    }

    function formatIndianCompact(num) {
      if (num >= 10000000) {
        const cr = (num / 10000000).toFixed(2).replace(/\.00$/, '');
        return `≈ ₹${cr} Crores`;
      }
      if (num >= 100000) {
        const l = (num / 100000).toFixed(2).replace(/\.00$/, '');
        return `≈ ₹${l} Lakhs`;
      }
      return '';
    }

    function formatMoney(num) {
      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;
      const formatted = Math.round(num).toLocaleString(cfg.locale);
      return `${cfg.symbol}${formatted}`;
    }

    let lastCurrency = getCurrency();

    function updateInputsForCurrency() {
      const curr = getCurrency();
      if (!pInp) return;

      if (curr === 'INR') {
        pInp.step = '5000';
        pInp.min = '1000';
        if (lastCurrency !== 'INR' || parseFloat(pInp.value) < 10000) {
          pInp.value = '100000';
        }
        if (pHint) pHint.textContent = 'Typical deposit: ₹50,000 – ₹10,00,000 (10 Lakhs)';
      } else {
        pInp.step = '500';
        pInp.min = '100';
        if (lastCurrency === 'INR' && parseFloat(pInp.value) > 100000) {
          pInp.value = '10000';
        }
        if (pHint) pHint.textContent = 'Typical deposit: $1,000 – $50,000';
      }
      lastCurrency = curr;
    }

    function calcCI() {
      if (!pInp || !rInp || !tInp || !fInp) return;
      const P = parseFloat(pInp.value) || 0;
      const r = (parseFloat(rInp.value) || 0) / 100;
      const t = parseFloat(tInp.value) || 0;
      const n = parseFloat(fInp.value) || 12;

      const curr = getCurrency();

      const A = P * Math.pow(1 + (r / n), n * t);
      const interest = A - P;

      if (balEl) balEl.textContent = formatMoney(A);
      if (compactBadge) {
        if (curr === 'INR') {
          compactBadge.textContent = formatIndianCompact(A);
        } else {
          compactBadge.textContent = '';
        }
      }
      if (prinEl) prinEl.textContent = formatMoney(P);
      if (intEl) intEl.textContent = formatMoney(interest);

      const pPct = A > 0 ? Math.round((P / A) * 100) : 100;
      const iPct = 100 - pPct;

      const pPctEl = document.getElementById('ci-prin-pct');
      const iPctEl = document.getElementById('ci-int-pct');
      if (pPctEl) pPctEl.textContent = pPct + '%';
      if (iPctEl) iPctEl.textContent = iPct + '%';

      // SVG Donut Chart Update
      const donutPrin = document.getElementById('ci-donut-principal');
      const donutInt = document.getElementById('ci-donut-interest');
      const donutRatio = document.getElementById('ci-donut-ratio');
      if (donutPrin && donutInt) {
        const C = 238.761;
        const pLen = ((pPct / 100) * C).toFixed(2);
        const iLen = ((iPct / 100) * C).toFixed(2);
        donutPrin.setAttribute('stroke-dasharray', `${pLen} ${C}`);
        donutPrin.setAttribute('stroke-dashoffset', '0');
        donutInt.setAttribute('stroke-dasharray', `${iLen} ${C}`);
        donutInt.setAttribute('stroke-dashoffset', `-${pLen}`);
      }
      if (donutRatio) donutRatio.textContent = pPct + '%';

      // Update Compounding Milestones
      const milestoneTotalEl = document.getElementById('ci-milestone-total');
      const msYr1El = document.getElementById('ci-ms-yr1');
      const msMidEl = document.getElementById('ci-ms-mid');
      const msEndEl = document.getElementById('ci-ms-end');

      if (milestoneTotalEl) milestoneTotalEl.textContent = `${t}-Year Growth`;

      function getFutureBalance(years) {
        if (years <= 0) return P;
        return P * Math.pow(1 + (r / n), n * years);
      }

      const yr1Val = getFutureBalance(Math.min(1, t));
      const midVal = getFutureBalance(t / 2);
      const endVal = A;

      if (msYr1El) msYr1El.textContent = formatMoney(yr1Val);
      if (msMidEl) msMidEl.textContent = formatMoney(midVal);
      if (msEndEl) msEndEl.textContent = formatMoney(endVal);
    }

    // CSV Compounding Schedule Export Handler
    const ciExportCsvBtn = document.getElementById('ci-export-csv-btn');
    if (ciExportCsvBtn) {
      ciExportCsvBtn.addEventListener('click', () => {
        const P = parseFloat(pInp?.value || '10000');
        const annualRate = parseFloat(rInp?.value || '7');
        const years = parseFloat(tInp?.value || '5');
        const n = parseFloat(fInp?.value || '12');

        if (P <= 0 || years <= 0) return;

        const r = annualRate / 100;
        const totalYears = Math.ceil(years);

        const headers = ['Year', 'Beginning Balance', 'Interest Earned This Year', 'Ending Balance', 'Total Accumulated Interest'];
        const rows = [];
        let prevBal = P;

        for (let y = 1; y <= totalYears; y++) {
          const currentBal = P * Math.pow(1 + (r / n), n * y);
          const interestThisYr = currentBal - prevBal;
          const totalInterest = currentBal - P;
          rows.push([
            `Year ${y}`,
            prevBal.toFixed(2),
            interestThisYr.toFixed(2),
            currentBal.toFixed(2),
            totalInterest.toFixed(2)
          ]);
          prevBal = currentBal;
        }

        const headerLine = headers.join(',');
        const rowLines = rows.map(r => r.join(','));
        const csvContent = [headerLine, ...rowLines].join('\r\n');
        const blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `Compound_Interest_Schedule_${Math.round(P)}_${annualRate}pct_${years}Years.csv`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      });
    }

    const selects = document.querySelectorAll('.ack-currency-select');
    selects.forEach(sel => {
      sel.value = getCurrency();
      sel.addEventListener('change', (e) => {
        const val = e.target.value;
        localStorage.setItem('ack_currency', val);
        window.dispatchEvent(new CustomEvent('ack_currency_change', { detail: val }));
      });
    });

    window.addEventListener('ack_currency_change', (e) => {
      selects.forEach(sel => sel.value = e.detail);
      updateInputsForCurrency();
      calcCI();
    });

    [pInp, rInp, tInp, fInp].forEach(el => el.addEventListener('input', calcCI));
    updateInputsForCurrency();
    calcCI();
  })();
</script>
