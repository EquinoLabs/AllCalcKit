---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">SIP Investment Calculator</h3>
    </div>
    
    <!-- Currency & Locale Selector Pill -->
    <div class="flex items-center gap-1 bg-neutral-100 dark:bg-neutral-800 px-2 py-1 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs shrink-0">
      <span class="text-[10px] text-neutral-600 dark:text-neutral-400 font-semibold hidden sm:inline">Unit:</span>
      <select aria-label="Select currency unit" class="ack-currency-select bg-transparent text-black dark:text-white font-bold outline-none cursor-pointer text-xs">
        <option value="USD">USD ($)</option>
        <option value="INR">INR (₹)</option>
        <option value="EUR">EUR (€)</option>
        <option value="GBP">GBP (£)</option>
      </select>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Sliders -->
    <div class="space-y-4">
      <div>
        <div class="flex justify-between items-center mb-1 text-xs font-semibold">
          <label for="sip-monthly" class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Monthly Investment</label>
          <span id="sip-monthly-val" class="font-mono font-bold text-black dark:text-white">5,000</span>
        </div>
        <input id="sip-monthly" type="range" min="500" max="200000" step="500" value="5000" class="w-full h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-emerald-600" />
        <div class="flex justify-between text-[10px] font-mono text-neutral-400 mt-1">
          <span id="sip-min-hint">Min: ₹500</span>
          <span id="sip-max-hint">Max: ₹2,00,000 (2 Lakhs)</span>
        </div>
      </div>

      <div>
        <div class="flex justify-between items-center mb-1 text-xs font-semibold">
          <label for="sip-rate" class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Expected Return Rate (% p.a.)</label>
          <span id="sip-rate-val" class="font-mono font-bold text-black dark:text-white">12%</span>
        </div>
        <input id="sip-rate" type="range" min="1" max="30" step="0.5" value="12" class="w-full h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-emerald-600" />
      </div>

      <div>
        <div class="flex justify-between items-center mb-1 text-xs font-semibold">
          <label for="sip-years" class="font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider">Time Period (Years)</label>
          <span id="sip-years-val" class="font-mono font-bold text-black dark:text-white">10 Years</span>
        </div>
        <input id="sip-years" type="range" min="1" max="40" step="1" value="10" class="w-full h-2.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-emerald-600" />
      </div>

      <!-- Growth Milestones Progress (Fills left column with rich visual compounding progression) -->
      <div class="p-3.5 rounded-xl bg-neutral-100/80 dark:bg-neutral-800/40 border border-neutral-200/80 dark:border-neutral-700/60 space-y-2.5 text-xs font-mono">
        <div class="flex items-center justify-between text-[11px] font-bold text-neutral-700 dark:text-neutral-300">
          <span class="uppercase tracking-wider">Compounding Milestones</span>
          <span id="sip-milestone-total" class="text-neutral-500">120 Monthly SIPs</span>
        </div>
        <div class="grid grid-cols-3 gap-2 text-center text-[10px]">
          <div class="p-2 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-2xs">
            <span class="text-neutral-500 block">Year 1 End</span>
            <span id="sip-ms-yr1" class="font-bold text-neutral-900 dark:text-white tabular-nums">$6.4k</span>
          </div>
          <div class="p-2 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-2xs">
            <span class="text-neutral-500 block">Mid-Point</span>
            <span id="sip-ms-mid" class="font-bold text-neutral-900 dark:text-white tabular-nums">$41.2k</span>
          </div>
          <div class="p-2 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-2xs">
            <span class="text-neutral-500 block">Final Goal</span>
            <span id="sip-ms-end" class="font-bold text-emerald-600 dark:text-emerald-400 tabular-nums">$116k</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Output Box -->
    <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-5 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between gap-2 mb-1 flex-wrap">
          <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold">Expected Total Value</div>
          <button
            id="sip-export-csv-btn"
            type="button"
            title="Download Year-by-Year Wealth Schedule as CSV"
            class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 text-[11px] font-mono font-medium transition-all shadow-2xs cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>CSV</span>
          </button>
        </div>
        <div id="sip-total-val" class="text-3xl sm:text-4xl font-black text-emerald-600 dark:text-emerald-400 tabular-nums">
          $0
        </div>
        <div id="sip-compact-badge" class="text-xs font-mono font-bold text-emerald-700 dark:text-emerald-300 mt-0.5"></div>
      </div>

      <div class="grid grid-cols-2 gap-4 py-4 border-y border-neutral-200 dark:border-neutral-800 my-4 text-xs font-mono">
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Invested Amount</span>
          <span id="sip-invested" class="font-bold text-black dark:text-white tabular-nums">$0</span>
        </div>
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">Est. Returns</span>
          <span id="sip-returns" class="font-bold text-emerald-600 dark:text-emerald-400 tabular-nums">$0</span>
        </div>
      </div>

      <!-- Interactive SVG Donut Breakdown -->
      <div class="p-3.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 flex flex-col sm:flex-row items-center gap-4 shadow-2xs my-2">
        <div class="relative w-28 h-28 shrink-0 flex items-center justify-center">
          <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100" aria-label="Invested vs Returns Breakdown">
            <circle cx="50" cy="50" r="38" class="stroke-neutral-100 dark:stroke-neutral-800" stroke-width="11" fill="none" />
            <circle id="sip-donut-invested" cx="50" cy="50" r="38" class="stroke-black dark:stroke-neutral-300 transition-all duration-500 ease-out" stroke-width="11" stroke-dasharray="119.38 238.76" stroke-dashoffset="0" fill="none" />
            <circle id="sip-donut-returns" cx="50" cy="50" r="38" class="stroke-emerald-500 dark:stroke-emerald-400 transition-all duration-500 ease-out" stroke-width="11" stroke-dasharray="119.38 238.76" stroke-dashoffset="-119.38" fill="none" />
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center pointer-events-none">
            <span id="sip-donut-ratio" class="text-xs font-mono font-black text-neutral-900 dark:text-white tabular-nums">50%</span>
            <span class="text-[9px] font-mono text-neutral-500 uppercase tracking-tighter">Invested</span>
          </div>
        </div>

        <div class="flex-1 w-full space-y-2 text-xs font-mono">
          <div class="flex items-center justify-between p-2 rounded-lg bg-neutral-50 dark:bg-neutral-950 border border-neutral-200/60 dark:border-neutral-800/60">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-black dark:bg-neutral-300 shrink-0"></span>
              <span class="text-neutral-600 dark:text-neutral-400">Total Invested</span>
            </div>
            <span id="sip-inv-pct" class="font-bold text-neutral-900 dark:text-white tabular-nums">50%</span>
          </div>

          <div class="flex items-center justify-between p-2 rounded-lg bg-neutral-50 dark:bg-neutral-950 border border-neutral-200/60 dark:border-neutral-800/60">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 dark:bg-emerald-400 shrink-0"></span>
              <span class="text-neutral-600 dark:text-neutral-400">Wealth Gain</span>
            </div>
            <span id="sip-ret-pct" class="font-bold text-emerald-600 dark:text-emerald-400 tabular-nums">50%</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const monthlyInp = document.getElementById('sip-monthly');
    const rateInp = document.getElementById('sip-rate');
    const yearsInp = document.getElementById('sip-years');

    const monthlyVal = document.getElementById('sip-monthly-val');
    const rateVal = document.getElementById('sip-rate-val');
    const yearsVal = document.getElementById('sip-years-val');

    const minHint = document.getElementById('sip-min-hint');
    const maxHint = document.getElementById('sip-max-hint');

    const totalValEl = document.getElementById('sip-total-val');
    const compactBadge = document.getElementById('sip-compact-badge');
    const investedEl = document.getElementById('sip-invested');
    const returnsEl = document.getElementById('sip-returns');

    const invPctEl = document.getElementById('sip-inv-pct');
    const retPctEl = document.getElementById('sip-ret-pct');
    const invBar = document.getElementById('sip-inv-bar');
    const retBar = document.getElementById('sip-ret-bar');

    const CURRENCY_CONFIGS = {
      USD: { symbol: '$', locale: 'en-US' },
      INR: { symbol: '₹', locale: 'en-IN' },
      EUR: { symbol: '€', locale: 'en-IE' },
      GBP: { symbol: '£', locale: 'en-GB' }
    };

    function getCurrency() {
      return localStorage.getItem('ack_currency') || 'USD';
    }

    function formatIndianCompact(num) {
      if (num >= 10000000) {
        const cr = (num / 10000000).toFixed(2).replace(/\.00$/, '');
        return `≈ ₹${cr} Crores`;
      }
      if (num >= 100000) {
        const l = (num / 100000).toFixed(2).replace(/\.00$/, '');
        return `≈ ₹${l} Lakhs`;
      }
      return '';
    }

    function formatMoney(num) {
      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;
      const formatted = Math.round(num).toLocaleString(cfg.locale);
      return `${cfg.symbol}${formatted}`;
    }

    let lastCurrency = getCurrency();

    function updateSliderForCurrency() {
      const curr = getCurrency();
      if (!monthlyInp) return;

      if (curr === 'INR') {
        monthlyInp.min = '500';
        monthlyInp.max = '200000';
        monthlyInp.step = '500';
        if (minHint) minHint.textContent = 'Min: ₹500';
        if (maxHint) maxHint.textContent = 'Max: ₹2,00,000 (2 Lakhs)';

        if (lastCurrency !== 'INR' && parseFloat(monthlyInp.value) <= 1000) {
          monthlyInp.value = '5000';
        }
      } else {
        monthlyInp.min = '50';
        monthlyInp.max = '10000';
        monthlyInp.step = '50';
        const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;
        if (minHint) minHint.textContent = `Min: ${cfg.symbol}50`;
        if (maxHint) maxHint.textContent = `Max: ${cfg.symbol}10,000`;

        if (lastCurrency === 'INR' && parseFloat(monthlyInp.value) > 10000) {
          monthlyInp.value = '500';
        }
      }
      lastCurrency = curr;
    }

    function calcSIP() {
      if (!monthlyInp || !rateInp || !yearsInp) return;

      const P = parseFloat(monthlyInp.value) || 0;
      const annualRate = parseFloat(rateInp.value) || 0;
      const years = parseFloat(yearsInp.value) || 0;

      const i = annualRate / 12 / 100;
      const n = years * 12;

      const curr = getCurrency();
      const cfg = CURRENCY_CONFIGS[curr] || CURRENCY_CONFIGS.USD;

      let monthlyDisplay = Math.round(P).toLocaleString(cfg.locale);
      if (curr === 'INR' && P >= 100000) {
        const compact = (P / 100000).toFixed(1).replace(/\.0$/, '');
        monthlyDisplay = `${monthlyDisplay} (${compact}L/mo)`;
      }

      if (monthlyVal) monthlyVal.textContent = monthlyDisplay;
      if (rateVal) rateVal.textContent = annualRate + '%';
      if (yearsVal) yearsVal.textContent = years + (years === 1 ? ' Year' : ' Years');

      if (P <= 0 || years <= 0) {
        if (totalValEl) totalValEl.textContent = `${cfg.symbol}0`;
        if (investedEl) investedEl.textContent = `${cfg.symbol}0`;
        if (returnsEl) returnsEl.textContent = `${cfg.symbol}0`;
        if (compactBadge) compactBadge.textContent = '';
        return;
      }

      const totalInvested = P * n;
      const totalValue = i > 0 ? P * ((Math.pow(1 + i, n) - 1) / i) * (1 + i) : totalInvested;
      const estReturns = totalValue - totalInvested;

      if (totalValEl) totalValEl.textContent = formatMoney(totalValue);
      if (compactBadge) {
        if (curr === 'INR') {
          compactBadge.textContent = formatIndianCompact(totalValue);
        } else {
          compactBadge.textContent = '';
        }
      }
      if (investedEl) investedEl.textContent = formatMoney(totalInvested);
      if (returnsEl) returnsEl.textContent = formatMoney(estReturns);

      const invPct = totalValue > 0 ? Math.round((totalInvested / totalValue) * 100) : 100;
      const retPct = 100 - invPct;

      if (invPctEl) invPctEl.textContent = invPct + '%';
      if (retPctEl) retPctEl.textContent = retPct + '%';
      if (invBar) invBar.style.width = invPct + '%';
      if (retBar) retBar.style.width = retPct + '%';

      // SVG Donut Chart Update
      const donutInv = document.getElementById('sip-donut-invested');
      const donutRet = document.getElementById('sip-donut-returns');
      const donutRatio = document.getElementById('sip-donut-ratio');
      if (donutInv && donutRet) {
        const C = 238.761;
        const invLen = ((invPct / 100) * C).toFixed(2);
        const retLen = ((retPct / 100) * C).toFixed(2);
        donutInv.setAttribute('stroke-dasharray', `${invLen} ${C}`);
        donutInv.setAttribute('stroke-dashoffset', '0');
        donutRet.setAttribute('stroke-dasharray', `${retLen} ${C}`);
        donutRet.setAttribute('stroke-dashoffset', `-${invLen}`);
      }
      if (donutRatio) donutRatio.textContent = invPct + '%';

      // Update Compounding Milestones
      const milestoneTotalEl = document.getElementById('sip-milestone-total');
      const msYr1El = document.getElementById('sip-ms-yr1');
      const msMidEl = document.getElementById('sip-ms-mid');
      const msEndEl = document.getElementById('sip-ms-end');

      if (milestoneTotalEl) milestoneTotalEl.textContent = `${n} Monthly SIPs`;

      function getFutureValue(months) {
        if (months <= 0) return 0;
        if (i === 0) return P * months;
        return P * ((Math.pow(1 + i, months) - 1) / i) * (1 + i);
      }

      const yr1Val = getFutureValue(Math.min(12, n));
      const midVal = getFutureValue(Math.round(n / 2));
      const endVal = totalValue;

      if (msYr1El) msYr1El.textContent = formatMoney(yr1Val);
      if (msMidEl) msMidEl.textContent = formatMoney(midVal);
      if (msEndEl) msEndEl.textContent = formatMoney(endVal);
    }

    // CSV Wealth Schedule Export Handler
    const sipExportCsvBtn = document.getElementById('sip-export-csv-btn');
    if (sipExportCsvBtn) {
      sipExportCsvBtn.addEventListener('click', () => {
        const P = parseFloat(monthlyInp?.value || '500');
        const annualRate = parseFloat(rateInp?.value || '12');
        const years = parseFloat(yearsInp?.value || '10');

        if (P <= 0 || years <= 0) return;

        const i = annualRate / 12 / 100;
        const totalMonths = Math.round(years * 12);

        const headers = ['Year', 'Month', 'Total Invested Capital', 'Accumulated Wealth', 'Total Wealth Gain (Profit)'];
        const rows = [];

        for (let m = 1; m <= totalMonths; m++) {
          const invested = P * m;
          const futureVal = i > 0 ? P * ((Math.pow(1 + i, m) - 1) / i) * (1 + i) : invested;
          const profit = futureVal - invested;
          const yr = Math.ceil(m / 12);
          rows.push([
            `Year ${yr}`,
            `Month ${m}`,
            invested.toFixed(2),
            futureVal.toFixed(2),
            profit.toFixed(2)
          ]);
        }

        const headerLine = headers.join(',');
        const rowLines = rows.map(r => r.join(','));
        const csvContent = [headerLine, ...rowLines].join('\r\n');
        const blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `SIP_Wealth_Accumulation_${Math.round(P)}_Monthly_${annualRate}pct_${years}Years.csv`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      });
    }

    // Initialize currency selects
    const selects = document.querySelectorAll('.ack-currency-select');
    selects.forEach(sel => {
      sel.value = getCurrency();
      sel.addEventListener('change', (e) => {
        const val = e.target.value;
        localStorage.setItem('ack_currency', val);
        window.dispatchEvent(new CustomEvent('ack_currency_change', { detail: val }));
      });
    });

    window.addEventListener('ack_currency_change', (e) => {
      selects.forEach(sel => sel.value = e.detail);
      updateSliderForCurrency();
      calcSIP();
    });

    monthlyInp.addEventListener('input', calcSIP);
    rateInp.addEventListener('input', calcSIP);
    yearsInp.addEventListener('input', calcSIP);

    updateSliderForCurrency();
    calcSIP();
  })();
</script>
