---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-cyan-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">Color Code Converter (HEX / RGB / HSL)</h3>
    </div>
    <span class="text-[10px] sm:text-[11px] font-mono px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 border border-cyan-500/20 shrink-0 font-bold">
      Design & Graphics
    </span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="space-y-4 font-mono">
      <div>
        <label for="color-hex" class="block text-xs text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Color Picker & HEX Code</label>
        <div class="flex gap-2">
          <input id="color-picker" aria-label="Color visual picker" type="color" value="#0070f3" class="w-12 h-11 p-1 rounded-xl bg-neutral-100 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 cursor-pointer shrink-0" />
          <input id="color-hex" type="text" value="#0070F3" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-sm outline-none focus:ring-2 focus:ring-cyan-500 uppercase" />
        </div>
      </div>

      <div>
        <label for="color-rgb" class="block text-xs text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">RGB Value</label>
        <input id="color-rgb" type="text" value="rgb(0, 112, 243)" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-sm outline-none focus:ring-2 focus:ring-cyan-500" />
      </div>

      <div>
        <label for="color-hsl" class="block text-xs text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">HSL Value</label>
        <input id="color-hsl" type="text" value="hsl(212, 100%, 48%)" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-sm outline-none focus:ring-2 focus:ring-cyan-500" />
      </div>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-5 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between">
      <div>
        <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold mb-2 font-semibold">Live Preview</div>
        <div id="color-preview-box" class="w-full h-24 rounded-xl border border-neutral-300 dark:border-neutral-700 shadow-md transition-colors" style="background-color: #0070f3"></div>
      </div>

      <div class="pt-4 border-t border-neutral-200 dark:border-neutral-800 text-xs font-mono text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Bidirectional real-time conversion between web color standards.
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const picker = document.getElementById('color-picker');
    const hexInp = document.getElementById('color-hex');
    const rgbInp = document.getElementById('color-rgb');
    const hslInp = document.getElementById('color-hsl');
    const box = document.getElementById('color-preview-box');

    function hexToRgb(hex) {
      let c = hex.replace('#', '');
      if (c.length === 3) c = c.split('').map(x => x + x).join('');
      const num = parseInt(c, 16);
      return { r: (num >> 16) & 255, g: (num >> 8) & 255, b: num & 255 };
    }

    function rgbToHsl(r, g, b) {
      r /= 255; g /= 255; b /= 255;
      const max = Math.max(r, g, b), min = Math.min(r, g, b);
      let h, s, l = (max + min) / 2;
      if (max === min) {
        h = s = 0;
      } else {
        const d = max - min;
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
        switch (max) {
          case r: h = (g - b) / d + (g < b ? 6 : 0); break;
          case g: h = (b - r) / d + 2; break;
          case b: h = (r - g) / d + 4; break;
        }
        h /= 6;
      }
      return { h: Math.round(h * 360), s: Math.round(s * 100), l: Math.round(l * 100) };
    }

    function updateFromHex(hex) {
      if (!/^#?[0-9A-Fa-f]{6}$/.test(hex)) return;
      const formattedHex = hex.startsWith('#') ? hex : '#' + hex;
      picker.value = formattedHex;
      if (box) box.style.backgroundColor = formattedHex;

      const { r, g, b } = hexToRgb(formattedHex);
      rgbInp.value = `rgb(${r}, ${g}, ${b})`;

      const { h, s, l } = rgbToHsl(r, g, b);
      hslInp.value = `hsl(${h}, ${s}%, ${l}%)`;
    }

    picker.addEventListener('input', (e) => {
      hexInp.value = e.target.value.toUpperCase();
      updateFromHex(e.target.value);
    });

    hexInp.addEventListener('input', (e) => updateFromHex(e.target.value));
  })();
</script>
