---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-purple-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">Date Difference Calculator</h3>
    </div>
    <span class="text-[10px] sm:text-[11px] font-mono px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-700 dark:text-purple-400 border border-purple-500/20 shrink-0 font-bold">
      Calendar Span
    </span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="space-y-4">
      <div>
        <label for="dd-start" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">Start Date</label>
        <input id="dd-start" type="date" value="2026-01-01" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-purple-500" />
      </div>

      <div>
        <label for="dd-end" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider mb-1 font-semibold">End Date</label>
        <input id="dd-end" type="date" value="2026-12-31" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-base outline-none focus:ring-2 focus:ring-purple-500" />
      </div>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-950 rounded-xl p-5 border border-neutral-200 dark:border-neutral-800 flex flex-col justify-between">
      <div>
        <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold mb-1 font-semibold">Total Time Difference</div>
        <div id="dd-result" class="text-2xl sm:text-3xl font-black text-purple-600 dark:text-purple-400 tabular-nums">0 Days</div>
      </div>

      <div class="grid grid-cols-2 gap-4 py-4 border-y border-neutral-200 dark:border-neutral-800 my-4 text-xs font-mono">
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">In Weeks & Days</span>
          <span id="dd-weeks" class="font-bold text-black dark:text-white tabular-nums">0 Wks, 0 Days</span>
        </div>
        <div>
          <span class="text-neutral-600 dark:text-neutral-400 block font-semibold">In Hours</span>
          <span id="dd-hours" class="font-bold text-purple-600 dark:text-purple-400 tabular-nums">0 Hours</span>
        </div>
      </div>

      <div class="text-xs font-mono text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Calculates exact day count between any two calendar dates.
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const startInp = document.getElementById('dd-start');
    const endInp = document.getElementById('dd-end');

    const resEl = document.getElementById('dd-result');
    const weeksEl = document.getElementById('dd-weeks');
    const hoursEl = document.getElementById('dd-hours');

    function calcDD() {
      if (!startInp || !endInp) return;
      const start = new Date(startInp.value);
      const end = new Date(endInp.value);

      if (isNaN(start.getTime()) || isNaN(end.getTime())) {
        if (resEl) resEl.textContent = 'Invalid Date';
        return;
      }

      const diffTime = Math.abs(end - start);
      const totalDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
      const weeks = Math.floor(totalDays / 7);
      const remDays = totalDays % 7;
      const hours = totalDays * 24;

      if (resEl) resEl.textContent = `${totalDays.toLocaleString()} Days`;
      if (weeksEl) weeksEl.textContent = `${weeks} Wks, ${remDays} Days`;
      if (hoursEl) hoursEl.textContent = `${hours.toLocaleString()} Hours`;
    }

    [startInp, endInp].forEach(el => el.addEventListener('input', calcDD));
    calcDD();
  })();
</script>
