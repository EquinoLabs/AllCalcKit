---
---

<div class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-4 sm:p-6 lg:p-7 shadow-xs hover:shadow-md transition-all w-full max-w-full overflow-hidden">
  <div class="flex items-center justify-between gap-2 mb-6">
    <div class="flex items-center gap-2 min-w-0">
      <span class="w-2.5 h-2.5 rounded-full bg-amber-500 shrink-0"></span>
      <h3 class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">Percentage Calculator Suite</h3>
    </div>
    <span class="text-[10px] sm:text-[11px] font-mono px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 shrink-0 font-bold">
      Math & Percent
    </span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 lg:gap-6">
    <!-- Mode 1: What is X% of Y? -->
    <div class="bg-neutral-50 dark:bg-neutral-950 p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 space-y-4 flex flex-col justify-between">
      <div class="space-y-4">
        <div class="space-y-1">
          <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold">1. Calculate Percentage Value</div>
          <div class="text-xs font-mono font-bold text-amber-600 dark:text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-md inline-block border border-amber-500/20">Formula: What is X% of Y?</div>
        </div>
        
        <!-- Input Grid with Labels Below for Perfect Vertical Alignment -->
        <div class="grid grid-cols-2 gap-3 items-start pt-1">
          <div>
            <input id="p1-pct" aria-label="Percentage value" type="number" value="15" step="any" class="w-full px-3 py-2.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-mono font-bold text-sm focus:ring-2 focus:ring-amber-500 outline-none tabular-nums" />
            <label for="p1-pct" class="block text-[11px] font-mono text-neutral-600 dark:text-neutral-400 font-semibold mt-1.5 text-center">Percentage (X)</label>
          </div>
          <div>
            <input id="p1-total" aria-label="Total amount" type="number" value="200" step="any" class="w-full px-3 py-2.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-mono font-bold text-sm focus:ring-2 focus:ring-amber-500 outline-none tabular-nums" />
            <label for="p1-total" class="block text-[11px] font-mono text-neutral-600 dark:text-neutral-400 font-semibold mt-1.5 text-center">Of Amount (Y)</label>
          </div>
        </div>
      </div>

      <div class="pt-4 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between">
        <span id="p1-label" class="text-xs font-mono text-neutral-600 dark:text-neutral-400 font-medium">What is 15% of 200?</span>
        <span id="p1-result" class="font-mono font-bold text-xl text-amber-600 dark:text-amber-400 tabular-nums">30</span>
      </div>
    </div>

    <!-- Mode 2: X is what % of Y? -->
    <div class="bg-neutral-50 dark:bg-neutral-950 p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 space-y-4 flex flex-col justify-between">
      <div class="space-y-4">
        <div class="space-y-1">
          <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold">2. Percentage Share</div>
          <div class="text-xs font-mono font-bold text-amber-600 dark:text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-md inline-block border border-amber-500/20">Formula: X is what % of Y?</div>
        </div>
        
        <!-- Input Grid with Labels Below for Perfect Vertical Alignment -->
        <div class="grid grid-cols-2 gap-3 items-start pt-1">
          <div>
            <input id="p2-part" aria-label="Part value" type="number" value="45" step="any" class="w-full px-3 py-2.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-mono font-bold text-sm focus:ring-2 focus:ring-amber-500 outline-none tabular-nums" />
            <label for="p2-part" class="block text-[11px] font-mono text-neutral-600 dark:text-neutral-400 font-semibold mt-1.5 text-center">Part Value (X)</label>
          </div>
          <div>
            <input id="p2-total" aria-label="Total value" type="number" value="150" step="any" class="w-full px-3 py-2.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-mono font-bold text-sm focus:ring-2 focus:ring-amber-500 outline-none tabular-nums" />
            <label for="p2-total" class="block text-[11px] font-mono text-neutral-600 dark:text-neutral-400 font-semibold mt-1.5 text-center">Total Value (Y)</label>
          </div>
        </div>
      </div>

      <div class="pt-4 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between">
        <span id="p2-label" class="text-xs font-mono text-neutral-600 dark:text-neutral-400 font-medium">45 is what % of 150?</span>
        <span id="p2-result" class="font-mono font-bold text-xl text-amber-600 dark:text-amber-400 tabular-nums">30%</span>
      </div>
    </div>

    <!-- Mode 3: Percentage Increase / Decrease -->
    <div class="bg-neutral-50 dark:bg-neutral-950 p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 space-y-4 flex flex-col justify-between">
      <div class="space-y-4">
        <div class="space-y-1">
          <div class="text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-bold">3. Percentage Change</div>
          <div class="text-xs font-mono font-bold text-amber-600 dark:text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-md inline-block border border-amber-500/20">Formula: % Change from V1 to V2</div>
        </div>
        
        <!-- Input Grid with Labels Below for Perfect Vertical Alignment -->
        <div class="grid grid-cols-2 gap-3 items-start pt-1">
          <div>
            <input id="p3-v1" aria-label="Initial value" type="number" value="80" step="any" class="w-full px-3 py-2.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-mono font-bold text-sm focus:ring-2 focus:ring-amber-500 outline-none tabular-nums" />
            <label for="p3-v1" class="block text-[11px] font-mono text-neutral-600 dark:text-neutral-400 font-semibold mt-1.5 text-center">Initial (V1)</label>
          </div>
          <div>
            <input id="p3-v2" aria-label="Final value" type="number" value="100" step="any" class="w-full px-3 py-2.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-mono font-bold text-sm focus:ring-2 focus:ring-amber-500 outline-none tabular-nums" />
            <label for="p3-v2" class="block text-[11px] font-mono text-neutral-600 dark:text-neutral-400 font-semibold mt-1.5 text-center">Final (V2)</label>
          </div>
        </div>
      </div>

      <div class="pt-4 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between">
        <span id="p3-label" class="text-xs font-mono text-neutral-600 dark:text-neutral-400 font-medium">% Change from 80 to 100</span>
        <span id="p3-result" class="font-mono font-bold text-xl text-emerald-600 dark:text-emerald-400 tabular-nums">+25%</span>
      </div>
    </div>
  </div>

  <!-- Live Explain Calculation Walkthrough -->
  <details id="pct-explain-details" class="group bg-neutral-50/70 dark:bg-neutral-950/60 border border-neutral-200 dark:border-neutral-800 rounded-2xl p-4 sm:p-5 transition-all [&_[data-icon]]:open:rotate-180 mt-6 shadow-xs">
    <summary class="flex items-center justify-between gap-4 font-bold text-xs sm:text-sm text-neutral-800 dark:text-neutral-200 cursor-pointer select-none">
      <div class="flex items-center gap-2.5">
        <span class="w-7 h-7 rounded-lg bg-amber-500/10 dark:bg-amber-400/10 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0 border border-amber-500/20">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        </span>
        <div>
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400 block sm:inline-block sm:mr-2">Explain Calculation</span>
          <span class="font-bold text-neutral-900 dark:text-neutral-100">Live Mathematical Working Across 3 Modes</span>
        </div>
      </div>
      <div class="flex items-center gap-1.5 shrink-0">
        <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 group-open:hidden">Show Steps</span>
        <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 hidden group-open:inline">Hide Steps</span>
        <svg data-icon class="w-4 h-4 text-neutral-400 shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </summary>

    <div class="mt-4 pt-4 border-t border-neutral-200/70 dark:border-neutral-800/80 space-y-4 text-xs font-mono">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <!-- Mode 1 Breakdown -->
        <div class="p-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 space-y-1.5">
          <div class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100">1. Percentage Value</div>
          <div class="text-neutral-500 text-[10px]">Formula: (X ÷ 100) × Y</div>
          <div class="p-2 rounded-lg bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 text-neutral-800 dark:text-neutral-200 overflow-x-auto text-[11px]">
            (<span id="exp-p1-x">15</span> ÷ 100) × <span id="exp-p1-y">200</span>
          </div>
          <div class="font-bold text-amber-600 dark:text-amber-400 text-xs">
            = <span id="exp-p1-res">30</span>
          </div>
        </div>

        <!-- Mode 2 Breakdown -->
        <div class="p-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 space-y-1.5">
          <div class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100">2. Percentage Share</div>
          <div class="text-neutral-500 text-[10px]">Formula: (X ÷ Y) × 100</div>
          <div class="p-2 rounded-lg bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 text-neutral-800 dark:text-neutral-200 overflow-x-auto text-[11px]">
            (<span id="exp-p2-x">45</span> ÷ <span id="exp-p2-y">150</span>) × 100
          </div>
          <div class="font-bold text-amber-600 dark:text-amber-400 text-xs">
            = <span id="exp-p2-res">30%</span>
          </div>
        </div>

        <!-- Mode 3 Breakdown -->
        <div class="p-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 space-y-1.5">
          <div class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100">3. Percentage Change</div>
          <div class="text-neutral-500 text-[10px]">Formula: [(V2 − V1) ÷ |V1|] × 100</div>
          <div class="p-2 rounded-lg bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 text-neutral-800 dark:text-neutral-200 overflow-x-auto text-[11px]">
            [(<span id="exp-p3-v2">100</span> − <span id="exp-p3-v1">80</span>) ÷ <span id="exp-p3-v1-base">80</span>] × 100
          </div>
          <div class="font-bold text-emerald-600 dark:text-emerald-400 text-xs">
            = <span id="exp-p3-res">+25%</span>
          </div>
        </div>
      </div>
    </div>
  </details>
</div>

<script is:inline>
  (function() {
    const p1Pct = document.getElementById('p1-pct');
    const p1Total = document.getElementById('p1-total');
    const p1Result = document.getElementById('p1-result');
    const p1Label = document.getElementById('p1-label');
    const expP1X = document.getElementById('exp-p1-x');
    const expP1Y = document.getElementById('exp-p1-y');
    const expP1Res = document.getElementById('exp-p1-res');

    function calc1() {
      const p = parseFloat(p1Pct.value);
      const t = parseFloat(p1Total.value);
      if (isNaN(p) || isNaN(t)) {
        if (p1Result) p1Result.textContent = '--';
        if (expP1X) expP1X.textContent = '--';
        if (expP1Y) expP1Y.textContent = '--';
        if (expP1Res) expP1Res.textContent = '--';
        return;
      }
      const res = (p / 100) * t;
      const formatted = Number.isInteger(res) ? res.toLocaleString() : res.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (p1Label) p1Label.textContent = `What is ${p}% of ${t.toLocaleString()}?`;
      if (p1Result) p1Result.textContent = formatted;
      if (expP1X) expP1X.textContent = p.toString();
      if (expP1Y) expP1Y.textContent = t.toLocaleString();
      if (expP1Res) expP1Res.textContent = formatted;
    }
    if (p1Pct && p1Total) {
      p1Pct.addEventListener('input', calc1);
      p1Total.addEventListener('input', calc1);
    }

    const p2Part = document.getElementById('p2-part');
    const p2Total = document.getElementById('p2-total');
    const p2Result = document.getElementById('p2-result');
    const p2Label = document.getElementById('p2-label');
    const expP2X = document.getElementById('exp-p2-x');
    const expP2Y = document.getElementById('exp-p2-y');
    const expP2Res = document.getElementById('exp-p2-res');

    function calc2() {
      const part = parseFloat(p2Part.value);
      const total = parseFloat(p2Total.value);
      if (isNaN(part) || isNaN(total)) {
        if (p2Result) p2Result.textContent = '--';
        if (expP2X) expP2X.textContent = '--';
        if (expP2Y) expP2Y.textContent = '--';
        if (expP2Res) expP2Res.textContent = '--';
        return;
      }
      if (p2Label) p2Label.textContent = `${part.toLocaleString()} is what % of ${total.toLocaleString()}?`;
      if (total === 0) {
        if (p2Result) p2Result.textContent = 'N/A';
        if (expP2X) expP2X.textContent = part.toString();
        if (expP2Y) expP2Y.textContent = '0';
        if (expP2Res) expP2Res.textContent = 'Undefined (Division by 0)';
        return;
      }
      const res = (part / total) * 100;
      const formatted = (Number.isInteger(res) ? res : res.toFixed(2)) + '%';
      if (p2Result) p2Result.textContent = formatted;
      if (expP2X) expP2X.textContent = part.toLocaleString();
      if (expP2Y) expP2Y.textContent = total.toLocaleString();
      if (expP2Res) expP2Res.textContent = formatted;
    }
    if (p2Part && p2Total) {
      p2Part.addEventListener('input', calc2);
      p2Total.addEventListener('input', calc2);
    }

    const p3V1 = document.getElementById('p3-v1');
    const p3V2 = document.getElementById('p3-v2');
    const p3Result = document.getElementById('p3-result');
    const p3Label = document.getElementById('p3-label');
    const expP3V2 = document.getElementById('exp-p3-v2');
    const expP3V1 = document.getElementById('exp-p3-v1');
    const expP3V1Base = document.getElementById('exp-p3-v1-base');
    const expP3Res = document.getElementById('exp-p3-res');

    function calc3() {
      const v1 = parseFloat(p3V1.value);
      const v2 = parseFloat(p3V2.value);
      if (isNaN(v1) || isNaN(v2)) {
        if (p3Result) p3Result.textContent = '--';
        if (expP3V2) expP3V2.textContent = '--';
        if (expP3V1) expP3V1.textContent = '--';
        if (expP3V1Base) expP3V1Base.textContent = '--';
        if (expP3Res) expP3Res.textContent = '--';
        return;
      }
      if (p3Label) p3Label.textContent = `% Change from ${v1.toLocaleString()} to ${v2.toLocaleString()}`;
      if (v1 === 0) {
        if (p3Result) p3Result.textContent = 'N/A';
        if (expP3V2) expP3V2.textContent = v2.toLocaleString();
        if (expP3V1) expP3V1.textContent = '0';
        if (expP3V1Base) expP3V1Base.textContent = '0';
        if (expP3Res) expP3Res.textContent = 'Undefined (Base is 0)';
        return;
      }
      const change = ((v2 - v1) / Math.abs(v1)) * 100;
      const formatted = (Number.isInteger(change) ? change : change.toFixed(2));
      const resText = (change >= 0 ? '+' : '') + formatted + '%';
      if (p3Result) {
        p3Result.textContent = resText;
        p3Result.className = `font-mono font-bold text-xl ${change >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400'}`;
      }
      if (expP3V2) expP3V2.textContent = v2.toLocaleString();
      if (expP3V1) expP3V1.textContent = v1.toLocaleString();
      if (expP3V1Base) expP3V1Base.textContent = Math.abs(v1).toLocaleString();
      if (expP3Res) {
        expP3Res.textContent = resText;
        expP3Res.className = change >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400';
      }
    }
    if (p3V1 && p3V2) {
      p3V1.addEventListener('input', calc3);
      p3V2.addEventListener('input', calc3);
    }

    calc1();
    calc2();
    calc3();
  })();
</script>
