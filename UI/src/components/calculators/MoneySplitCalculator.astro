---
/**
 * Money Split Interactive Calculator Component (dev-v.1.2 UX Refinements)
 * Stateful mini-application for managing group expenses, participants, and settlements.
 */
---

<div id="money-split-app" class="w-full space-y-6">

  <!-- TOP NAVIGATION ROW: MY GROUPS & NEW GROUP BUTTONS (TASK 1) -->
  <div id="ms-top-nav" class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <button id="ms-open-my-groups-btn" type="button" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-neutral-100 hover:bg-neutral-200 dark:bg-neutral-800 dark:hover:bg-neutral-700 text-neutral-900 dark:text-white font-mono text-xs sm:text-sm font-bold border border-neutral-300 dark:border-neutral-700 transition-all cursor-pointer shadow-2xs hover:shadow-xs">
        <span>📂</span>
        <span>My Groups</span>
        <span id="ms-total-groups-badge" class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-neutral-200 dark:bg-neutral-700 text-neutral-800 dark:text-neutral-200">
          0
        </span>
      </button>

      <button id="ms-new-group-btn" type="button" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-black text-white dark:bg-white dark:text-black font-mono text-xs sm:text-sm font-bold hover:opacity-90 transition-opacity cursor-pointer shadow-2xs">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        <span>+ New Group</span>
      </button>
    </div>
  </div>

  <!-- ACTIVE GROUP INFO & ACTIONS PANEL (TASK 1) -->
  <div id="ms-topbar" class="bg-white dark:bg-neutral-900/80 rounded-2xl p-4 sm:p-5 border border-neutral-200 dark:border-neutral-800 shadow-xs flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2.5 min-w-0">
      <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-lg border border-emerald-500/20 shrink-0">
        <span class="ms-curr-sym">₹</span>
      </div>
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <h2 id="ms-active-group-title" class="font-bold text-base sm:text-lg text-black dark:text-white tracking-tight truncate">
            Money Split
          </h2>
          <span id="ms-active-group-currency" class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 border border-neutral-300 dark:border-neutral-700 uppercase">
            INR
          </span>
        </div>
        <div id="ms-active-group-subtitle" class="text-xs text-neutral-500 dark:text-neutral-400 truncate">
          0 members • 0 expenses
        </div>
      </div>
    </div>

    <!-- Active Group Actions -->
    <div class="flex items-center gap-2">
      <button id="ms-share-btn" type="button" title="Share Group Link" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-neutral-100 hover:bg-neutral-200 dark:bg-neutral-800 dark:hover:bg-neutral-700 text-neutral-800 dark:text-neutral-200 font-mono text-xs font-bold border border-neutral-300 dark:border-neutral-700 transition-all cursor-pointer">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
        <span id="ms-share-btn-text">Share Group</span>
      </button>

      <button id="ms-delete-group-btn" type="button" title="Delete Group" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-neutral-500 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/40 border border-neutral-200 dark:border-neutral-800 hover:border-red-200 dark:hover:border-red-800/50 transition-colors cursor-pointer text-xs font-mono font-bold">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        <span>Delete</span>
      </button>
    </div>
  </div>

  <!-- VIEW 1: WELCOME / DASHBOARD (WHEN 0 GROUPS EXIST) -->
  <div id="ms-welcome-view" class="hidden bg-white dark:bg-neutral-900/60 rounded-3xl p-6 sm:p-10 border border-neutral-200 dark:border-neutral-800 text-center shadow-xs">
    <div class="max-w-md mx-auto space-y-6">
      <div class="w-16 h-16 rounded-3xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-3xl mx-auto border border-emerald-500/20 shadow-sm">
        💸
      </div>
      <div>
        <h3 class="text-2xl font-bold text-black dark:text-white tracking-tight">Create Your First Group</h3>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
          Split travel expenses, apartment rent, restaurant bills, and road trips with friends. 100% private, offline, and account-free.
        </p>
      </div>

      <form id="ms-create-group-form" class="space-y-4 text-left pt-2">
        <div>
          <label for="ms-new-group-name" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-semibold mb-1">
            Group Name
          </label>
          <input id="ms-new-group-name" type="text" placeholder="e.g., Goa Vacation, Apartment 4B, Office Lunch" required class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white text-sm font-semibold outline-none focus:ring-2 focus:ring-emerald-500" />
        </div>

        <div>
          <label for="ms-new-group-currency" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-semibold mb-1">
            Currency
          </label>
          <select id="ms-new-group-currency" class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white text-sm font-semibold outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer">
            <option value="INR">INR (₹) - Indian Rupee</option>
            <option value="USD">USD ($) - US Dollar</option>
            <option value="EUR">EUR (€) - Euro</option>
            <option value="GBP">GBP (£) - British Pound</option>
            <option value="JPY">JPY (¥) - Japanese Yen</option>
            <option value="CAD">CAD ($) - Canadian Dollar</option>
            <option value="AUD">AUD ($) - Australian Dollar</option>
          </select>
        </div>

        <button type="submit" class="w-full py-3 rounded-xl bg-black text-white dark:bg-white dark:text-black font-mono text-sm font-bold hover:opacity-90 transition-opacity cursor-pointer shadow-sm">
          Create Group & Start Splitting →
        </button>
      </form>
    </div>
  </div>

  <!-- VIEW 2: ACTIVE GROUP WORKSPACE -->
  <div id="ms-group-view" class="space-y-6">

    <!-- PARTICIPANTS SECTION -->
    <div class="bg-white dark:bg-neutral-900/60 rounded-2xl p-5 border border-neutral-200 dark:border-neutral-800 shadow-xs space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono uppercase tracking-wider font-bold text-neutral-700 dark:text-neutral-300">
            Group Participants
          </span>
          <span id="ms-participant-count-badge" class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-700">
            0
          </span>
        </div>
        <span class="text-[11px] text-neutral-500 dark:text-neutral-400 font-mono">Min. 2 members required to split bills</span>
      </div>

      <!-- Participant Chips -->
      <div id="ms-participants-list" class="flex flex-wrap gap-2">
        <!-- Injected dynamically via JS -->
      </div>

      <!-- Add Participant Form -->
      <form id="ms-add-participant-form" class="flex items-center gap-2 pt-2">
        <input id="ms-add-participant-input" type="text" placeholder="Add participant name (e.g. Lakshya)" class="flex-1 px-3.5 py-2 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white text-xs sm:text-sm font-semibold outline-none focus:ring-2 focus:ring-emerald-500" />
        <button type="submit" class="px-4 py-2 rounded-xl bg-black text-white dark:bg-white dark:text-black font-mono text-xs sm:text-sm font-bold hover:opacity-90 cursor-pointer shadow-2xs">
          + Add Member
        </button>
      </form>

      <!-- Alert box for participant errors (e.g. duplicate name, deletion blocked) -->
      <div id="ms-participant-alert" class="hidden text-xs text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/40 p-3 rounded-xl border border-amber-200 dark:border-amber-800/60 font-mono">
      </div>
    </div>

    <!-- MAIN TWO-COLUMN SPLIT: EXPENSE FORM + SETTLEMENT BALANCES -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- LEFT COLUMN: EXPENSE ENTRY / EDIT FORM (7 COLS) -->
      <div class="lg:col-span-7 bg-white dark:bg-neutral-900/60 rounded-2xl p-5 sm:p-6 border border-neutral-200 dark:border-neutral-800 shadow-xs space-y-5">
        <div class="flex items-center justify-between border-b border-neutral-200 dark:border-neutral-800 pb-3">
          <div class="flex items-center gap-2">
            <span class="text-lg">🧾</span>
            <h3 id="ms-expense-form-title" class="font-bold text-base text-black dark:text-white tracking-tight">
              Add New Expense
            </h3>
          </div>
          <button id="ms-cancel-edit-btn" type="button" class="hidden text-xs font-mono text-neutral-500 hover:text-red-500 font-bold underline cursor-pointer">
            Cancel Edit
          </button>
        </div>

        <form id="ms-expense-form" class="space-y-4">
          <!-- Description -->
          <div>
            <label for="ms-exp-desc" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-semibold mb-1">
              Expense Description
            </label>
            <input id="ms-exp-desc" type="text" placeholder="e.g., Dinner, Fuel, Groceries, Hotel Room" required class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white text-sm font-semibold outline-none focus:ring-2 focus:ring-emerald-500" />
          </div>

          <!-- Amount & Paid By Row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="ms-exp-amount" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-semibold mb-1">
                Total Amount (<span class="ms-curr-sym">₹</span>)
              </label>
              <input id="ms-exp-amount" type="number" min="0.01" step="any" placeholder="0.00" required class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white text-sm font-bold outline-none focus:ring-2 focus:ring-emerald-500 tabular-nums" />
            </div>

            <div>
              <label for="ms-exp-payer" class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-semibold mb-1">
                Paid By
              </label>
              <select id="ms-exp-payer" required class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white text-sm font-semibold outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer">
                <!-- Injected via JS -->
              </select>
            </div>
          </div>

          <!-- Split Method Selector -->
          <div class="space-y-2 pt-1">
            <label class="block text-xs font-mono text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-semibold">
              Split Method
            </label>
            <div class="grid grid-cols-3 gap-2 bg-neutral-100 dark:bg-neutral-800/80 p-1 rounded-xl border border-neutral-200 dark:border-neutral-700/80">
              <button type="button" data-method="equal" class="ms-method-tab py-1.5 text-xs font-mono font-bold rounded-lg transition-all cursor-pointer bg-white dark:bg-neutral-900 text-black dark:text-white shadow-2xs">
                = Equal
              </button>
              <button type="button" data-method="percentage" class="ms-method-tab py-1.5 text-xs font-mono font-bold rounded-lg transition-all cursor-pointer text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white">
                % Percentage
              </button>
              <button type="button" data-method="exact" class="ms-method-tab py-1.5 text-xs font-mono font-bold rounded-lg transition-all cursor-pointer text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white">
                123 Exact
              </button>
            </div>
          </div>

          <!-- Participants Selection & Allocations List -->
          <div class="space-y-2 pt-1">
            <div class="flex items-center justify-between text-xs font-mono">
              <span class="text-neutral-700 dark:text-neutral-400 uppercase tracking-wider font-semibold">
                Split Among Participants
              </span>
              <div class="flex items-center gap-2">
                <button type="button" id="ms-select-all-btn" class="text-emerald-600 dark:text-emerald-400 hover:underline font-bold cursor-pointer">Select All</button>
                <span class="text-neutral-400">|</span>
                <button type="button" id="ms-deselect-all-btn" class="text-neutral-500 hover:underline cursor-pointer">Deselect All</button>
              </div>
            </div>

            <!-- Dynamic Participant Allocation Rows -->
            <div id="ms-allocation-rows" class="space-y-2 max-h-64 overflow-y-auto pr-1">
              <!-- Injected dynamically via JS -->
            </div>

            <!-- Allocation Summary / Live Validation Status -->
            <div id="ms-allocation-status" class="p-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/60 border border-neutral-200 dark:border-neutral-700/60 text-xs font-mono flex items-center justify-between">
              <span id="ms-status-label" class="text-neutral-600 dark:text-neutral-400">Equal split among selected</span>
              <span id="ms-status-val" class="font-bold text-black dark:text-white">0.00 / person</span>
            </div>
          </div>

          <!-- Submit Button -->
          <button id="ms-submit-expense-btn" type="submit" class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-mono text-xs sm:text-sm font-bold transition-all cursor-pointer shadow-sm">
            Save Expense
          </button>
        </form>
      </div>

      <!-- RIGHT COLUMN: SETTLEMENT BALANCES & SUMMARY (5 COLS) -->
      <div class="lg:col-span-5 space-y-6">

        <!-- Total Spent & Net Settlement Summary Card -->
        <div class="bg-neutral-50 dark:bg-neutral-950 rounded-2xl p-5 border border-neutral-200 dark:border-neutral-800 space-y-4 shadow-xs">
          <div class="flex items-center justify-between pb-3 border-b border-neutral-200 dark:border-neutral-800">
            <div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-500 font-bold block">Total Group Spend</span>
              <div id="ms-total-spend-display" class="text-2xl sm:text-3xl font-black text-black dark:text-white tabular-nums">
                <span class="ms-curr-sym">₹</span>0.00
              </div>
            </div>
            <div class="text-right">
              <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-500 font-bold block">Expenses</span>
              <span id="ms-expense-count-display" class="font-mono font-bold text-base text-neutral-800 dark:text-neutral-200">
                0 bills
              </span>
            </div>
          </div>

          <!-- Balances List -->
          <div class="space-y-2">
            <div class="text-xs font-mono uppercase tracking-wider font-bold text-neutral-700 dark:text-neutral-300">
              Settlement Ledger
            </div>
            <div id="ms-balances-list" class="space-y-2 max-h-72 overflow-y-auto pr-1">
              <!-- Injected via JS -->
            </div>
          </div>

          <!-- Copy Summary Action -->
          <div class="pt-2 border-t border-neutral-200 dark:border-neutral-800 flex items-center gap-2">
            <button id="ms-copy-summary-btn" type="button" class="flex-1 py-2.5 rounded-xl bg-neutral-200 dark:bg-neutral-800 hover:bg-neutral-300 dark:hover:bg-neutral-700 text-neutral-900 dark:text-white font-mono text-xs font-bold transition-all cursor-pointer flex items-center justify-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-neutral-600 dark:text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
              <span id="ms-copy-summary-text">Copy WhatsApp Summary</span>
            </button>
          </div>
        </div>

      </div>
    </div>

    <!-- RECORDED EXPENSES LEDGER SECTION (TASK 3: RENAMED TO EXPENSE HISTORY) -->
    <div id="ms-expense-history-section" class="bg-white dark:bg-neutral-900/60 rounded-2xl p-5 sm:p-6 border border-neutral-200 dark:border-neutral-800 shadow-xs space-y-4">
      <div class="flex items-center justify-between border-b border-neutral-200 dark:border-neutral-800 pb-3">
        <div class="flex items-center gap-2">
          <h3 class="font-bold text-base text-black dark:text-white tracking-tight">
            Expense History
          </h3>
          <span id="ms-expense-badge" class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 border border-neutral-300 dark:border-neutral-700">
            0
          </span>
        </div>
      </div>

      <!-- Expense Cards List -->
      <div id="ms-expenses-list" class="space-y-3">
        <!-- Injected via JS -->
      </div>

      <!-- Expansion Toggle (Collapsible Expense History - Money Split v1.3) -->
      <div id="ms-expenses-toggle-wrapper" class="hidden pt-2 border-t border-neutral-200 dark:border-neutral-800 text-center">
        <button
          type="button"
          id="ms-expenses-toggle-btn"
          class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl text-xs font-mono font-bold text-neutral-700 hover:text-black dark:text-neutral-300 dark:hover:text-white bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 border border-neutral-200 dark:border-neutral-700 cursor-pointer transition-colors shadow-2xs active:scale-95"
        >
          <span id="ms-expenses-toggle-text">↓ Show More Expenses</span>
        </button>
      </div>
    </div>

  </div>

  <!-- TASK 1: MY GROUPS MODAL -->
  <div id="ms-my-groups-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="ms-my-groups-modal-title">
    <div class="bg-white dark:bg-neutral-900 rounded-3xl p-6 sm:p-7 max-w-lg w-full border border-neutral-200 dark:border-neutral-800 shadow-2xl space-y-5 animate-in fade-in zoom-in-95 duration-150 max-h-[90vh] flex flex-col">
      <div class="flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2.5">
          <span class="text-xl">📂</span>
          <div>
            <h3 id="ms-my-groups-modal-title" class="font-bold text-lg text-black dark:text-white">My Groups</h3>
            <p class="text-xs text-neutral-500 font-mono">Switch between your saved expense groups</p>
          </div>
        </div>
        <button id="ms-close-my-groups-btn" type="button" aria-label="Close modal" class="text-neutral-400 hover:text-black dark:hover:text-white text-lg font-bold cursor-pointer p-1">✕</button>
      </div>

      <!-- Groups List Scrollable Container -->
      <div id="ms-my-groups-list" class="space-y-2.5 overflow-y-auto flex-1 pr-1 max-h-80">
        <!-- Injected dynamically via JS -->
      </div>

      <!-- Footer Actions -->
      <div class="pt-3 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between gap-3 shrink-0">
        <button id="ms-my-groups-create-btn" type="button" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-black text-white dark:bg-white dark:text-black font-mono text-xs font-bold hover:opacity-90 cursor-pointer shadow-2xs">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span>Create New Group</span>
        </button>
        <button id="ms-my-groups-close-bottom-btn" type="button" class="px-4 py-2.5 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs font-bold text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 cursor-pointer">
          Close
        </button>
      </div>
    </div>
  </div>

  <!-- TASK 2: DELETE GROUP CONFIRMATION MODAL -->
  <div id="ms-delete-group-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="ms-del-group-modal-title">
    <div class="bg-white dark:bg-neutral-900 rounded-3xl p-6 sm:p-7 max-w-md w-full border border-neutral-200 dark:border-neutral-800 shadow-2xl space-y-4 animate-in fade-in zoom-in-95 duration-150">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-red-500/10 text-red-600 dark:text-red-400 flex items-center justify-center font-bold text-xl border border-red-500/20 shrink-0">
          🗑️
        </div>
        <div>
          <h3 id="ms-del-group-modal-title" class="font-bold text-lg text-black dark:text-white">Delete Group?</h3>
          <p class="text-xs text-neutral-500 font-mono">Permanent removal</p>
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-neutral-800/60 border border-neutral-200 dark:border-neutral-700 space-y-2 text-xs font-mono">
        <p class="text-neutral-800 dark:text-neutral-200 leading-relaxed">
          Are you sure you want to permanently delete "<strong id="ms-del-group-target-name" class="text-black dark:text-white font-bold"></strong>" and all associated expenses?
        </p>
        <p class="text-red-600 dark:text-red-400 font-bold text-[11px]">
          ⚠️ This action cannot be undone.
        </p>
      </div>

      <div class="flex gap-3 pt-1">
        <button id="ms-cancel-del-group-btn" type="button" class="flex-1 py-2.5 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs font-bold text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 cursor-pointer">
          Cancel
        </button>
        <button id="ms-confirm-del-group-btn" type="button" class="flex-1 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-mono text-xs font-bold transition-colors cursor-pointer shadow-sm">
          Delete Group
        </button>
      </div>
    </div>
  </div>

  <!-- TASK 2: DELETE EXPENSE CONFIRMATION MODAL -->
  <div id="ms-delete-expense-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="ms-del-expense-modal-title">
    <div class="bg-white dark:bg-neutral-900 rounded-3xl p-6 sm:p-7 max-w-md w-full border border-neutral-200 dark:border-neutral-800 shadow-2xl space-y-4 animate-in fade-in zoom-in-95 duration-150">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-red-500/10 text-red-600 dark:text-red-400 flex items-center justify-center font-bold text-xl border border-red-500/20 shrink-0">
          🗑️
        </div>
        <div>
          <h3 id="ms-del-expense-modal-title" class="font-bold text-lg text-black dark:text-white">Delete Expense?</h3>
          <p class="text-xs text-neutral-500 font-mono">Remove expense from ledger</p>
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-neutral-800/60 border border-neutral-200 dark:border-neutral-700 space-y-2 text-xs font-mono">
        <p class="text-neutral-800 dark:text-neutral-200 leading-relaxed">
          Delete "<strong id="ms-del-exp-target-desc" class="text-black dark:text-white font-bold"></strong>"?
        </p>
        <p class="text-red-600 dark:text-red-400 font-bold text-[11px]">
          ⚠️ This action cannot be undone.
        </p>
      </div>

      <div class="flex gap-3 pt-1">
        <button id="ms-cancel-del-exp-btn" type="button" class="flex-1 py-2.5 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs font-bold text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 cursor-pointer">
          Cancel
        </button>
        <button id="ms-confirm-del-exp-btn" type="button" class="flex-1 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-mono text-xs font-bold transition-colors cursor-pointer shadow-sm">
          Delete Expense
        </button>
      </div>
    </div>
  </div>

  <!-- IMPORT CONFIRMATION MODAL -->
  <div id="ms-import-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="ms-import-modal-title">
    <div class="bg-white dark:bg-neutral-900 rounded-3xl p-6 sm:p-8 max-w-md w-full border border-neutral-200 dark:border-neutral-800 shadow-2xl space-y-5 animate-in fade-in zoom-in-95 duration-150">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-xl border border-blue-500/20 shrink-0">
          📥
        </div>
        <div>
          <h3 id="ms-import-modal-title" class="font-bold text-lg text-black dark:text-white">Import Shared Group</h3>
          <p class="text-xs text-neutral-500 font-mono">A group ledger was shared with you</p>
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-neutral-800/60 border border-neutral-200 dark:border-neutral-700 space-y-2 text-xs font-mono">
        <div class="flex justify-between">
          <span class="text-neutral-500">Group Name:</span>
          <span id="ms-import-name" class="font-bold text-black dark:text-white truncate max-w-[180px]"></span>
        </div>
        <div class="flex justify-between">
          <span class="text-neutral-500">Currency:</span>
          <span id="ms-import-currency" class="font-bold text-black dark:text-white"></span>
        </div>
        <div class="flex justify-between">
          <span class="text-neutral-500">Members:</span>
          <span id="ms-import-members" class="font-bold text-black dark:text-white"></span>
        </div>
        <div class="flex justify-between">
          <span class="text-neutral-500">Expenses:</span>
          <span id="ms-import-expenses" class="font-bold text-black dark:text-white"></span>
        </div>
      </div>

      <div id="ms-import-conflict-msg" class="hidden text-xs text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/40 p-3 rounded-xl border border-amber-200 dark:border-amber-800/60 font-mono">
        ⚠️ A group with this name or ID already exists on your device.
      </div>

      <!-- Action Buttons -->
      <div id="ms-import-standard-actions" class="flex gap-3">
        <button id="ms-import-cancel-btn" type="button" class="flex-1 py-2.5 rounded-xl border border-neutral-300 dark:border-neutral-700 font-mono text-xs font-bold text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 cursor-pointer">
          Cancel
        </button>
        <button id="ms-import-confirm-btn" type="button" class="flex-1 py-2.5 rounded-xl bg-black text-white dark:bg-white dark:text-black font-mono text-xs font-bold hover:opacity-90 cursor-pointer">
          Import Group
        </button>
      </div>

      <div id="ms-import-conflict-actions" class="hidden flex flex-col gap-2">
        <button id="ms-import-replace-btn" type="button" class="w-full py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-mono text-xs font-bold cursor-pointer">
          Update / Overwrite Existing
        </button>
        <button id="ms-import-copy-btn" type="button" class="w-full py-2.5 rounded-xl bg-black text-white dark:bg-white dark:text-black font-mono text-xs font-bold hover:opacity-90 cursor-pointer">
          Save as Separate Copy
        </button>
        <button id="ms-import-conflict-cancel-btn" type="button" class="w-full py-2 text-neutral-500 font-mono text-xs hover:underline cursor-pointer">
          Cancel
        </button>
      </div>
    </div>
  </div>

  <!-- CREATE NEW GROUP MODAL -->
  <div id="ms-new-group-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="ms-new-group-modal-title">
    <div class="bg-white dark:bg-neutral-900 rounded-3xl p-6 max-w-sm w-full border border-neutral-200 dark:border-neutral-800 shadow-2xl space-y-4 animate-in fade-in zoom-in-95 duration-150">
      <div class="flex items-center justify-between">
        <h3 id="ms-new-group-modal-title" class="font-bold text-base text-black dark:text-white">Create New Group</h3>
        <button id="ms-close-group-modal-btn" type="button" aria-label="Close modal" class="text-neutral-400 hover:text-black dark:hover:text-white text-sm font-bold cursor-pointer">✕</button>
      </div>

      <form id="ms-modal-create-group-form" class="space-y-4 text-xs font-mono">
        <div>
          <label for="ms-modal-group-name" class="block uppercase tracking-wider font-semibold mb-1 text-neutral-700 dark:text-neutral-300">Group Name</label>
          <input id="ms-modal-group-name" type="text" placeholder="e.g., Road Trip, Flat 102, Dinner Club" required class="w-full px-3 py-2 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white text-xs font-semibold outline-none focus:ring-2 focus:ring-emerald-500" />
        </div>

        <div>
          <label for="ms-modal-group-currency" class="block uppercase tracking-wider font-semibold mb-1 text-neutral-700 dark:text-neutral-300">Currency</label>
          <select id="ms-modal-group-currency" class="w-full px-3 py-2 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white text-xs font-semibold outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer">
            <option value="INR">INR (₹) - Indian Rupee</option>
            <option value="USD">USD ($) - US Dollar</option>
            <option value="EUR">EUR (€) - Euro</option>
            <option value="GBP">GBP (£) - British Pound</option>
            <option value="JPY">JPY (¥) - Japanese Yen</option>
            <option value="CAD">CAD ($) - Canadian Dollar</option>
            <option value="AUD">AUD ($) - Australian Dollar</option>
          </select>
        </div>

        <button type="submit" class="w-full py-2.5 rounded-xl bg-black text-white dark:bg-white dark:text-black font-bold hover:opacity-90 cursor-pointer">
          Create Group
        </button>
      </form>
    </div>
  </div>

</div>

<!-- CLIENT CONTROLLER SCRIPT -->
<script>
  import type { Group, Participant, Expense, SplitMethod, Allocation } from '../../utils/moneySplit/types';
  import {
    loadAllGroups,
    saveGroup,
    deleteGroup,
    getActiveGroupId,
    setActiveGroupId,
    createGroup,
    addParticipant,
    canDeleteParticipant,
    deleteParticipant,
    addExpense,
    updateExpense,
    deleteExpense
  } from '../../utils/moneySplit/persistence';
  import {
    calculateEqualSplitAllocations,
    calculatePercentageSplitAllocations,
    calculateExactSplitAllocations,
    validateExpenseAllocations,
    calculateGroupBalances,
    calculateTotalSpending,
    generateSettlementSummary,
    getCurrencySymbol
  } from '../../lib/calculators/moneySplit';
  import {
    deserializeGroupFromShare,
    detectGroupConflict,
    generateGroupShareUrl,
    importGroupIntoStorage,
    shareGroupLink
  } from '../../utils/moneySplit/sharing';
  import { copyToClipboard } from '../../utils/share';

  (function initMoneySplit() {
    // DOM Elements
    const appEl = document.getElementById('money-split-app');
    if (!appEl) return;

    // Top Navigation & Active Group Panel
    const topNav = document.getElementById('ms-top-nav');
    const openMyGroupsBtn = document.getElementById('ms-open-my-groups-btn');
    const totalGroupsBadge = document.getElementById('ms-total-groups-badge');
    const newGroupBtn = document.getElementById('ms-new-group-btn');

    const topBar = document.getElementById('ms-topbar');
    const activeGroupTitle = document.getElementById('ms-active-group-title');
    const activeGroupCurrency = document.getElementById('ms-active-group-currency');
    const activeGroupSubtitle = document.getElementById('ms-active-group-subtitle');
    const shareBtn = document.getElementById('ms-share-btn');
    const shareBtnText = document.getElementById('ms-share-btn-text');
    const deleteGroupBtn = document.getElementById('ms-delete-group-btn');

    const welcomeView = document.getElementById('ms-welcome-view');
    const groupView = document.getElementById('ms-group-view');
    const createGroupForm = document.getElementById('ms-create-group-form') as HTMLFormElement | null;
    const newGroupNameInput = document.getElementById('ms-new-group-name') as HTMLInputElement | null;
    const newGroupCurrencySelect = document.getElementById('ms-new-group-currency') as HTMLSelectElement | null;

    const participantsList = document.getElementById('ms-participants-list');
    const participantCountBadge = document.getElementById('ms-participant-count-badge');
    const addParticipantForm = document.getElementById('ms-add-participant-form') as HTMLFormElement | null;
    const addParticipantInput = document.getElementById('ms-add-participant-input') as HTMLInputElement | null;
    const participantAlert = document.getElementById('ms-participant-alert');

    const expenseForm = document.getElementById('ms-expense-form') as HTMLFormElement | null;
    const expenseFormTitle = document.getElementById('ms-expense-form-title');
    const cancelEditBtn = document.getElementById('ms-cancel-edit-btn');
    const expDescInput = document.getElementById('ms-exp-desc') as HTMLInputElement | null;
    const expAmountInput = document.getElementById('ms-exp-amount') as HTMLInputElement | null;
    const expPayerSelect = document.getElementById('ms-exp-payer') as HTMLSelectElement | null;
    const methodTabs = document.querySelectorAll('.ms-method-tab');
    const selectAllBtn = document.getElementById('ms-select-all-btn');
    const deselectAllBtn = document.getElementById('ms-deselect-all-btn');
    const allocationRows = document.getElementById('ms-allocation-rows');
    const statusLabel = document.getElementById('ms-status-label');
    const statusVal = document.getElementById('ms-status-val');

    const totalSpendDisplay = document.getElementById('ms-total-spend-display');
    const expenseCountDisplay = document.getElementById('ms-expense-count-display');
    const balancesList = document.getElementById('ms-balances-list');
    const copySummaryBtn = document.getElementById('ms-copy-summary-btn');
    const copySummaryText = document.getElementById('ms-copy-summary-text');
    const expensesList = document.getElementById('ms-expenses-list');
    const expenseBadge = document.getElementById('ms-expense-badge');
    const expensesToggleWrapper = document.getElementById('ms-expenses-toggle-wrapper');
    const expensesToggleBtn = document.getElementById('ms-expenses-toggle-btn');
    const expensesToggleText = document.getElementById('ms-expenses-toggle-text');
    const expenseHistorySection = document.getElementById('ms-expense-history-section');

    // Modals
    const myGroupsModal = document.getElementById('ms-my-groups-modal');
    const myGroupsList = document.getElementById('ms-my-groups-list');
    const closeMyGroupsBtn = document.getElementById('ms-close-my-groups-btn');
    const myGroupsCreateBtn = document.getElementById('ms-my-groups-create-btn');
    const myGroupsCloseBottomBtn = document.getElementById('ms-my-groups-close-bottom-btn');

    const deleteGroupModal = document.getElementById('ms-delete-group-modal');
    const delGroupTargetName = document.getElementById('ms-del-group-target-name');
    const cancelDelGroupBtn = document.getElementById('ms-cancel-del-group-btn');
    const confirmDelGroupBtn = document.getElementById('ms-confirm-del-group-btn');

    const deleteExpenseModal = document.getElementById('ms-delete-expense-modal');
    const delExpTargetDesc = document.getElementById('ms-del-exp-target-desc');
    const cancelDelExpBtn = document.getElementById('ms-cancel-del-exp-btn');
    const confirmDelExpBtn = document.getElementById('ms-confirm-del-exp-btn');

    const importModal = document.getElementById('ms-import-modal');
    const importNameEl = document.getElementById('ms-import-name');
    const importCurrencyEl = document.getElementById('ms-import-currency');
    const importMembersEl = document.getElementById('ms-import-members');
    const importExpensesEl = document.getElementById('ms-import-expenses');
    const importConflictMsg = document.getElementById('ms-import-conflict-msg');
    const importStandardActions = document.getElementById('ms-import-standard-actions');
    const importConflictActions = document.getElementById('ms-import-conflict-actions');
    const importConfirmBtn = document.getElementById('ms-import-confirm-btn');
    const importCancelBtn = document.getElementById('ms-import-cancel-btn');
    const importReplaceBtn = document.getElementById('ms-import-replace-btn');
    const importCopyBtn = document.getElementById('ms-import-copy-btn');
    const importConflictCancelBtn = document.getElementById('ms-import-conflict-cancel-btn');

    const newGroupModal = document.getElementById('ms-new-group-modal');
    const closeGroupModalBtn = document.getElementById('ms-close-group-modal-btn');
    const modalCreateGroupForm = document.getElementById('ms-modal-create-group-form') as HTMLFormElement | null;
    const modalGroupNameInput = document.getElementById('ms-modal-group-name') as HTMLInputElement | null;
    const modalGroupCurrencySelect = document.getElementById('ms-modal-group-currency') as HTMLSelectElement | null;

    // Component State
    let activeGroup: Group | null = null;
    let currentSplitMethod: SplitMethod = 'equal';
    let editingExpenseId: string | null = null;
    let pendingDeleteExpenseId: string | null = null;
    let pendingImportPayload: { v: number; group: Group } | null = null;
    let isExpensesExpanded = false;

    // Helper: Open / Close Modal
    function openModal(modal: HTMLElement | null) {
      if (modal) modal.classList.remove('hidden');
    }

    function closeModal(modal: HTMLElement | null) {
      if (modal) modal.classList.add('hidden');
    }

    // 1. Initial Launch / State Restoration
    function refresh() {
      const groups = loadAllGroups();
      let activeId = getActiveGroupId();

      if (totalGroupsBadge) {
        totalGroupsBadge.textContent = String(groups.length);
      }

      if (groups.length === 0) {
        activeGroup = null;
        renderWelcomeView();
        return;
      }

      activeGroup = groups.find(g => g.id === activeId) || groups[0];
      setActiveGroupId(activeGroup.id);
      renderActiveGroup();
    }

    function renderWelcomeView() {
      if (welcomeView) welcomeView.classList.remove('hidden');
      if (groupView) groupView.classList.add('hidden');
      if (topBar) topBar.classList.add('hidden');
    }

    function renderActiveGroup() {
      if (!activeGroup) return;

      if (welcomeView) welcomeView.classList.add('hidden');
      if (groupView) groupView.classList.remove('hidden');
      if (topBar) topBar.classList.remove('hidden');

      const currSym = getCurrencySymbol(activeGroup.currency);
      document.querySelectorAll('.ms-curr-sym').forEach(el => {
        el.textContent = currSym;
      });

      if (activeGroupTitle) activeGroupTitle.textContent = activeGroup.name;
      if (activeGroupCurrency) activeGroupCurrency.textContent = activeGroup.currency;
      if (activeGroupSubtitle) {
        const pCount = activeGroup.participants.length;
        const eCount = activeGroup.expenses.length;
        activeGroupSubtitle.textContent = `${pCount} member${pCount === 1 ? '' : 's'} • ${eCount} expense${eCount === 1 ? '' : 's'}`;
      }

      renderParticipants();
      renderPayerOptions();
      renderAllocationRows();
      renderExpensesList();
      renderBalances();
    }

    // 2. Render My Groups Modal (Task 1)
    function renderMyGroupsModal() {
      if (!myGroupsList) return;
      const groups = loadAllGroups();

      if (groups.length === 0) {
        myGroupsList.innerHTML = `
          <div class="text-center py-8 text-neutral-500 dark:text-neutral-400 font-mono text-xs space-y-2">
            <span class="text-2xl block">📂</span>
            <p>No saved groups yet.</p>
          </div>
        `;
        return;
      }

      myGroupsList.innerHTML = groups.map(g => {
        const isActive = g.id === activeGroup?.id;
        const currSym = getCurrencySymbol(g.currency);
        const pCount = g.participants.length;
        const eCount = g.expenses.length;

        return `
          <div class="flex items-center justify-between p-3.5 rounded-2xl ${isActive ? 'bg-emerald-50/70 dark:bg-emerald-950/30 border-2 border-emerald-500/50' : 'bg-neutral-50 dark:bg-neutral-800/60 border border-neutral-200 dark:border-neutral-700/60 hover:border-neutral-300 dark:hover:border-neutral-600'} transition-all">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-9 h-9 rounded-xl ${isActive ? 'bg-emerald-500 text-white font-black' : 'bg-neutral-200 dark:bg-neutral-700 text-neutral-800 dark:text-neutral-200 font-bold'} flex items-center justify-center text-sm shrink-0">
                ${currSym}
              </div>
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-sm text-black dark:text-white truncate">${g.name}</span>
                  <span class="text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-neutral-200 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-300">${g.currency}</span>
                </div>
                <div class="text-xs text-neutral-500 font-mono mt-0.5">
                  ${pCount} member${pCount === 1 ? '' : 's'} • ${eCount} expense${eCount === 1 ? '' : 's'}
                </div>
              </div>
            </div>

            <div class="shrink-0 ml-3">
              ${isActive ? `
                <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 font-mono text-xs font-bold border border-emerald-500/30">
                  <span>✓</span>
                  <span>Active</span>
                </span>
              ` : `
                <button type="button" data-open-group="${g.id}" class="px-3.5 py-1.5 rounded-xl bg-black text-white dark:bg-white dark:text-black font-mono text-xs font-bold hover:opacity-90 cursor-pointer shadow-2xs transition-opacity">
                  Open →
                </button>
              `}
            </div>
          </div>
        `;
      }).join('');

      // Wire up Open Group buttons
      myGroupsList.querySelectorAll('[data-open-group]').forEach(btn => {
        btn.addEventListener('click', () => {
          const gId = btn.getAttribute('data-open-group');
          if (gId) {
            isExpensesExpanded = false;
            setActiveGroupId(gId);
            closeModal(myGroupsModal);
            refresh();
          }
        });
      });
    }

    // 3. Render Participant Chips
    function renderParticipants() {
      if (!activeGroup || !participantsList) return;

      if (participantCountBadge) {
        participantCountBadge.textContent = String(activeGroup.participants.length);
      }

      if (activeGroup.participants.length === 0) {
        participantsList.innerHTML = '<span class="text-xs text-neutral-400 font-mono italic">No participants yet. Add at least 2 members below.</span>';
        return;
      }

      participantsList.innerHTML = activeGroup.participants.map(p => {
        const canDel = canDeleteParticipant(activeGroup!.id, p.id);
        return `
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-neutral-100 dark:bg-neutral-800 text-neutral-900 dark:text-neutral-100 border border-neutral-300 dark:border-neutral-700 text-xs font-mono font-semibold shadow-2xs">
            <span>👤</span>
            <span>${p.name}</span>
            <button 
              type="button" 
              data-del-participant="${p.id}" 
              class="ml-1 text-neutral-400 hover:text-red-500 dark:hover:text-red-400 text-sm font-bold cursor-pointer transition-colors"
              title="${canDel ? 'Remove participant' : 'Cannot remove participant (assigned to expenses)'}"
            >
              ×
            </button>
          </div>
        `;
      }).join('');

      // Bind participant delete handlers
      participantsList.querySelectorAll('[data-del-participant]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const pId = btn.getAttribute('data-del-participant');
          if (!pId || !activeGroup) return;

          const pObj = activeGroup.participants.find(p => p.id === pId);
          const pName = pObj ? pObj.name : 'member';

          const res = deleteParticipant(activeGroup.id, pId);
          if (!res.success) {
            showParticipantAlert(res.error || `Cannot remove "${pName}" because they are involved in existing expenses.`);
            return;
          }

          hideParticipantAlert();
          refresh();
        });
      });
    }

    function showParticipantAlert(msg: string) {
      if (participantAlert) {
        participantAlert.textContent = `⚠️ ${msg}`;
        participantAlert.classList.remove('hidden');
        setTimeout(hideParticipantAlert, 4000);
      }
    }

    function hideParticipantAlert() {
      if (participantAlert) participantAlert.classList.add('hidden');
    }

    // 4. Render Payer Options
    function renderPayerOptions() {
      if (!activeGroup || !expPayerSelect) return;
      const currentVal = expPayerSelect.value;
      expPayerSelect.innerHTML = `
        <option value="">Select payer...</option>
        ${activeGroup.participants.map(p => `
          <option value="${p.id}" ${p.id === currentVal ? 'selected' : ''}>${p.name}</option>
        `).join('')}
      `;
    }

    // 5. Render Allocation Rows
    function renderAllocationRows() {
      if (!activeGroup || !allocationRows) return;

      if (activeGroup.participants.length === 0) {
        allocationRows.innerHTML = '<div class="text-xs text-neutral-400 font-mono py-2">Add group participants first.</div>';
        return;
      }

      allocationRows.innerHTML = activeGroup.participants.map(p => {
        return `
          <div class="flex items-center justify-between gap-3 p-2.5 rounded-xl bg-neutral-50 dark:bg-neutral-800/40 border border-neutral-200 dark:border-neutral-700/60 text-xs font-mono" data-p-row="${p.id}">
            <label class="flex items-center gap-2 cursor-pointer select-none min-w-0">
              <input type="checkbox" data-p-check="${p.id}" checked class="rounded text-emerald-600 focus:ring-emerald-500 w-4 h-4 cursor-pointer" />
              <span class="font-bold text-neutral-900 dark:text-neutral-100 truncate">${p.name}</span>
            </label>
            
            <div class="flex items-center gap-2">
              <!-- Equal Split Share Preview -->
              <span class="ms-share-preview font-bold text-neutral-700 dark:text-neutral-300 tabular-nums" data-p-share="${p.id}">
                0.00
              </span>

              <!-- Percentage / Exact Inputs -->
              <div class="ms-alloc-input-wrap hidden flex items-center gap-1">
                <input 
                  type="number" 
                  step="any" 
                  min="0" 
                  placeholder="0" 
                  data-p-alloc="${p.id}" 
                  class="w-20 px-2 py-1 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white font-bold text-right outline-none focus:ring-2 focus:ring-emerald-500 tabular-nums" 
                />
                <span class="ms-alloc-unit font-bold text-neutral-500">%</span>
              </div>
            </div>
          </div>
        `;
      }).join('');

      // Add change listeners
      allocationRows.querySelectorAll('[data-p-check]').forEach(chk => {
        chk.addEventListener('change', updateAllocationPreview);
      });

      allocationRows.querySelectorAll('[data-p-alloc]').forEach(inp => {
        inp.addEventListener('input', updateAllocationPreview);
      });

      updateAllocationPreview();
    }

    // Update Live Allocation Calculations & UI Mode
    function updateAllocationPreview() {
      if (!activeGroup) return;

      const totalAmt = parseFloat(expAmountInput?.value || '0') || 0;
      const checkedPIds: string[] = [];
      allocationRows?.querySelectorAll<HTMLInputElement>('[data-p-check]:checked').forEach(c => {
        const id = c.getAttribute('data-p-check');
        if (id) checkedPIds.push(id);
      });

      const allocs: Allocation[] = [];
      allocationRows?.querySelectorAll<HTMLInputElement>('[data-p-alloc]').forEach(inp => {
        const pId = inp.getAttribute('data-p-alloc');
        const val = parseFloat(inp.value || '0') || 0;
        if (pId && checkedPIds.includes(pId)) {
          allocs.push({ participantId: pId, value: val });
        }
      });

      const currSym = getCurrencySymbol(activeGroup.currency);

      if (currentSplitMethod === 'equal') {
        const shares = calculateEqualSplitAllocations(totalAmt, checkedPIds);
        allocationRows?.querySelectorAll<HTMLElement>('[data-p-share]').forEach(el => {
          const pId = el.getAttribute('data-p-share');
          if (pId && shares[pId] !== undefined) {
            el.textContent = `${currSym}${shares[pId].toFixed(2)}`;
            el.classList.remove('opacity-40');
          } else {
            el.textContent = `${currSym}0.00`;
            el.classList.add('opacity-40');
          }
        });

        if (statusLabel && statusVal) {
          statusLabel.textContent = `Equal split (${checkedPIds.length} members)`;
          const perPerson = checkedPIds.length > 0 ? (totalAmt / checkedPIds.length) : 0;
          statusVal.textContent = `~${currSym}${perPerson.toFixed(2)} / person`;
          statusVal.className = 'font-bold text-black dark:text-white';
        }
      } else if (currentSplitMethod === 'percentage') {
        const valRes = validateExpenseAllocations(totalAmt, 'percentage', checkedPIds, allocs);
        let totalPct = 0;
        for (const a of allocs) {
          if (checkedPIds.includes(a.participantId)) totalPct += a.value;
        }

        if (statusLabel && statusVal) {
          statusLabel.textContent = `Total Percentage: ${totalPct.toFixed(1)}% / 100%`;
          if (valRes.isValid) {
            statusVal.textContent = '✓ 100% Exact';
            statusVal.className = 'font-bold text-emerald-600 dark:text-emerald-400';
          } else {
            statusVal.textContent = valRes.remaining !== undefined
              ? (valRes.remaining > 0 ? `${valRes.remaining}% remaining` : `${Math.abs(valRes.remaining)}% over`)
              : 'Invalid';
            statusVal.className = 'font-bold text-amber-600 dark:text-amber-400';
          }
        }
      } else if (currentSplitMethod === 'exact') {
        const valRes = validateExpenseAllocations(totalAmt, 'exact', checkedPIds, allocs);
        let allocatedSum = 0;
        for (const a of allocs) {
          if (checkedPIds.includes(a.participantId)) allocatedSum += a.value;
        }

        if (statusLabel && statusVal) {
          statusLabel.textContent = `Allocated: ${currSym}${allocatedSum.toFixed(2)} of ${currSym}${totalAmt.toFixed(2)}`;
          if (valRes.isValid) {
            statusVal.textContent = '✓ Exact Match';
            statusVal.className = 'font-bold text-emerald-600 dark:text-emerald-400';
          } else {
            statusVal.textContent = valRes.remaining !== undefined
              ? (valRes.remaining > 0 ? `${currSym}${valRes.remaining.toFixed(2)} remaining` : `${currSym}${Math.abs(valRes.remaining).toFixed(2)} over`)
              : 'Invalid';
            statusVal.className = 'font-bold text-amber-600 dark:text-amber-400';
          }
        }
      }
    }

    function setSplitMethod(method: SplitMethod) {
      currentSplitMethod = method;

      methodTabs.forEach(tab => {
        const m = tab.getAttribute('data-method');
        if (m === method) {
          tab.className = 'ms-method-tab py-1.5 text-xs font-mono font-bold rounded-lg transition-all cursor-pointer bg-white dark:bg-neutral-900 text-black dark:text-white shadow-2xs';
        } else {
          tab.className = 'ms-method-tab py-1.5 text-xs font-mono font-bold rounded-lg transition-all cursor-pointer text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white';
        }
      });

      const isInputMode = method === 'percentage' || method === 'exact';
      allocationRows?.querySelectorAll('.ms-share-preview').forEach(el => {
        if (isInputMode) el.classList.add('hidden');
        else el.classList.remove('hidden');
      });

      allocationRows?.querySelectorAll('.ms-alloc-input-wrap').forEach(el => {
        if (isInputMode) el.classList.remove('hidden');
        else el.classList.add('hidden');
      });

      const currSym = activeGroup ? getCurrencySymbol(activeGroup.currency) : '$';
      allocationRows?.querySelectorAll('.ms-alloc-unit').forEach(el => {
        el.textContent = method === 'percentage' ? '%' : currSym;
      });

      updateAllocationPreview();
    }

    // 6. Render Recorded Expenses List (Collapsible Expense History v1.3)
    function renderExpensesList() {
      if (!activeGroup || !expensesList) return;

      if (expenseBadge) {
        expenseBadge.textContent = String(activeGroup.expenses.length);
      }

      if (activeGroup.expenses.length === 0) {
        expensesList.innerHTML = '<div class="text-xs text-neutral-500 font-mono py-4 text-center">No expenses recorded yet. Fill out the form above to add your first bill.</div>';
        if (expensesToggleWrapper) expensesToggleWrapper.classList.add('hidden');
        return;
      }

      const currSym = getCurrencySymbol(activeGroup.currency);
      const participantMap = new Map(activeGroup.participants.map(p => [p.id, p.name]));

      // Sort newest first internally
      const sortedExpenses = [...activeGroup.expenses].sort((a, b) => b.createdAt - a.createdAt);
      const totalCount = sortedExpenses.length;
      const EXPENSES_COLLAPSE_THRESHOLD = 4;
      const shouldShowToggle = totalCount > EXPENSES_COLLAPSE_THRESHOLD;

      // Slice if collapsed (default shows first 4 expenses)
      const displayedExpenses = (shouldShowToggle && !isExpensesExpanded) 
        ? sortedExpenses.slice(0, EXPENSES_COLLAPSE_THRESHOLD) 
        : sortedExpenses;

      expensesList.innerHTML = displayedExpenses.map(exp => {
        const payerName = participantMap.get(exp.paidBy) || 'Unknown';
        const dateStr = new Date(exp.createdAt).toLocaleDateString(undefined, {
          month: 'short',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });

        return `
          <div class="p-4 rounded-xl bg-neutral-50 dark:bg-neutral-800/40 border border-neutral-200 dark:border-neutral-700/60 space-y-2.5 transition-all hover:border-neutral-300 dark:hover:border-neutral-600">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <div class="font-bold text-sm text-neutral-900 dark:text-white truncate">${exp.description}</div>
                <div class="text-[11px] font-mono text-neutral-500 flex items-center gap-2 mt-0.5">
                  <span>Paid by <strong class="text-black dark:text-white font-bold">${payerName}</strong></span>
                  <span>•</span>
                  <span>${dateStr}</span>
                </div>
              </div>
              <div class="text-right shrink-0">
                <div class="text-base sm:text-lg font-black text-black dark:text-white tabular-nums">
                  ${currSym}${exp.amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                </div>
                <span class="inline-block text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-neutral-200 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-300 font-bold">
                  ${exp.splitMethod} split (${exp.participantIds.length})
                </span>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="pt-2 border-t border-neutral-200/60 dark:border-neutral-700/40 flex items-center justify-between text-xs font-mono">
              <span class="text-neutral-500 text-[11px]">${exp.participantIds.length} participant${exp.participantIds.length === 1 ? '' : 's'}</span>
              <div class="flex items-center gap-2">
                <button type="button" data-edit-expense="${exp.id}" class="text-blue-600 dark:text-blue-400 hover:underline font-bold cursor-pointer">
                  Edit
                </button>
                <span class="text-neutral-300 dark:text-neutral-600">•</span>
                <button type="button" data-del-expense="${exp.id}" class="text-red-500 hover:underline font-bold cursor-pointer">
                  Delete
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');

      // Toggle UI visibility & label
      if (expensesToggleWrapper) {
        if (shouldShowToggle) {
          expensesToggleWrapper.classList.remove('hidden');
          if (expensesToggleText) {
            const hiddenCount = totalCount - EXPENSES_COLLAPSE_THRESHOLD;
            expensesToggleText.textContent = isExpensesExpanded
              ? '↑ Show Less'
              : `↓ Show ${hiddenCount} More Expense${hiddenCount === 1 ? '' : 's'}`;
          }
        } else {
          expensesToggleWrapper.classList.add('hidden');
        }
      }

      // Bind edit handlers
      expensesList.querySelectorAll('[data-edit-expense]').forEach(btn => {
        btn.addEventListener('click', () => {
          const eId = btn.getAttribute('data-edit-expense');
          if (eId) startEditingExpense(eId);
        });
      });

      // Bind delete handlers (Task 2: Application Modal)
      expensesList.querySelectorAll('[data-del-expense]').forEach(btn => {
        btn.addEventListener('click', () => {
          const eId = btn.getAttribute('data-del-expense');
          if (!eId || !activeGroup) return;

          const targetExp = activeGroup.expenses.find(e => e.id === eId);
          if (!targetExp) return;

          pendingDeleteExpenseId = eId;
          if (delExpTargetDesc) {
            delExpTargetDesc.textContent = `${targetExp.description} - ${currSym}${targetExp.amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
          }
          openModal(deleteExpenseModal);
        });
      });
    }

    // 7. Render Balances Ledger
    function renderBalances() {
      if (!activeGroup || !balancesList) return;

      const totalSpend = calculateTotalSpending(activeGroup.expenses);
      const balances = calculateGroupBalances(activeGroup);
      const currSym = getCurrencySymbol(activeGroup.currency);

      if (totalSpendDisplay) {
        totalSpendDisplay.textContent = `${currSym}${totalSpend.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      }
      if (expenseCountDisplay) {
        expenseCountDisplay.textContent = `${activeGroup.expenses.length} bill${activeGroup.expenses.length === 1 ? '' : 's'}`;
      }

      if (balances.length === 0) {
        balancesList.innerHTML = '<div class="text-xs text-neutral-500 font-mono py-2">Add participants to see balances.</div>';
        return;
      }

      balancesList.innerHTML = balances.map(b => {
        const isReceiver = b.netBalance > 0;
        const isOwer = b.netBalance < 0;
        const isSettled = b.netBalance === 0;

        return `
          <div class="flex items-center justify-between p-2.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-xs font-mono">
            <div>
              <span class="font-bold text-neutral-900 dark:text-white block">${b.name}</span>
              <span class="text-[10px] text-neutral-500">Paid ${currSym}${b.totalPaid.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} • Owed ${currSym}${b.totalOwed.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
            </div>
            <div class="text-right">
              ${isReceiver ? `
                <span class="font-bold text-emerald-600 dark:text-emerald-400 block tabular-nums">+${currSym}${b.netBalance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
                <span class="text-[10px] text-emerald-600/80 uppercase font-bold">Gets back</span>
              ` : isOwer ? `
                <span class="font-bold text-rose-600 dark:text-rose-400 block tabular-nums">-${currSym}${Math.abs(b.netBalance).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
                <span class="text-[10px] text-rose-600/80 uppercase font-bold">Owes</span>
              ` : `
                <span class="font-bold text-neutral-400 block tabular-nums">${currSym}0.00</span>
                <span class="text-[10px] text-neutral-400 uppercase font-bold">Settled</span>
              `}
            </div>
          </div>
        `;
      }).join('');
    }

    // 8. Expense Form Actions (Add / Edit)
    function startEditingExpense(expenseId: string) {
      if (!activeGroup) return;
      const exp = activeGroup.expenses.find(e => e.id === expenseId);
      if (!exp) return;

      editingExpenseId = expenseId;

      if (expenseFormTitle) expenseFormTitle.textContent = `Editing: ${exp.description}`;
      if (cancelEditBtn) cancelEditBtn.classList.remove('hidden');

      if (expDescInput) expDescInput.value = exp.description;
      if (expAmountInput) expAmountInput.value = String(exp.amount);
      if (expPayerSelect) expPayerSelect.value = exp.paidBy;

      setSplitMethod(exp.splitMethod);

      // Check involved participants
      allocationRows?.querySelectorAll<HTMLInputElement>('[data-p-check]').forEach(chk => {
        const id = chk.getAttribute('data-p-check');
        chk.checked = id ? exp.participantIds.includes(id) : false;
      });

      // Fill existing allocation values if percentage or exact
      if (exp.splitMethod === 'percentage' || exp.splitMethod === 'exact') {
        const allocMap = new Map(exp.allocations.map(a => [a.participantId, a.value]));
        allocationRows?.querySelectorAll<HTMLInputElement>('[data-p-alloc]').forEach(inp => {
          const id = inp.getAttribute('data-p-alloc');
          if (id && allocMap.has(id)) {
            inp.value = String(allocMap.get(id));
          }
        });
      }

      updateAllocationPreview();
      expDescInput?.focus();
    }

    function cancelEditMode() {
      editingExpenseId = null;
      if (expenseFormTitle) expenseFormTitle.textContent = 'Add New Expense';
      if (cancelEditBtn) cancelEditBtn.classList.add('hidden');
      expenseForm?.reset();
      setSplitMethod('equal');
      renderAllocationRows();
    }

    // 9. Event Listeners Wiring

    // Create Group Form (Welcome view)
    if (createGroupForm) {
      createGroupForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = newGroupNameInput?.value.trim();
        const curr = newGroupCurrencySelect?.value || 'INR';
        if (!name) return;

        isExpensesExpanded = false;
        createGroup(name, curr);
        createGroupForm.reset();
        refresh();
      });
    }

    // Open My Groups Modal (Task 1)
    if (openMyGroupsBtn) {
      openMyGroupsBtn.addEventListener('click', () => {
        renderMyGroupsModal();
        openModal(myGroupsModal);
      });
    }

    if (closeMyGroupsBtn) {
      closeMyGroupsBtn.addEventListener('click', () => closeModal(myGroupsModal));
    }

    if (myGroupsCloseBottomBtn) {
      myGroupsCloseBottomBtn.addEventListener('click', () => closeModal(myGroupsModal));
    }

    if (myGroupsCreateBtn) {
      myGroupsCreateBtn.addEventListener('click', () => {
        closeModal(myGroupsModal);
        openModal(newGroupModal);
      });
    }

    // Create New Group Modal
    if (newGroupBtn) {
      newGroupBtn.addEventListener('click', () => openModal(newGroupModal));
    }

    if (closeGroupModalBtn) {
      closeGroupModalBtn.addEventListener('click', () => closeModal(newGroupModal));
    }

    if (modalCreateGroupForm) {
      modalCreateGroupForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = modalGroupNameInput?.value.trim();
        const curr = modalGroupCurrencySelect?.value || 'INR';
        if (!name) return;

        isExpensesExpanded = false;
        createGroup(name, curr);
        modalCreateGroupForm.reset();
        closeModal(newGroupModal);
        refresh();
      });
    }

    // Delete Group Modal (Task 2)
    if (deleteGroupBtn) {
      deleteGroupBtn.addEventListener('click', () => {
        if (!activeGroup) return;
        if (delGroupTargetName) delGroupTargetName.textContent = activeGroup.name;
        openModal(deleteGroupModal);
      });
    }

    if (cancelDelGroupBtn) {
      cancelDelGroupBtn.addEventListener('click', () => closeModal(deleteGroupModal));
    }

    if (confirmDelGroupBtn) {
      confirmDelGroupBtn.addEventListener('click', () => {
        if (!activeGroup) return;
        deleteGroup(activeGroup.id);
        closeModal(deleteGroupModal);
        refresh();
      });
    }

    // Delete Expense Modal (Task 2)
    if (cancelDelExpBtn) {
      cancelDelExpBtn.addEventListener('click', () => {
        pendingDeleteExpenseId = null;
        closeModal(deleteExpenseModal);
      });
    }

    if (confirmDelExpBtn) {
      confirmDelExpBtn.addEventListener('click', () => {
        if (pendingDeleteExpenseId && activeGroup) {
          deleteExpense(activeGroup.id, pendingDeleteExpenseId);
          if (editingExpenseId === pendingDeleteExpenseId) {
            cancelEditMode();
          }
          pendingDeleteExpenseId = null;
          closeModal(deleteExpenseModal);
          refresh();
        }
      });
    }

    // Backdrop clicks for all modals
    [myGroupsModal, deleteGroupModal, deleteExpenseModal, newGroupModal, importModal].forEach(modal => {
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            closeModal(modal);
          }
        });
      }
    });

    // Global ESC key listener to close active modal
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeModal(myGroupsModal);
        closeModal(deleteGroupModal);
        closeModal(deleteExpenseModal);
        closeModal(newGroupModal);
        closeModal(importModal);
      }
    });

    // Add Participant
    if (addParticipantForm) {
      addParticipantForm.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!activeGroup || !addParticipantInput) return;
        const name = addParticipantInput.value.trim();
        if (!name) return;

        const res = addParticipant(activeGroup.id, name);
        if (!res.success) {
          showParticipantAlert(res.error || 'Failed to add member.');
          return;
        }

        addParticipantInput.value = '';
        refresh();
      });
    }

    // Method Tabs
    methodTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const method = tab.getAttribute('data-method') as SplitMethod;
        if (method) setSplitMethod(method);
      });
    });

    if (selectAllBtn) {
      selectAllBtn.addEventListener('click', () => {
        allocationRows?.querySelectorAll<HTMLInputElement>('[data-p-check]').forEach(c => c.checked = true);
        updateAllocationPreview();
      });
    }

    if (deselectAllBtn) {
      deselectAllBtn.addEventListener('click', () => {
        allocationRows?.querySelectorAll<HTMLInputElement>('[data-p-check]').forEach(c => c.checked = false);
        updateAllocationPreview();
      });
    }

    if (expAmountInput) {
      expAmountInput.addEventListener('input', updateAllocationPreview);
    }

    if (cancelEditBtn) {
      cancelEditBtn.addEventListener('click', cancelEditMode);
    }

    // Expense Form Submit
    if (expenseForm) {
      expenseForm.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!activeGroup) return;

        const desc = expDescInput?.value.trim() || '';
        const amt = parseFloat(expAmountInput?.value || '0') || 0;
        const payerId = expPayerSelect?.value || '';

        if (!desc) {
          alert('Please enter an expense description.');
          return;
        }

        if (amt <= 0) {
          alert('Total amount must be greater than 0.');
          return;
        }

        if (!payerId) {
          alert('Please select who paid for this expense.');
          return;
        }

        const checkedPIds: string[] = [];
        allocationRows?.querySelectorAll<HTMLInputElement>('[data-p-check]:checked').forEach(c => {
          const id = c.getAttribute('data-p-check');
          if (id) checkedPIds.push(id);
        });

        if (checkedPIds.length === 0) {
          alert('Please select at least one participant in the split.');
          return;
        }

        const allocs: Allocation[] = [];
        allocationRows?.querySelectorAll<HTMLInputElement>('[data-p-alloc]').forEach(inp => {
          const pId = inp.getAttribute('data-p-alloc');
          const val = parseFloat(inp.value || '0') || 0;
          if (pId && checkedPIds.includes(pId)) allocs.push({ participantId: pId, value: val });
        });

        // Validation
        const valRes = validateExpenseAllocations(amt, currentSplitMethod, checkedPIds, allocs);
        if (!valRes.isValid) {
          alert(valRes.error || 'Invalid expense allocations.');
          return;
        }

        if (editingExpenseId) {
          updateExpense(activeGroup.id, editingExpenseId, {
            description: desc,
            amount: amt,
            paidBy: payerId,
            participantIds: checkedPIds,
            splitMethod: currentSplitMethod,
            allocations: allocs
          });
          cancelEditMode();
        } else {
          addExpense(activeGroup.id, {
            description: desc,
            amount: amt,
            paidBy: payerId,
            participantIds: checkedPIds,
            splitMethod: currentSplitMethod,
            allocations: allocs
          });
          expenseForm.reset();
          renderAllocationRows();
        }

        refresh();
      });
    }

    // 10. Sharing & Copy Actions
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        if (!activeGroup) return;
        if (shareBtnText) shareBtnText.textContent = 'Sharing...';
        const res = await shareGroupLink(activeGroup);
        if (shareBtnText) {
          shareBtnText.textContent = res.success ? (res.method === 'clipboard' ? 'Link Copied!' : 'Shared!') : 'Share Group';
          setTimeout(() => {
            shareBtnText.textContent = 'Share Group';
          }, 3000);
        }
      });
    }

    if (copySummaryBtn) {
      copySummaryBtn.addEventListener('click', async () => {
        if (!activeGroup) return;
        const summary = generateSettlementSummary(activeGroup);
        const copied = await copyToClipboard(summary.formattedSummaryText);
        if (copySummaryText) {
          copySummaryText.textContent = copied ? 'Copied to Clipboard!' : 'Failed to Copy';
          setTimeout(() => {
            copySummaryText.textContent = 'Copy WhatsApp Summary';
          }, 3000);
        }
      });
    }

    // 11. URL Import Dialog Handling (?data=...)
    function checkIncomingShareLink() {
      if (typeof window === 'undefined') return;
      const params = new URLSearchParams(window.location.search);
      const data = params.get('data');
      if (!data) return;

      const res = deserializeGroupFromShare(data);
      if (!res.success || !res.payload) {
        console.warn('[money-split] Corrupt share link parameter dropped:', res.error);
        window.history.replaceState({}, '', window.location.pathname);
        return;
      }

      pendingImportPayload = res.payload;
      const incoming = res.payload.group;
      const existing = loadAllGroups();
      const conflict = detectGroupConflict(existing, incoming);

      if (importNameEl) importNameEl.textContent = incoming.name;
      if (importCurrencyEl) importCurrencyEl.textContent = incoming.currency;
      if (importMembersEl) importMembersEl.textContent = `${incoming.participants.length} members`;
      if (importExpensesEl) importExpensesEl.textContent = `${incoming.expenses.length} expenses`;

      if (conflict.hasConflict) {
        importConflictMsg?.classList.remove('hidden');
        importStandardActions?.classList.add('hidden');
        importConflictActions?.classList.remove('hidden');
      } else {
        importConflictMsg?.classList.add('hidden');
        importStandardActions?.classList.remove('hidden');
        importConflictActions?.classList.add('hidden');
      }

      openModal(importModal);
    }

    function closeImportModal() {
      closeModal(importModal);
      pendingImportPayload = null;
      if (typeof window !== 'undefined') {
        window.history.replaceState({}, '', window.location.pathname);
      }
    }

    if (importCancelBtn) importCancelBtn.addEventListener('click', closeImportModal);
    if (importConflictCancelBtn) importConflictCancelBtn.addEventListener('click', closeImportModal);

    if (importConfirmBtn) {
      importConfirmBtn.addEventListener('click', () => {
        if (!pendingImportPayload) return;
        isExpensesExpanded = false;
        importGroupIntoStorage(pendingImportPayload.group, 'new');
        closeImportModal();
        refresh();
      });
    }

    if (importReplaceBtn) {
      importReplaceBtn.addEventListener('click', () => {
        if (!pendingImportPayload) return;
        isExpensesExpanded = false;
        importGroupIntoStorage(pendingImportPayload.group, 'replace');
        closeImportModal();
        refresh();
      });
    }

    if (importCopyBtn) {
      importCopyBtn.addEventListener('click', () => {
        if (!pendingImportPayload) return;
        isExpensesExpanded = false;
        importGroupIntoStorage(pendingImportPayload.group, 'duplicate');
        closeImportModal();
        refresh();
      });
    }

    // Collapsible Expense History Toggle (Money Split v1.3)
    if (expensesToggleBtn) {
      expensesToggleBtn.addEventListener('click', () => {
        isExpensesExpanded = !isExpensesExpanded;
        renderExpensesList();
        if (!isExpensesExpanded && expenseHistorySection) {
          const rect = expenseHistorySection.getBoundingClientRect();
          if (rect.top < 0) {
            expenseHistorySection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        }
      });
    }

    // Initialize App
    refresh();
    checkIncomingShareLink();
  })();
</script>
