---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact Us — All Calc Kit" 
  description="Get in touch with the All Calc Kit team. Send feature suggestions, tool requests, bug reports, or general inquiries."
  canonicalUrl="https://allcalckit.com/contact"
>
  <!-- Hero Header -->
  <section class="border-b border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-950/50 py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-mono text-neutral-500 mb-6">
        <a href="/" class="hover:text-black dark:hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-black dark:text-white font-semibold">Contact Us</span>
      </nav>

      <div class="space-y-4">
        <span class="px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 font-mono text-xs font-bold uppercase tracking-wider inline-block">
          Get In Touch
        </span>
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-black dark:text-white">
          Contact Us.
        </h1>
        <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-2xl font-medium">
          Have a question, feedback, or tool request? We'd love to hear from you.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Section -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 sm:gap-12">
      
      <!-- Contact Form Column -->
      <div class="md:col-span-7 space-y-6">
        <div class="bg-white dark:bg-neutral-900/60 p-6 sm:p-8 rounded-3xl border border-neutral-200 dark:border-neutral-800 shadow-xl space-y-5">
          <h2 class="text-xl font-bold text-black dark:text-white tracking-tight">Send Us a Message</h2>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Fill out the form below and our team will get back to you within 24 business hours.
          </p>

          <!-- Error Alert Banner -->
          <div 
            id="contact-error" 
            role="alert" 
            aria-live="assertive" 
            class="hidden p-4 bg-red-500/10 border border-red-500/30 rounded-2xl text-red-700 dark:text-red-300 text-xs font-mono leading-relaxed space-y-1"
          >
            <div class="font-bold flex items-center gap-1.5">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span id="contact-error-title">Submission Failed</span>
            </div>
            <p id="contact-error-text">
              Something went wrong while sending your message. Please try again or email <a href="mailto:support@allcalckit.com" class="underline font-bold">support@allcalckit.com</a> directly.
            </p>
          </div>

          <!-- Contact Form -->
          <form id="contact-form" class="space-y-4 pt-2" novalidate>
            <!-- Honeypot anti-spam field (hidden from real users) -->
            <div style="display:none !important; position:absolute !important; left:-9999px !important;" aria-hidden="true">
              <label for="contact-hp">Leave this field blank</label>
              <input type="text" name="honeypot" id="contact-hp" tabindex="-1" autocomplete="off" />
            </div>

            <div>
              <label for="contact-name" class="block text-xs font-mono text-neutral-700 dark:text-neutral-300 uppercase tracking-wider mb-1.5 font-semibold">Your Name *</label>
              <input 
                id="contact-name" 
                name="name"
                type="text" 
                required 
                minlength="2"
                maxlength="100"
                autocomplete="name"
                placeholder="e.g. Sarah Jenkins" 
                class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white text-sm focus:ring-2 focus:ring-amber-500 outline-none transition-all"
              />
              <p id="contact-name-error" class="hidden text-xs text-red-500 font-mono mt-1"></p>
            </div>

            <div>
              <label for="contact-email" class="block text-xs font-mono text-neutral-700 dark:text-neutral-300 uppercase tracking-wider mb-1.5 font-semibold">Email Address *</label>
              <input 
                id="contact-email" 
                name="email"
                type="email" 
                required 
                maxlength="254"
                autocomplete="email"
                placeholder="e.g. sarah@example.com" 
                class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white text-sm focus:ring-2 focus:ring-amber-500 outline-none transition-all"
              />
              <p id="contact-email-error" class="hidden text-xs text-red-500 font-mono mt-1"></p>
            </div>

            <div>
              <label for="contact-subject" class="block text-xs font-mono text-neutral-700 dark:text-neutral-300 uppercase tracking-wider mb-1.5 font-semibold">Inquiry Type *</label>
              <select 
                id="contact-subject"
                name="subject"
                required
                class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white text-sm focus:ring-2 focus:ring-amber-500 outline-none transition-all font-sans"
              >
                <option value="request">New Tool / Calculator Request</option>
                <option value="feedback">General Feedback & Suggestions</option>
                <option value="bug">Report a Bug or Calculation Issue</option>
                <option value="partnership">Business / Media Inquiry</option>
              </select>
              <p id="contact-subject-error" class="hidden text-xs text-red-500 font-mono mt-1"></p>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-mono text-neutral-700 dark:text-neutral-300 uppercase tracking-wider mb-1.5 font-semibold">Message *</label>
              <textarea 
                id="contact-message" 
                name="message"
                rows="4" 
                required 
                minlength="10"
                maxlength="5000"
                placeholder="Tell us what tool you'd like us to add or describe your feedback in detail..." 
                class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-neutral-800/80 border border-neutral-300 dark:border-neutral-700 text-black dark:text-white text-sm focus:ring-2 focus:ring-amber-500 outline-none transition-all leading-relaxed"
              ></textarea>
              <p id="contact-message-error" class="hidden text-xs text-red-500 font-mono mt-1"></p>
            </div>

            <button 
              id="contact-submit-btn"
              type="submit" 
              class="w-full py-3.5 px-6 rounded-xl bg-black dark:bg-white text-white dark:text-black font-bold text-sm hover:opacity-90 active:scale-98 transition-all shadow-md flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed disabled:pointer-events-none"
            >
              <span id="contact-btn-text">Send Message</span>
              <svg id="contact-btn-arrow" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              <svg id="contact-btn-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            </button>
          </form>

          <!-- Success Display Box -->
          <div id="contact-success" class="hidden space-y-4 pt-2">
            <div class="p-6 bg-emerald-500/10 border border-emerald-500/30 rounded-2xl text-emerald-800 dark:text-emerald-200 text-sm leading-relaxed space-y-4">
              <div class="flex items-center gap-2 text-base font-bold text-emerald-700 dark:text-emerald-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                <span>Message sent successfully!</span>
              </div>
              
              <div class="space-y-1.5">
                <p class="text-xs text-neutral-600 dark:text-neutral-400">Your support reference is:</p>
                <div class="flex items-center justify-between p-3 bg-white/80 dark:bg-neutral-800/90 border border-emerald-500/30 rounded-xl shadow-xs">
                  <span id="contact-ref-value" class="font-mono text-sm sm:text-base font-bold text-black dark:text-white tracking-wide select-all">ACK-20260811-XXXXXXXX</span>
                  <button 
                    id="contact-copy-ref-btn" 
                    type="button" 
                    class="px-2.5 py-1 text-xs font-mono font-medium rounded-lg bg-neutral-100 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-neutral-600 transition-colors"
                  >
                    Copy
                  </button>
                </div>
              </div>

              <p class="text-xs text-neutral-600 dark:text-neutral-300">
                We'll review your message and get back to you if a response is required.
              </p>
            </div>

            <button 
              id="contact-reset-btn" 
              type="button" 
              class="w-full py-3 px-4 rounded-xl border border-neutral-300 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 font-semibold text-xs hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors"
            >
              Send Another Message
            </button>
          </div>
        </div>
      </div>

      <!-- Information Side Column -->
      <div class="md:col-span-5 space-y-6">
        <div class="bg-neutral-50 dark:bg-neutral-900/40 p-6 rounded-3xl border border-neutral-200 dark:border-neutral-800 space-y-4">
          <h3 class="font-bold text-black dark:text-white text-base">Direct Email Contact</h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Prefer direct email? Reach out to our technical team directly:
          </p>
          <a id="direct-support-email-link" href="mailto:support@allcalckit.com" class="inline-block font-mono text-xs text-blue-600 dark:text-blue-400 font-bold underline hover:opacity-80">
            support@allcalckit.com
          </a>
        </div>

        <div class="bg-neutral-50 dark:bg-neutral-900/40 p-6 rounded-3xl border border-neutral-200 dark:border-neutral-800 space-y-4">
          <h3 class="font-bold text-black dark:text-white text-base">Frequently Asked Questions</h3>
          <div class="space-y-3 text-xs leading-relaxed">
            <div>
              <p class="font-bold text-black dark:text-white">Are all calculators free?</p>
              <p class="text-neutral-500 dark:text-neutral-400">Yes, 100% free forever without ads or accounts.</p>
            </div>
            <div>
              <p class="font-bold text-black dark:text-white">How fast do you build new tools?</p>
              <p class="text-neutral-500 dark:text-neutral-400">We launch user-requested calculators every month.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('contact-form');
      const errorBox = document.getElementById('contact-error');
      const errorText = document.getElementById('contact-error-text');
      const successBox = document.getElementById('contact-success');
      const refValueEl = document.getElementById('contact-ref-value');
      const copyRefBtn = document.getElementById('contact-copy-ref-btn');
      const resetBtn = document.getElementById('contact-reset-btn');

      const submitBtn = document.getElementById('contact-submit-btn');
      const btnText = document.getElementById('contact-btn-text');
      const btnArrow = document.getElementById('contact-btn-arrow');
      const btnSpinner = document.getElementById('contact-btn-spinner');

      const nameInput = document.getElementById('contact-name');
      const emailInput = document.getElementById('contact-email');
      const subjectInput = document.getElementById('contact-subject');
      const messageInput = document.getElementById('contact-message');
      const honeypotInput = document.getElementById('contact-hp');

      const nameError = document.getElementById('contact-name-error');
      const emailError = document.getElementById('contact-email-error');
      const subjectError = document.getElementById('contact-subject-error');
      const messageError = document.getElementById('contact-message-error');

      function clearFieldErrors() {
        [nameError, emailError, subjectError, messageError].forEach(el => {
          if (el) {
            el.textContent = '';
            el.classList.add('hidden');
          }
        });
        if (errorBox) errorBox.classList.add('hidden');
      }

      function setSubmittingState(isSubmitting) {
        if (!submitBtn) return;
        submitBtn.disabled = isSubmitting;
        if (isSubmitting) {
          if (btnText) btnText.textContent = 'Sending...';
          if (btnArrow) btnArrow.classList.add('hidden');
          if (btnSpinner) btnSpinner.classList.remove('hidden');
        } else {
          if (btnText) btnText.textContent = 'Send Message';
          if (btnArrow) btnArrow.classList.remove('hidden');
          if (btnSpinner) btnSpinner.classList.add('hidden');
        }
      }

      function validateClientSide() {
        clearFieldErrors();
        let isValid = true;

        const name = nameInput ? nameInput.value.trim() : '';
        const email = emailInput ? emailInput.value.trim() : '';
        const subject = subjectInput ? subjectInput.value.trim() : '';
        const message = messageInput ? messageInput.value.trim() : '';

        if (!name || name.length < 2) {
          if (nameError) {
            nameError.textContent = 'Please enter your name (at least 2 characters).';
            nameError.classList.remove('hidden');
          }
          isValid = false;
        }

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!email || !emailRegex.test(email)) {
          if (emailError) {
            emailError.textContent = 'Please enter a valid email address.';
            emailError.classList.remove('hidden');
          }
          isValid = false;
        }

        if (!subject) {
          if (subjectError) {
            subjectError.textContent = 'Please select an inquiry type.';
            subjectError.classList.remove('hidden');
          }
          isValid = false;
        }

        if (!message || message.length < 10) {
          if (messageError) {
            messageError.textContent = 'Please enter a message of at least 10 characters.';
            messageError.classList.remove('hidden');
          }
          isValid = false;
        }

        return isValid;
      }

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();

          if (!validateClientSide()) {
            return;
          }

          setSubmittingState(true);
          clearFieldErrors();

          const payload = {
            name: nameInput ? nameInput.value.trim() : '',
            email: emailInput ? emailInput.value.trim() : '',
            subject: subjectInput ? subjectInput.value : '',
            message: messageInput ? messageInput.value.trim() : '',
            honeypot: honeypotInput ? honeypotInput.value : '',
          };

          try {
            const res = await fetch('/api/contact', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(payload),
            });

            const data = await res.json().catch(() => ({}));

            if (!res.ok || !data.success) {
              const msg = data.error || 'Something went wrong while sending your message. Please try again or email support@allcalckit.com directly.';
              if (errorText) {
                errorText.innerHTML = msg.includes('support@allcalckit.com')
                  ? msg.replace('support@allcalckit.com', '<a href="mailto:support@allcalckit.com" class="underline font-bold">support@allcalckit.com</a>')
                  : msg;
              }
              if (errorBox) errorBox.classList.remove('hidden');
              
              if (data.errors) {
                if (data.errors.name && nameError) {
                  nameError.textContent = data.errors.name;
                  nameError.classList.remove('hidden');
                }
                if (data.errors.email && emailError) {
                  emailError.textContent = data.errors.email;
                  emailError.classList.remove('hidden');
                }
                if (data.errors.subject && subjectError) {
                  subjectError.textContent = data.errors.subject;
                  subjectError.classList.remove('hidden');
                }
                if (data.errors.message && messageError) {
                  messageError.textContent = data.errors.message;
                  messageError.classList.remove('hidden');
                }
              }
              setSubmittingState(false);
              return;
            }

            // Success!
            if (refValueEl && data.reference) {
              refValueEl.textContent = data.reference;
            }
            form.classList.add('hidden');
            if (successBox) successBox.classList.remove('hidden');
          } catch (err) {
            if (errorText) {
              errorText.innerHTML = 'Something went wrong while sending your message. Please try again or email <a href="mailto:support@allcalckit.com" class="underline font-bold">support@allcalckit.com</a> directly.';
            }
            if (errorBox) errorBox.classList.remove('hidden');
          } finally {
            setSubmittingState(false);
          }
        });
      }

      if (copyRefBtn && refValueEl) {
        copyRefBtn.addEventListener('click', async () => {
          const text = refValueEl.textContent || '';
          try {
            await navigator.clipboard.writeText(text);
            const originalText = copyRefBtn.textContent;
            copyRefBtn.textContent = 'Copied!';
            setTimeout(() => {
              copyRefBtn.textContent = originalText;
            }, 2000);
          } catch (err) {
            // Fallback selection if clipboard API is restricted
            const range = document.createRange();
            range.selectNode(refValueEl);
            window.getSelection()?.removeAllRanges();
            window.getSelection()?.addRange(range);
          }
        });
      }

      if (resetBtn && form && successBox) {
        resetBtn.addEventListener('click', () => {
          form.reset();
          clearFieldErrors();
          successBox.classList.add('hidden');
          form.classList.remove('hidden');
        });
      }
    });
  </script>
</Layout>
