---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="500 - Internal Server Error | All Calc Kit" 
  description="An internal calculation server error occurred. Try refreshing the page or returning to the All Calc Kit homepage."
  canonicalUrl="https://allcalckit.com/500"
>
  <section class="min-h-[70vh] flex items-center justify-center py-16 px-4">
    <div class="max-w-2xl mx-auto text-center space-y-8">
      
      <!-- 500 Glitch Badge -->
      <div class="relative inline-block">
        <span class="text-7xl sm:text-9xl font-black font-mono tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-rose-600 via-amber-600 to-purple-600 dark:from-rose-400 dark:via-amber-400 dark:to-purple-400 select-none">
          500
        </span>
        <div class="absolute -top-3 -right-3 px-3 py-1 rounded-full bg-rose-600 text-white font-mono text-xs font-bold shadow-md">
          Internal Error
        </div>
      </div>

      <!-- Main Headline & Explanation -->
      <div class="space-y-3 max-w-lg mx-auto">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-black dark:text-white">
          Something went wrong on our end.
        </h1>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-medium">
          An unhandled error occurred while processing your request. Please try refreshing the page or navigating back to our home directory.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto">
        <button 
          onclick="window.location.reload()" 
          class="w-full sm:w-auto px-6 py-3 rounded-full bg-black hover:bg-neutral-800 text-white dark:bg-white dark:text-black dark:hover:bg-neutral-100 font-bold text-xs active:scale-98 transition-all shadow-md flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          <span>Refresh Page</span>
        </button>

        <a 
          href="/" 
          class="w-full sm:w-auto px-6 py-3 rounded-full bg-neutral-100 dark:bg-neutral-900 text-black dark:text-neutral-200 border border-neutral-300 dark:border-neutral-800 font-semibold text-xs hover:bg-neutral-200 dark:hover:bg-neutral-800 active:scale-98 transition-all flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          <span>Return Home</span>
        </a>
      </div>

      <!-- Report Issue Link -->
      <div class="pt-6 border-t border-neutral-200 dark:border-neutral-800 text-xs text-neutral-500">
        If this error keeps happening, please let us know at <a href="/contact" class="text-black dark:text-white underline font-semibold">our contact page</a>.
      </div>

    </div>
  </section>
</Layout>
