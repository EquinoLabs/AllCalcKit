---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="404 - Page Not Found | All Calc Kit" 
  description="The requested page could not be found on All Calc Kit."
  canonicalUrl="https://allcalckit.com/404"
  isErrorPage={true}
>
  <section class="min-h-[70vh] flex flex-col items-center justify-center py-20 px-4">
    <div class="max-w-md mx-auto text-center space-y-6">
      
      <!-- Big Readable 404 Text -->
      <h1 class="text-7xl sm:text-9xl font-black font-mono tracking-tight text-black dark:text-white">
        404
      </h1>

      <!-- Message -->
      <div class="space-y-2">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-black dark:text-white">
          Page Not Found
        </h2>
        <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed font-medium">
          The page or calculator you are looking for doesn't exist or has been moved.
        </p>
      </div>

      <!-- Single Clear Homepage Navigation Link -->
      <div class="pt-4">
        <a 
          href="/" 
          class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-black hover:bg-neutral-800 text-white dark:bg-white dark:text-black dark:hover:bg-neutral-100 font-bold text-sm active:scale-98 transition-all shadow-md gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          <span>Return to Homepage</span>
        </a>
      </div>

    </div>
  </section>
</Layout>
