# AllCalcKit Contact Form & Email Configuration

# Resend API Key for live transactional email delivery
# Obtain from https://resend.com/api-keys
# If left unset, email delivery runs in simulated mode (logs to console, safe for dev & testing)
RESEND_API_KEY=

# Destination email where contact form submissions are delivered (Default: support@allcalckit.com)
CONTACT_EMAIL_TO=support@allcalckit.com

# Verified sender address configured in your transactional email provider
CONTACT_EMAIL_FROM="AllCalcKit Support <support@allcalckit.com>"
